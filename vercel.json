{
  "trailingSlash": true,
  "buildCommand": "sh vercel.sh",
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/empresas-brasil",
      "destination": "/agenda",
      "permanent": true
    },
    {
      "source": "/empresas-brasil/:match*",
      "destination": "/agenda/:match*",
      "permanent": true
    },
    {
      "source": "/en/empresas-brasil",
      "destination": "/en/agenda",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade-e-termos-de-uso",
      "destination": "/politica-de-privacidade",
      "permanent": true
    },
    {
      "source": "/en/politica-de-privacidade-e-termos-de-uso",
      "destination": "/en/privacy-policy",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/politica-de-privacidade",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/termos-de-uso",
      "permanent": true
    },
    {
      "source": "/terms-conditions",
      "destination": "/termos-de-uso",
      "permanent": true
    },
    {
      "source": "/termos",
      "destination": "/termos-de-uso",
      "permanent": true
    },
    {
      "source": "/privacidade",
      "destination": "/politica-de-privacidade",
      "permanent": true
    },
    {
      "source": "/en/terms-of-service",
      "destination": "/en/terms-conditions",
      "permanent": true
    },
    {
      "source": "/blog/page/:match*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/en/blog/page/:match*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/post-:match*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/en/blog/post-:match*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/en/blog/:slug+",
      "destination": "/blog/:slug+",
      "permanent": true
    },
    {
      "source": "/team/:match*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/team/:match*",
      "destination": "/en",
      "permanent": true
    }
  ]
}
