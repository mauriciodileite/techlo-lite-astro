---
/**
 * Componente: VideoPlayer1Min.astro
 * Responsabilidade: Player de vídeo otimizado para o pitch de 1 minuto ("One Belief").
 * Suporta vídeo HTML5 nativo (mp4/webm), embed de YouTube/Vimeo, ou poster estático com trigger.
 * Estilo: Dark (#111111), bordas em Prata (#C6C6C6/20), acento Petronas (#00A39E) e tipografia Sora/Instrument Sans.
 */

interface Props {
  videoUrl?: string;
  youtubeId?: string;
  posterImage?: string;
  badgeText?: string;
  title?: string;
  durationText?: string;
  aspectRatio?: "9/16" | "16/9";
}

const {
  videoUrl = "",
  youtubeId = "",
  posterImage = "/images/perfil.jpg",
  badgeText = "Vídeo Explicativo • 1 Minuto",
  title = "Entenda em 60 segundos como funciona",
  durationText = "01:00 min",
  aspectRatio = "16/9"
} = Astro.props;

const isVertical = aspectRatio === "9/16";
---

<div class={`relative w-full ${isVertical ? 'max-w-[340px] sm:max-w-[360px]' : 'max-w-3xl'} mx-auto my-4`}>
  <!-- Brilho pulsante sutil atrás do container do vídeo -->
  <div class="absolute -inset-1 bg-gradient-to-r from-[#00A39E]/20 via-[#00A39E]/5 to-[#00A39E]/20 rounded-3xl blur-md opacity-75 group-hover:opacity-100 animate-pulse transition duration-1000"></div>

  <!-- Container do Vídeo com estética Brand Book -->
  <div class="relative rounded-2xl overflow-hidden bg-[#161616] border border-white/15 shadow-2xl group transition-all duration-300 group-hover:border-[#00A39E]/40">
    
    <!-- Barra superior com status -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-[#1C1C1C] border-b border-white/5 text-xs text-[#C6C6C6] font-['Instrument_Sans',sans-serif]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#00A39E]"></span>
        <span class="font-semibold text-white">{badgeText}</span>
      </div>
      <div class="flex items-center gap-1.5 bg-[#111111] px-2 py-0.5 rounded border border-white/10 text-[11px] text-[#C6C6C6]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{durationText}</span>
      </div>
    </div>

    <!-- Área de Exibição / Player (com suporte a aspect-ratio vertical 9:16 ou horizontal 16:9) -->
    <div class={`relative ${isVertical ? 'aspect-[9/16]' : 'aspect-video'} w-full bg-black flex items-center justify-center overflow-hidden`}>
      {youtubeId && (
        <div
          class="lazy-video-container relative w-full h-full cursor-pointer group/player select-none"
          data-youtube-id={youtubeId}
          data-title={title}
          role="button"
          tabindex="0"
          aria-label={`Reproduzir ${title}`}
        >
          <!-- Thumbnail estática do YouTube (Zero scripts externos no carregamento inicial) -->
          <img
            src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`}
            alt={title}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover/player:scale-105 opacity-80 group-hover/player:opacity-100"
          />

          <!-- Overlay escuro com gradiente -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/40 group-hover/player:opacity-75 transition-opacity duration-300"></div>

          <!-- Botão Play Oficial Brand Book (Círculo Teal #00A39E neon) -->
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
            <div class="w-16 h-16 rounded-full bg-[#00A39E] text-black flex items-center justify-center shadow-[0_0_25px_rgba(0,163,158,0.5)] transition-all duration-300 group-hover/player:scale-110 group-hover/player:shadow-[0_0_35px_rgba(0,163,158,0.85)]">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 translate-x-0.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-black/80 border border-white/20 text-xs font-semibold text-white tracking-wide shadow-lg backdrop-blur-sm group-hover/player:border-[#00A39E] transition-colors font-['Instrument_Sans',sans-serif]">
              Assistir Resumo ({durationText.replace(" min", "")})
            </span>
          </div>
        </div>
      )}

      {!youtubeId && videoUrl && (
        <video
          controls
          poster={posterImage}
          preload="metadata"
          class="w-full h-full object-cover"
        >
          <source src={videoUrl} type="video/mp4" />
          Seu navegador não suporta a reprodução deste vídeo.
        </video>
      )}

      {!youtubeId && !videoUrl && (
        <div class="relative w-full h-full flex flex-col items-center justify-center p-6 text-center bg-gradient-to-b from-[#1A1A1A] to-[#111111]">
          <div class="w-16 h-16 rounded-full bg-[#00A39E]/20 border border-[#00A39E]/50 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#00A39E] ml-1" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
          <h4 class="text-white font-['Sora',sans-serif] font-semibold text-lg mb-1">{title}</h4>
          <p class="text-xs text-[#C6C6C6] font-['Instrument_Sans',sans-serif] max-w-sm">
            Apresentação estratégica concisa do ecossistema Maurício Leite.
          </p>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  function initLazyVideoPlayers() {
    document.querySelectorAll<HTMLElement>('.lazy-video-container').forEach((container) => {
      if (container.dataset.ready) return;
      container.dataset.ready = 'true';

      const playVideo = () => {
        const id = container.dataset.youtubeId;
        const title = container.dataset.title || 'Vídeo';
        if (!id) return;

        const iframe = document.createElement('iframe');
        iframe.className = 'w-full h-full';
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = title;
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', 'true');

        container.replaceWith(iframe);
      };

      container.addEventListener('click', playVideo);
      container.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          playVideo();
        }
      });
    });
  }

  // Executa na carga inicial e em transições de página (se houver ViewTransitions)
  initLazyVideoPlayers();
  document.addEventListener('astro:page-load', initLazyVideoPlayers);
</script>
