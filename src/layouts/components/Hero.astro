---
/**
 * Componente: Hero.astro
 * Responsabilidade: Primeira dobra de impacto do site de Maurício Leite.
 * Inclui: Headline oficial, foto do Maurício (public/images/foto.png), 2 CTAs ("Ver Soluções" e "Aprender de graça").
 * Estilo: Brand Book (Preto Pista #111111, Petronas #00A39E, Prata #C6C6C6, Fontes Sora e Instrument Sans).
 */

interface Props {
  headline?: string;
  subheadline?: string;
  ctaSolutionsText?: string;
  ctaFreeText?: string;
  tagText?: string;
}

const {
  headline = "Minha missão é facilitar a venda para seu cliente e aumentar o lucro da sua empresa.",
  subheadline = "Comprometimento. Velocidade. Clareza. Estratégias de marketing e automações inteligentes focadas em resultado financeiro previsível.",
  ctaSolutionsText = "Ver Soluções",
  ctaFreeText = "Aprender de graça",
  tagText = "Marketing & Automação com IA"
} = Astro.props;
---

<section class="relative bg-[#111111] text-white pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden border-b border-white/5">
  <!-- Efeito sutil de iluminação de fundo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-[#00A39E]/10 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-6xl relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Coluna da Copy e Ações -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
          <span class="text-xs uppercase tracking-widest text-[#C6C6C6] font-mono">
            {tagText}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] font-['Sora',sans-serif] text-white mb-6">
          {headline}
        </h1>

        <p class="text-base sm:text-lg text-[#C6C6C6] font-['Instrument_Sans',sans-serif] leading-relaxed max-w-xl mx-auto lg:mx-0 mb-8">
          {subheadline}
        </p>

        <!-- Botões de Ação (CTAs) -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="#solucoes"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-lg bg-[#00A39E] text-[#111111] font-bold font-['Sora',sans-serif] hover:bg-[#008f8b] transition-all duration-200 shadow-[0_0_20px_rgba(0,163,158,0.3)] hover:scale-[1.02]"
          >
            {ctaSolutionsText}
          </a>
          <a
            href="#conteudo-gratuito"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-lg bg-[#1A1A1A] text-[#C6C6C6] border border-[#C6C6C6]/30 font-semibold font-['Sora',sans-serif] hover:text-white hover:border-[#00A39E] transition-all duration-200 hover:scale-[1.02]"
          >
            {ctaFreeText}
          </a>
        </div>
      </div>

      <!-- Coluna da Foto Oficial -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-md">
          <!-- Borda estilizada diagonal inspirada no símbolo da marca -->
          <div class="absolute -inset-1.5 bg-gradient-to-tr from-[#00A39E] via-[#C6C6C6]/20 to-[#80142B] rounded-2xl opacity-75 blur-sm"></div>
          
          <div class="relative bg-[#1A1A1A] rounded-2xl overflow-hidden border border-[#C6C6C6]/30 shadow-2xl">
            <img
              src="/images/foto.png"
              alt="Maurício Leite"
              class="w-full h-auto object-cover max-h-[520px]"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-[#111111] via-[#111111]/70 to-transparent p-6 text-left">
              <p class="text-lg font-bold font-['Sora',sans-serif] text-white">
                Maurício Leite
              </p>
              <p class="text-xs font-mono text-[#00A39E]">
                Comprometimento · Velocidade · Clareza
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
