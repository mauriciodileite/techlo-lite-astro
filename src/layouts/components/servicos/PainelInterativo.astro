---
/**
 * Componente: PainelInterativo.astro
 * Descrição: Print interativo do painel cria.chat com 4 pontos clicáveis/focáveis
 * Implementado com 100% CSS NATIVO (ZERO JAVASCRIPT).
 */
import pontosData from "@/data/painel-criachat-pontos.json";

interface Ponto {
  id: number;
  lado: "esquerdo" | "direito";
  area: string;
  titulo: string;
  texto: string;
  x: number;
  y: number;
  icone: string;
}

const pontos: Ponto[] = pontosData as Ponto[];
---

<div class="relative w-full">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
    
    <!-- Coluna da Esquerda: Títulos e Cards de Recursos (Estilo Chatvolt) -->
    <div class="lg:col-span-4 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-[#00A39E] font-['Sora',sans-serif] font-semibold">
          Visão Geral do Painel
        </span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight mb-4 leading-tight">
        Painel Centralizado para todas as conversas
      </h2>

      <p class="text-sm sm:text-base text-[#C6C6C6] font-['Instrument_Sans',sans-serif] mb-6 leading-relaxed">
        Todas as suas conversas, de todos os canais e atendentes, organizadas e acessíveis em um só lugar.
      </p>

      <!-- Lista de Cards dos 4 Recursos -->
      <div class="space-y-3">
        {pontos.map((ponto) => (
          <div class="p-3.5 sm:p-4 rounded-xl bg-[#162026] border border-white/5 hover:border-[#00A39E]/40 transition-all flex items-start gap-3.5">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-[#00A39E]/15 border border-[#00A39E]/30 text-[#00A39E] font-['Sora',sans-serif] font-extrabold text-xs flex items-center justify-center mt-0.5">
              {ponto.id}
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-bold text-white font-['Sora',sans-serif] mb-1">
                {ponto.titulo}
              </h3>
              <p class="text-xs text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
                {ponto.texto}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Coluna da Direita: Mockup do Painel com Pontos Interativos (100% CSS Nativo) -->
    <div class="lg:col-span-8">
      <div class="relative w-full rounded-2xl overflow-hidden border border-white/10 bg-[#0d1418] shadow-2xl">
        
        <!-- Barra de Janela Superior do Mockup -->
        <div class="bg-[#141d22] px-4 py-2.5 border-b border-white/5 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56]/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f]/80 inline-block"></span>
            <span class="ml-2 text-[11px] font-mono text-[#8696a0]">cria.chat • Painel Multicanal</span>
          </div>
          <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-[#00A39E] bg-[#00A39E]/10 px-2 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E] animate-pulse"></span>
            LIVE SYNC ACTIVE
          </span>
        </div>

        <!-- Imagem Real do Painel (WebP Otimizado ~87KB) -->
        <div class="relative w-full">
          <img
            src="/images/servicos/painel-criachat.webp"
            alt="Painel cria.chat multicanal com WhatsApp e gestão de atendentes"
            width="1530"
            height="694"
            loading="lazy"
            decoding="async"
            class="w-full h-auto block select-none"
          />

          <!-- Camada de Hotspots Interativos (100% CSS: :hover e :focus-within) -->
          <div class="hidden md:block absolute inset-0 pointer-events-none">
            {pontos.map((ponto) => {
              const isEsquerdo = ponto.lado === "esquerdo";

              return (
                <div
                  class="hotspot-wrapper group absolute pointer-events-auto"
                  style={`left: ${ponto.x}%; top: ${ponto.y}%;`}
                  tabindex="0"
                  role="button"
                  aria-label={`Recurso ${ponto.id}: ${ponto.titulo}`}
                >
                  <!-- Ponto Pulsante Indicador -->
                  <div class="relative -translate-x-1/2 -translate-y-1/2 flex items-center justify-center cursor-pointer">
                    <span class="relative flex h-8 w-8 items-center justify-center">
                      <!-- Animação de pulso suave (respeita prefers-reduced-motion) -->
                      <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00A39E] opacity-75"></span>
                      <span class="relative inline-flex items-center justify-center rounded-full h-7 w-7 bg-[#00A39E] text-black font-['Sora',sans-serif] font-black text-xs shadow-lg shadow-[#00A39E]/50 border-2 border-[#111111] transition-transform duration-200 group-hover:scale-110 group-focus-within:scale-110">
                        {ponto.id}
                      </span>
                    </span>
                  </div>

                  <!-- Balão Explicativo Flutuante (100% CSS Nativo) -->
                  <div
                    class={`absolute z-30 w-64 sm:w-72 p-4 rounded-xl bg-[#162026]/95 backdrop-blur-md border border-[#00A39E]/50 shadow-2xl text-left pointer-events-none opacity-0 scale-95 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:scale-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:scale-100 group-focus-within:pointer-events-auto ${
                      isEsquerdo
                        ? "left-6 top-1/2 -translate-y-1/2"
                        : "right-6 top-1/2 -translate-y-1/2"
                    }`}
                  >
                    <!-- Cabeçalho do Balão com Número e Área -->
                    <div class="flex items-center gap-1.5 mb-1.5">
                      <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#00A39E]/20 text-[#00A39E] text-[10px] font-bold">
                        {ponto.id}
                      </span>
                      <span class="text-[11px] font-bold uppercase tracking-wider text-[#00A39E] font-['Sora',sans-serif]">
                        {ponto.area}
                      </span>
                    </div>

                    <h4 class="text-sm font-bold text-white font-['Sora',sans-serif] mb-1 leading-snug">
                      {ponto.titulo}
                    </h4>

                    <p class="text-xs text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
                      {ponto.texto}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>

        </div>

      </div>

      <!-- Dica Desktop para o visitante -->
      <p class="hidden md:block mt-3 text-xs text-[#8696a0] font-['Instrument_Sans',sans-serif] text-center">
        💡 Passe o mouse ou clique sobre os pontos 1, 2, 3 e 4 para inspecionar cada área do painel.
      </p>
    </div>

  </div>
</div>
