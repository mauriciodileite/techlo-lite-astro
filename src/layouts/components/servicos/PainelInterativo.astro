---
/**
 * Componente: PainelInterativo.astro
 * Descrição: Print interativo do painel cria.chat com 6 pontos clicáveis/focáveis
 * e lista semântica numerada para celulares.
 */
import pontosData from "@/data/painel-criachat-pontos.json";

interface Ponto {
  id: number;
  area: string;
  titulo: string;
  texto: string;
  x: number;
  y: number;
}

const pontos: Ponto[] = pontosData;
---

<div class="painel-interativo-wrapper relative w-full">
  <!-- Imagem Base do Painel com os Pontos Hotspot (Desktop) -->
  <div class="relative w-full rounded-2xl overflow-hidden border border-white/10 bg-[#0d1418] shadow-2xl">
    <img
      src="/images/servicos/painel-criachat.webp"
      alt="Print demonstrativo do painel cria.chat com agente de IA ativo"
      width="1200"
      height="750"
      loading="lazy"
      decoding="async"
      class="w-full h-auto block select-none pointer-events-none"
    />

    <!-- Camada de Hotspots Interativos (Visível apenas em md+) -->
    <div class="hidden md:block absolute inset-0 pointer-events-none">
      {pontos.map((ponto) => {
        // Alinhamento inteligente do balão para não vazar a borda da tela
        const alignRight = ponto.x > 65;
        const alignBottom = ponto.y < 35;

        return (
          <div
            class="hotspot-item absolute pointer-events-auto"
            style={`left: ${ponto.x}%; top: ${ponto.y}%;`}
          >
            <!-- Botão do Ponto Pulsante -->
            <button
              type="button"
              class="hotspot-btn relative -translate-x-1/2 -translate-y-1/2 flex items-center justify-center p-1 rounded-full cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#00A39E] focus-visible:ring-offset-2 focus-visible:ring-offset-black transition-transform hover:scale-110 active:scale-95"
              aria-label={`Ver recurso ${ponto.id}: ${ponto.titulo}`}
              aria-expanded="false"
              aria-controls={`tooltip-painel-${ponto.id}`}
              data-ponto-id={ponto.id}
            >
              <span class="relative flex h-8 w-8 items-center justify-center">
                <!-- Animação do pulso que respeita prefers-reduced-motion -->
                <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00A39E] opacity-75"></span>
                <span class="relative inline-flex items-center justify-center rounded-full h-7 w-7 bg-[#00A39E] text-black font-['Sora',sans-serif] font-extrabold text-xs shadow-lg shadow-[#00A39E]/50 border-2 border-[#111111]">
                  {ponto.id}
                </span>
              </span>
            </button>

            <!-- Balão de Informação (Tooltip) -->
            <div
              id={`tooltip-painel-${ponto.id}`}
              role="region"
              aria-label={ponto.titulo}
              class={`hotspot-popover absolute z-30 w-64 lg:w-72 p-4 rounded-xl bg-[#162026]/95 backdrop-blur-md border border-[#00A39E]/40 shadow-2xl text-left opacity-0 pointer-events-none transition-all duration-200 transform scale-95 ${
                alignRight
                  ? "right-4 -translate-y-1/2"
                  : "left-4 -translate-y-1/2"
              } ${alignBottom ? "top-8 -translate-y-0" : ""}`}
            >
              <!-- Seta decorativa do balão -->
              <div class="flex items-center gap-1.5 mb-1.5">
                <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#00A39E]/20 text-[#00A39E] text-[10px] font-bold">
                  {ponto.id}
                </span>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-[#00A39E] font-['Sora',sans-serif]">
                  {ponto.area}
                </span>
              </div>
              <h4 class="text-sm font-bold text-white font-['Sora',sans-serif] mb-1 leading-snug">
                {ponto.titulo}
              </h4>
              <p class="text-xs text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
                {ponto.texto}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Celular (Abaixo de 768px): Lista Numerada com o mesmo texto dos balões em HTML indexável -->
  <div class="mt-6 md:hidden">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {pontos.map((ponto) => (
        <div class="p-4 rounded-xl bg-[#162026] border border-white/5 flex items-start gap-3.5">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-[#00A39E] text-black font-['Sora',sans-serif] font-extrabold text-xs flex items-center justify-center mt-0.5">
            {ponto.id}
          </span>
          <div class="flex-1 min-w-0 text-left">
            <span class="block text-[11px] font-semibold uppercase tracking-wider text-[#00A39E] font-['Sora',sans-serif] mb-0.5">
              {ponto.area}
            </span>
            <h4 class="text-sm font-bold text-white font-['Sora',sans-serif] mb-1">
              {ponto.titulo}
            </h4>
            <p class="text-xs text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
              {ponto.texto}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function initPainelInterativo() {
    const containers = document.querySelectorAll('.painel-interativo-wrapper');
    
    containers.forEach((container) => {
      const items = container.querySelectorAll('.hotspot-item');

      function closeAll() {
        items.forEach((item) => {
          const btn = item.querySelector('.hotspot-btn');
          const popover = item.querySelector('.hotspot-popover');
          if (btn && popover) {
            btn.setAttribute('aria-expanded', 'false');
            popover.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
            popover.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
          }
        });
      }

      function openItem(item: Element) {
        closeAll();
        const btn = item.querySelector('.hotspot-btn');
        const popover = item.querySelector('.hotspot-popover');
        if (btn && popover) {
          btn.setAttribute('aria-expanded', 'true');
          popover.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
          popover.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        }
      }

      items.forEach((item) => {
        const btn = item.querySelector('.hotspot-btn');
        if (!btn) return;

        // Hover Desktop
        item.addEventListener('mouseenter', () => openItem(item));
        item.addEventListener('mouseleave', () => closeAll());

        // Foco pelo Teclado
        btn.addEventListener('focus', () => openItem(item));
        btn.addEventListener('blur', (e) => {
          // Fecha se o foco for para fora do container
          const nextTarget = (e as FocusEvent).relatedTarget as Node | null;
          if (!item.contains(nextTarget)) {
            closeAll();
          }
        });

        // Clique / Toque
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            closeAll();
          } else {
            openItem(item);
          }
        });
      });

      // Fechar ao teclar Esc
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAll();
      });

      // Fechar ao clicar fora
      document.addEventListener('click', (e) => {
        if (!container.contains(e.target as Node)) {
          closeAll();
        }
      });
    });
  }

  // Inicialização padrão e com Astro page transitions se aplicável
  initPainelInterativo();
  document.addEventListener('astro:page-load', initPainelInterativo);
</script>

