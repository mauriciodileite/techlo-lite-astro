---
/**
 * Componente: CrmKanban.astro
 * Descrição: Seção interativa de CRM e Kanban da cria.chat
 * - Desktop: Texto à esquerda, Mockup à direita. Hover puro no mouse (sem precisar clicar).
 * - Celular: Toque nativo nos números com balões explicativos via <details>. Fontes ampliadas para legibilidade móvel.
 * - 100% CSS NATIVO (Zero JS).
 */

const pontos = [
  {
    id: 1,
    cor: "verde",
    area: "Kanbans & Setores",
    titulo: "CRMs Criados na Mesma Tela",
    texto: "Selecione rapidamente seus CRMs criados na mesma tela, alternando entre funis e equipes com apenas um clique.",
    x: 7.5,
    y: 61,
    posicao: "esquerda"
  },
  {
    id: 2,
    cor: "azul",
    area: "Oportunidades",
    titulo: "Gestão Ágil do Funil",
    texto: "Crie uma nova oportunidade, exclua, edite e mova de acordo com o seu funil de vendas.",
    x: 88,
    y: 6,
    posicao: "direita"
  },
  {
    id: 3,
    cor: "vermelha",
    area: "Visão & Filtros",
    titulo: "Contatos e Filtros por Período",
    texto: "Visualize os contatos adicionados ao CRM em todas as oportunidades. Filtros por período e data de criação.",
    x: 35,
    y: 43,
    posicao: "centro"
  }
];
---

<div class="relative w-full">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Coluna de Texto e Benefícios (À ESQUERDA NO DESKTOP) -->
    <div class="lg:col-span-4 text-left order-1">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-[#00A39E] font-['Sora',sans-serif] font-semibold">
          Pipeline Comercial
        </span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight mb-4 leading-tight">
        CRM com IA para gerenciar oportunidades no WhatsApp
      </h2>

      <p class="text-lg sm:text-xl text-[#E0E0E0] font-['Instrument_Sans',sans-serif] mb-6 leading-relaxed">
        Chega de perder leads no meio das conversas. Acompanhe a jornada de cada cliente em colunas organizadas do primeiro "olá" até o fechamento.
      </p>

      <!-- Lista de Benefícios dos 3 Pontos -->
      <div class="space-y-4">
        <div class="p-4 sm:p-5 rounded-xl bg-[#162026] border border-white/5 hover:border-[#00A39E]/40 transition-all flex items-start gap-4">
          <span class="flex-shrink-0 w-9 h-9 rounded-lg bg-[#00A39E]/15 border border-[#00A39E]/30 text-[#00A39E] font-['Sora',sans-serif] font-extrabold text-sm flex items-center justify-center mt-0.5">
            1
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-base sm:text-lg font-bold text-white font-['Sora',sans-serif] mb-1.5">
              Múltiplos CRMs na mesma tela
            </h3>
            <p class="text-sm sm:text-base text-[#D4D4D4] leading-relaxed font-['Instrument_Sans',sans-serif]">
              Selecione rapidamente seus CRMs criados na mesma tela, alternando entre funis de vendas, suporte e pós-venda.
            </p>
          </div>
        </div>

        <div class="p-4 sm:p-5 rounded-xl bg-[#162026] border border-white/5 hover:border-[#00A39E]/40 transition-all flex items-start gap-4">
          <span class="flex-shrink-0 w-9 h-9 rounded-lg bg-[#00A39E]/15 border border-[#00A39E]/30 text-[#00A39E] font-['Sora',sans-serif] font-extrabold text-sm flex items-center justify-center mt-0.5">
            2
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-base sm:text-lg font-bold text-white font-['Sora',sans-serif] mb-1.5">
              Controle ágil de oportunidades
            </h3>
            <p class="text-sm sm:text-base text-[#D4D4D4] leading-relaxed font-['Instrument_Sans',sans-serif]">
              Crie uma nova oportunidade, exclua, edite e mova cards livremente de acordo com a evolução do seu funil.
            </p>
          </div>
        </div>

        <div class="p-4 sm:p-5 rounded-xl bg-[#162026] border border-white/5 hover:border-[#00A39E]/40 transition-all flex items-start gap-4">
          <span class="flex-shrink-0 w-9 h-9 rounded-lg bg-[#00A39E]/15 border border-[#00A39E]/30 text-[#00A39E] font-['Sora',sans-serif] font-extrabold text-sm flex items-center justify-center mt-0.5">
            3
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-base sm:text-lg font-bold text-white font-['Sora',sans-serif] mb-1.5">
              Visão geral com filtros inteligentes
            </h3>
            <p class="text-sm sm:text-base text-[#D4D4D4] leading-relaxed font-['Instrument_Sans',sans-serif]">
              Visualize os contatos adicionados ao CRM em todas as oportunidades, filtrando por período e data de criação.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Coluna do Mockup Visual (À DIREITA NO DESKTOP) -->
    <div class="lg:col-span-8 order-2">
      <div class="relative w-full rounded-2xl overflow-hidden border border-white/10 bg-[#0d1418] shadow-2xl">
        
        <!-- Barra de Janela Superior do Mockup -->
        <div class="bg-[#141d22] px-4 py-2.5 border-b border-white/5 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56]/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f]/80 inline-block"></span>
            <span class="ml-2 text-xs font-mono text-[#8696a0]">cria.chat • CRM & Oportunidades</span>
          </div>
          <span class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[#00A39E] bg-[#00A39E]/10 px-2.5 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E] animate-pulse"></span>
            FUNIL INTEGRADO
          </span>
        </div>

        <!-- Imagem Real do CRM -->
        <div class="relative w-full">
          <img
            src="/images/servicos/crm-kanban-criachat.webp"
            alt="Módulo de CRM e Kanban de oportunidades da cria.chat"
            width="1528"
            height="685"
            loading="lazy"
            decoding="async"
            class="w-full h-auto block select-none"
          />

          <!-- Camada de Hotspots Interativos -->
          <div class="absolute inset-0 pointer-events-none">
            <!-- VERSÃO CELULAR (md:hidden): Toque nativo com card centralizado na área de segurança da imagem -->
            {pontos.map((ponto) => (
              <details
                name="crm-hotspots"
                class="mobile-hotspot-item group/hotspot md:hidden absolute inset-0 pointer-events-none open:z-50 [&[open]]:z-50"
              >
                <summary
                  class="list-none outline-none cursor-pointer absolute -translate-x-1/2 -translate-y-1/2 flex items-center justify-center select-none [&::-webkit-details-marker]:hidden p-1.5 pointer-events-auto z-20"
                  style={`left: ${ponto.x}%; top: ${ponto.y}%;`}
                  aria-label={`Ponto ${ponto.id}: ${ponto.titulo}`}
                >
                  <span class="relative flex h-8 w-8 items-center justify-center">
                    <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00A39E] opacity-75"></span>
                    <span class="relative inline-flex items-center justify-center rounded-full h-7 w-7 bg-[#00A39E] text-black font-['Sora',sans-serif] font-black text-xs shadow-lg shadow-[#00A39E]/50 border-2 border-[#111111]">
                      {ponto.id}
                    </span>
                  </span>
                </summary>

                <!-- Backdrop escuro e card centralizado no meio da imagem -->
                <div class="hotspot-backdrop absolute inset-0 flex items-center justify-center p-3 sm:p-4 bg-black/70 backdrop-blur-[2px] pointer-events-auto z-30">
                  <div class="w-full max-w-[290px] sm:max-w-xs p-3 sm:p-4 rounded-xl bg-[#162026] border-2 border-[#00A39E] shadow-2xl text-left relative">
                    <div class="flex items-center justify-between gap-1.5 mb-1.5">
                      <div class="flex items-center gap-1.5">
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-[#00A39E]/20 text-[#00A39E] text-xs font-bold font-['Sora',sans-serif]">
                          {ponto.id}
                        </span>
                        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-[#00A39E] font-['Sora',sans-serif]">
                          {ponto.area}
                        </span>
                      </div>
                      <button
                        type="button"
                        class="hotspot-close-trigger text-[#8696a0] hover:text-white cursor-pointer px-1.5 py-0.5 text-xs rounded border border-white/10 hover:border-white/30"
                        aria-label="Fechar"
                      >
                        ✕
                      </button>
                    </div>

                    <h4 class="text-xs sm:text-sm font-bold text-white font-['Sora',sans-serif] mb-1 leading-snug">
                      {ponto.titulo}
                    </h4>

                    <p class="text-[11px] sm:text-xs text-[#D4D4D4] leading-relaxed font-['Instrument_Sans',sans-serif]">
                      {ponto.texto}
                    </p>
                  </div>
                </div>
              </details>
            ))}

            <!-- VERSÃO COMPUTADOR (hidden md:block): Hover puro 100% CSS sem precisar de clique -->
            {pontos.map((ponto) => (
              <div
                class="hidden md:block hotspot-wrapper group absolute"
                style={`left: ${ponto.x}%; top: ${ponto.y}%;`}
              >
                <div
                  class="cursor-pointer relative -translate-x-1/2 -translate-y-1/2 flex items-center justify-center select-none p-1 pointer-events-auto"
                  aria-label={`Ponto ${ponto.id}: ${ponto.titulo}`}
                >
                  <span class="relative flex h-8 w-8 items-center justify-center transition-transform duration-200 group-hover:scale-125">
                    <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00A39E] opacity-75"></span>
                    <span class="relative inline-flex items-center justify-center rounded-full h-7 w-7 bg-[#00A39E] text-black font-['Sora',sans-serif] font-black text-xs shadow-lg shadow-[#00A39E]/50 border-2 border-[#111111]">
                      {ponto.id}
                    </span>
                  </span>
                </div>

                <!-- Balão no hover do desktop -->
                <div
                  class={`absolute z-40 w-72 p-4 rounded-xl bg-[#162026]/98 backdrop-blur-md border border-[#00A39E]/60 shadow-2xl text-left pointer-events-none opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto transition-all duration-200 ${
                    ponto.posicao === "esquerda"
                      ? "left-4 top-8"
                      : ponto.posicao === "direita"
                      ? "right-4 top-8"
                      : "left-1/2 -translate-x-1/2 bottom-8"
                  }`}
                >
                  <div class="flex items-center justify-between gap-1.5 mb-2">
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-[#00A39E]/20 text-[#00A39E] text-xs font-bold">
                        {ponto.id}
                      </span>
                      <span class="text-xs font-bold uppercase tracking-wider text-[#00A39E] font-['Sora',sans-serif]">
                        {ponto.area}
                      </span>
                    </div>
                  </div>

                  <h4 class="text-sm font-bold text-white font-['Sora',sans-serif] mb-1.5 leading-snug">
                    {ponto.titulo}
                  </h4>

                  <p class="text-xs text-[#D4D4D4] leading-relaxed font-['Instrument_Sans',sans-serif]">
                    {ponto.texto}
                  </p>
                </div>
              </div>
            ))}
          </div>

        </div>

      </div>

      <!-- Dica Interativa para o visitante -->
      <p class="mt-3 text-sm text-[#8696a0] font-['Instrument_Sans',sans-serif] text-center">
        💡 <span class="hidden sm:inline">Passe o mouse</span><span class="sm:hidden">Toque</span> nos números 1, 2 e 3 no print para inspecionar cada recurso.
      </p>
    </div>

  </div>
</div>

<script>
  // Suporte a fechamento do modal mobile ao tocar no botão ✕ ou no backdrop escuro
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target) return;

    if (target.closest('.hotspot-close-trigger')) {
      const details = target.closest('details');
      if (details) details.removeAttribute('open');
      return;
    }

    if (target.classList.contains('hotspot-backdrop')) {
      const details = target.closest('details');
      if (details) details.removeAttribute('open');
    }
  });
</script>
