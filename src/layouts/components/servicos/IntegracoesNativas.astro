---
/**
 * Componente: IntegracoesNativas.astro
 * Descrição: Grid de 10 integrações nativas e canais suportados pela cria.chat + Maurício Leite
 * Layout balanceado de 5 colunas x 2 linhas no desktop (2 colunas no mobile).
 * Cores alinhadas ao Brand Book (Verde Água #00A39E, Neon #29FF54 e fundo escuro).
 */

const integracoes = [
  {
    nome: "WhatsApp",
    tipo: "Mensageria",
    descricao: "WhatsApp Oficial com verificação",
    icone: "whatsapp"
  },
  {
    nome: "Integração Sob Medida",
    tipo: "Customizada",
    descricao: "Desenvolvemos para qualquer API",
    destaque: true,
    icone: "custom"
  },
  {
    nome: "Instagram Direct",
    tipo: "Rede Social",
    descricao: "Direct e respostas a comentários",
    icone: "instagram"
  },
  {
    nome: "Facebook Messenger",
    tipo: "Mensageria",
    descricao: "Atendimento unificado via página",
    icone: "messenger"
  },
  {
    nome: "API & Webhooks",
    tipo: "Desenvolvedores",
    descricao: "Envie e receba dados em tempo real",
    icone: "api"
  },
  {
    nome: "Telegram",
    tipo: "Mensageria",
    descricao: "Canais, grupos e bots autônomos",
    icone: "telegram"
  },
  {
    nome: "E-mail",
    tipo: "Comunicação",
    descricao: "Caixas de suporte e notificações",
    icone: "email"
  },
  {
    nome: "SMS",
    tipo: "Disparo",
    descricao: "Avisos e mensagens de texto SMS",
    icone: "sms"
  },
  {
    nome: "Website",
    tipo: "Web Chat",
    descricao: "Widget conversacional no seu site",
    icone: "website"
  },
  {
    nome: "MyHonda",
    tipo: "Automotivo",
    descricao: "Integração para rede concessionárias",
    icone: "myhonda"
  }
];
---

<div class="border-t border-white/10 pt-16 md:pt-20">
  <!-- Cabeçalho Centralizado da Seção -->
  <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#1A1A1A] border border-[#00A39E]/30 mb-4 shadow-sm">
      <span class="text-[#00A39E]">🔌</span>
      <span class="text-xs uppercase tracking-widest text-[#00A39E] font-['Sora',sans-serif] font-bold">
        Conecte Tudo
      </span>
    </div>

    <h3 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight mb-4 leading-tight">
      Integrações nativas
    </h3>

    <p class="text-base sm:text-lg text-[#D4D4D4] font-['Instrument_Sans',sans-serif] leading-relaxed max-w-2xl mx-auto">
      Integre seu agente para responder em seus canais de comunicação. E conecte facilmente com seus dados e ferramentas nos principais serviços.
    </p>
  </div>

  <!-- Grid Balanceado de 10 Cards (2x5 no desktop, 5x2 no mobile) -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3.5 sm:gap-5 max-w-6xl mx-auto">
    {integracoes.map((item) => (
      <div
        class={`group relative p-4 sm:p-5 rounded-2xl border transition-all duration-300 flex flex-col items-center justify-center text-center h-full min-h-[160px] sm:min-h-[175px] ${
          item.destaque
            ? "bg-gradient-to-b from-[#162026] to-[#0d161a] border-[#00A39E]/60 shadow-lg shadow-[#00A39E]/10 hover:border-[#00A39E] hover:scale-[1.03]"
            : "bg-[#162026] border-white/10 hover:border-[#00A39E]/50 hover:bg-[#1a252c] hover:scale-[1.03]"
        }`}
      >
        <!-- Ícone Estilizado com Fundo e Brilho Brand Book -->
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-[#00A39E]/10 border border-[#00A39E]/25 group-hover:border-[#00A39E] group-hover:bg-[#00A39E]/20 transition-all flex items-center justify-center mb-3 shadow-inner">
          {item.icone === "whatsapp" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.587 1.961.954 2.8.956 3.182 0 5.768-2.587 5.768-5.766.001-3.181-2.585-5.767-5.772-5.767zm7.575 5.765c0 4.179-3.399 7.578-7.578 7.578-1.302-.002-2.531-.336-3.619-.948l-4.409 1.156 1.176-4.296c-.689-1.127-1.054-2.433-1.052-3.771 0-4.178 3.399-7.578 7.578-7.578 4.18.001 7.579 3.4 7.579 7.579z"/>
            </svg>
          )}

          {item.icone === "custom" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#29FF54]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
            </svg>
          )}

          {item.icone === "instagram" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#E1306C]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          )}

          {item.icone === "messenger" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#0084FF]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.91 1.455 5.518 3.735 7.209v3.533l3.39-1.862c.915.253 1.884.389 2.875.389 5.523 0 10-4.145 10-9.269C22 6.145 17.523 2 12 2zm1.06 12.433l-2.707-2.887-5.28 2.887 5.807-6.166 2.773 2.887 5.214-2.887-5.807 6.166z"/>
            </svg>
          )}

          {item.icone === "api" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          )}

          {item.icone === "telegram" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#229ED9]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
          )}

          {item.icone === "email" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          )}

          {item.icone === "sms" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          )}

          {item.icone === "website" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
          )}

          {item.icone === "myhonda" && (
            <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#E60012]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h10l2-2zm0 0h5l3 3V10l-3-4h-5v10z"/>
            </svg>
          )}
        </div>

        <!-- Nome da Integração -->
        <h4 class="font-['Sora',sans-serif] font-bold text-sm sm:text-base text-white mb-1 group-hover:text-[#00A39E] transition-colors leading-snug">
          {item.nome}
        </h4>

        <!-- Descrição Curta -->
        <p class="text-[11px] sm:text-xs text-[#8696a0] font-['Instrument_Sans',sans-serif] leading-tight">
          {item.descricao}
        </p>

        {item.destaque && (
          <span class="mt-2 inline-block text-[9px] uppercase tracking-wider font-extrabold text-[#29FF54] bg-[#29FF54]/10 border border-[#29FF54]/30 px-2 py-0.5 rounded-full">
            Sob Medida
          </span>
        )}
      </div>
    ))}
  </div>
</div>
