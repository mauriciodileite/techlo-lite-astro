---
/**
 * Componente: EquipeAtendentes.astro
 * Descrição: Seção interativa de Gestão de Atendentes e Hierarquia por Número da cria.chat
 * Funciona no Desktop (hover/clique) e no Celular (ao toque com <details>), 100% CSS NATIVO (Zero JS).
 */

const pontos = [
  {
    id: 1,
    cor: "azul",
    area: "Acesso & Hierarquia",
    titulo: "Acesso Exclusivo por Setor e Permissão",
    texto: "Dê acesso individual para cada colaborador: ele recebe login e senha próprios direto no e-mail e só visualiza a caixa de entrada dos números autorizados.",
    x: 21,
    y: 39,
    posicao: "esquerda"
  },
  {
    id: 2,
    cor: "vermelha",
    area: "Segmentação por Número",
    titulo: "Atendentes Diferentes para Linhas Diferentes",
    texto: "Distribua sua equipe entre diferentes números de WhatsApp: separe vendedores na linha comercial, suporte no atendimento e financeiro no canal de cobrança.",
    x: 65,
    y: 39,
    posicao: "direita"
  }
];
---

<div class="relative w-full">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
    
    <!-- Coluna do Mockup Visual (À esquerda no desktop para alternar o ritmo) -->
    <div class="lg:col-span-8 order-2 lg:order-1">
      <div class="relative w-full rounded-2xl overflow-hidden border border-white/10 bg-[#0d1418] shadow-2xl">
        
        <!-- Barra de Janela Superior do Mockup -->
        <div class="bg-[#141d22] px-4 py-2.5 border-b border-white/5 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56]/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f]/80 inline-block"></span>
            <span class="ml-2 text-[11px] font-mono text-[#8696a0]">cria.chat • Configurações & Equipe</span>
          </div>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-[#00A39E] bg-[#00A39E]/10 px-2 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E] animate-pulse"></span>
            CONTROLE HIERÁRQUICO
          </span>
        </div>

        <!-- Imagem Real de Atendentes por Inbox -->
        <div class="relative w-full">
          <img
            src="/images/servicos/gestao-atendentes-criachat.webp"
            alt="Configuração de atendentes por número e controle de acesso no WhatsApp cria.chat"
            width="1514"
            height="687"
            loading="lazy"
            decoding="async"
            class="w-full h-auto block select-none"
          />

          <!-- Camada de Hotspots Interativos (Visível no Celular e no Desktop) -->
          <div class="absolute inset-0 pointer-events-none">
            {pontos.map((ponto) => (
              <details
                name="atendentes-hotspots"
                class="hotspot-details group absolute pointer-events-auto"
                style={`left: ${ponto.x}%; top: ${ponto.y}%;`}
              >
                <!-- Botão / Gatilho de Toque e Clique (Summary) -->
                <summary
                  class="list-none outline-none cursor-pointer relative -translate-x-1/2 -translate-y-1/2 flex items-center justify-center select-none [&::-webkit-details-marker]:hidden p-1 focus-visible:ring-2 focus-visible:ring-[#00A39E] rounded-full"
                  aria-label={`Ponto ${ponto.id}: ${ponto.titulo}`}
                >
                  <span class="relative flex h-7 w-7 sm:h-8 sm:w-8 items-center justify-center">
                    <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00A39E] opacity-75"></span>
                    <span class="relative inline-flex items-center justify-center rounded-full h-6 w-6 sm:h-7 sm:w-7 bg-[#00A39E] text-black font-['Sora',sans-serif] font-black text-xs shadow-lg shadow-[#00A39E]/50 border-2 border-[#111111] transition-transform duration-200 group-hover:scale-110">
                      {ponto.id}
                    </span>
                  </span>
                </summary>

                <!-- Balão Explicativo (Abre ao toque via details, ou hover no desktop via CSS) -->
                <div
                  class={`hotspot-bubble absolute z-40 w-56 sm:w-72 p-3 sm:p-4 rounded-xl bg-[#162026]/98 backdrop-blur-md border border-[#00A39E]/60 shadow-2xl text-left pointer-events-auto transition-all duration-200 animate-in fade-in zoom-in-95 ${
                    ponto.posicao === "esquerda"
                      ? "left-2 sm:left-4 top-8 sm:top-10"
                      : "right-2 sm:right-4 top-8 sm:top-10"
                  }`}
                >
                  <div class="flex items-center justify-between gap-1.5 mb-1.5">
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#00A39E]/20 text-[#00A39E] text-[10px] font-bold">
                        {ponto.id}
                      </span>
                      <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-[#00A39E] font-['Sora',sans-serif]">
                        {ponto.area}
                      </span>
                    </div>
                    <span class="text-[10px] text-[#8696a0] hover:text-white cursor-pointer px-1">✕</span>
                  </div>

                  <h4 class="text-xs sm:text-sm font-bold text-white font-['Sora',sans-serif] mb-1 leading-snug">
                    {ponto.titulo}
                  </h4>

                  <p class="text-[11px] sm:text-xs text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
                    {ponto.texto}
                  </p>
                </div>
              </details>
            ))}
          </div>

        </div>

      </div>

      <!-- Dica Interativa para o visitante -->
      <p class="mt-3 text-xs text-[#8696a0] font-['Instrument_Sans',sans-serif] text-center">
        💡 <span class="hidden sm:inline">Passe o mouse ou clique</span><span class="sm:hidden">Toque</span> nos números 1 e 2 no print para inspecionar cada recurso.
      </p>
    </div>

    <!-- Coluna de Texto e Benefícios (À direita no desktop) -->
    <div class="lg:col-span-4 text-left order-1 lg:order-2">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-[#00A39E] font-['Sora',sans-serif] font-semibold">
          Segurança & Gestão
        </span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight mb-4 leading-tight">
        Atendentes específicos por número com controle total de hierarquia
      </h2>

      <p class="text-sm sm:text-base text-[#C6C6C6] font-['Instrument_Sans',sans-serif] mb-6 leading-relaxed">
        Cada atendente só enxerga a caixa de entrada do seu setor, enquanto o dono da empresa tem visão panorâmica de todo o time em tempo real.
      </p>

      <!-- Lista de Benefícios dos 2 Pontos -->
      <div class="space-y-3.5">
        <div class="p-4 rounded-xl bg-[#162026] border border-white/5 hover:border-[#00A39E]/40 transition-all flex items-start gap-3.5">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-[#00A39E]/15 border border-[#00A39E]/30 text-[#00A39E] font-['Sora',sans-serif] font-extrabold text-xs flex items-center justify-center mt-0.5">
            1
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold text-white font-['Sora',sans-serif] mb-1">
              Acesso exclusivo por colaborador
            </h3>
            <p class="text-xs text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
              Cada membro recebe login e senha próprios no e-mail e só tem permissão para visualizar as conversas do número específico atribuído a ele.
            </p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-[#162026] border border-white/5 hover:border-[#00A39E]/40 transition-all flex items-start gap-3.5">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-[#00A39E]/15 border border-[#00A39E]/30 text-[#00A39E] font-['Sora',sans-serif] font-extrabold text-xs flex items-center justify-center mt-0.5">
            2
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold text-white font-['Sora',sans-serif] mb-1">
              Setorização por linhas de atendimento
            </h3>
            <p class="text-xs text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
              Separe números de WhatsApp para vendas, suporte técnico, cobrança ou avisos, alocando exatamente quem deve responder em cada canal.
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Abre também no hover em dispositivos com mouse (desktop), sem precisar clicar */
  @media (hover: hover) and (pointer: fine) {
    .hotspot-details:hover .hotspot-bubble {
      display: block;
      opacity: 1;
      visibility: visible;
    }
    .hotspot-details:not([open]):not(:hover) .hotspot-bubble {
      display: none;
    }
  }
</style>
