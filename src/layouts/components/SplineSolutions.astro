---
/**
 * Componente: SplineSolutions.astro
 * Responsabilidade: Apresentar as soluções de Maurício Leite através do Accordion interativo 3D do Spline.
 * Diretrizes do Brand Book: Fundo Preto Pista (#111111), bordas em Prata (#C6C6C6/20), acento em Petronas (#00A39E).
 */

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Minhas soluções",
  subtitle = "Arquitetura completa de vendas, automação e lucratividade para o seu negócio."
} = Astro.props;
---

<section id="solucoes" class="py-16 md:py-24 bg-[#111111] text-white">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-12">
      <span class="text-xs uppercase tracking-widest text-[#00A39E] font-semibold">
        ECOSSISTEMA DE RESULTADOS
      </span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2 font-['Sora',sans-serif] text-white">
        {title}
      </h2>
      <p class="mt-4 text-base md:text-lg text-[#C6C6C6] max-w-2xl mx-auto font-['Instrument_Sans',sans-serif]">
        {subtitle}
      </p>
    </div>

    {/* Container Responsivo para o Iframe Spline 3D */}
    <div class="w-full mx-auto max-w-4xl">
      <div class="relative w-full h-[620px] sm:h-[700px] md:h-[780px] lg:h-[820px] rounded-2xl overflow-hidden border border-[#C6C6C6]/20 bg-[#17171a] shadow-2xl">
        <iframe
          src="https://my.spline.design/verticallayoutaccordioncopycopy-om2kcPZKIqfkKLkz0QNQxEdY-JKU/"
          frameborder="0"
          width="100%"
          height="100%"
          class="w-full h-full border-0"
          loading="lazy"
          title="Minhas Soluções - Maurício Leite"
        ></iframe>
      </div>
    </div>
  </div>
</section>
