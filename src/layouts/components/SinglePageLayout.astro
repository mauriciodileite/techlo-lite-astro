---
import { shortcodes } from "@/lib/shortcodes";
import { getEntryCTM } from "@/lib/contentParser.astro";
import config from ".astro/config.generated.json";
import OptimizedImage from "./utilities/OptimizedImage.astro";
import formatRelativeDate from "@/lib/utils/formatRelativeDate";
import { markdownify, slugifyyy } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import extractSlug from "@/lib/utils/extractSlug";

interface Props {
  content: CollectionEntry<"pages">;
  isEnglish?: boolean;
  class?: string;
  [key: string]: any;
}

const { tableOfContents } = config.settings.markup;
const { content, isEnglish = false, class: className } = Astro.props;
let { title, description, date, image, author, categories } = content.data;

let Content: any, rawHeadings: any[];
({ Content, headings: rawHeadings } = await render(content));

const authorName = author
  ? (await getEntryCTM("author", slugifyyy(author), Astro.currentLocale))?.data?.title
  : "";

const metaItems = [
  date && markdownify(formatRelativeDate(date, "dd MMM, yyyy")),
  ...(categories?.map((category: string) => markdownify(category)) || []),
  authorName && `By ${markdownify(authorName)}`,
].filter(Boolean);

// Filter headings for TOC (h2 and h3)
const tocItems = (rawHeadings || []).filter(
  (h) => (h.depth === 2 || h.depth === 3) && h.text && h.slug
);
const hasToc = tableOfContents?.enable && tocItems.length > 0;
const tocTitle = isEnglish ? "Table of Contents" : "Índice de Conteúdo";

const slug = extractSlug(content).split("/").pop() || "";
const isLegalPage = slug.includes("privac") || slug.includes("term");
const isPrivacy = slug.includes("privac");
const isTerms = slug.includes("term");

const homeUrl = isEnglish ? "/en/" : "/";
const privacyUrl = isEnglish ? "/en/privacy-policy/" : "/politica-de-privacidade/";
const termsUrl = isEnglish ? "/en/terms-conditions/" : "/termos-de-uso/";
---

<section class:list={["w-full", className]}>
  <div class="container mx-auto px-4 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-['Instrument_Sans',sans-serif] text-xs text-[#888888] mb-6">
      <a href={homeUrl} class="transition-colors hover:text-white">Home</a>
      <span>/</span>
      {isLegalPage && (
        <>
          <span class="text-[#00A39E] font-medium">Legal</span>
          <span>/</span>
        </>
      )}
      <span class="text-white truncate max-w-xs">{title}</span>
    </nav>

    {isLegalPage && (
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-8 pb-4 border-b border-white/10 font-['Sora',sans-serif] text-xs sm:text-sm">
        <a
          href={privacyUrl}
          class:list={[
            "px-4 py-2 rounded-lg font-medium transition-all duration-200",
            isPrivacy
              ? "bg-[#00A39E] text-black shadow-md shadow-[#00A39E]/20"
              : "bg-white/5 text-[#C6C6C6] hover:bg-white/10 hover:text-white"
          ]}
        >
          {isEnglish ? "Privacy Policy" : "Política de Privacidade"}
        </a>
        <a
          href={termsUrl}
          class:list={[
            "px-4 py-2 rounded-lg font-medium transition-all duration-200",
            isTerms
              ? "bg-[#00A39E] text-black shadow-md shadow-[#00A39E]/20"
              : "bg-white/5 text-[#C6C6C6] hover:bg-white/10 hover:text-white"
          ]}
        >
          {isEnglish ? "Terms of Use" : "Termos de Uso"}
        </a>
      </div>
    )}

    {image && Content && (
      <div class="mb-8 overflow-hidden rounded-2xl border border-white/10">
        <OptimizedImage
          width={896}
          height={500}
          alt={title}
          src={image as string}
          data-image-lightbox
          class:list={["h-64 sm:h-96 w-full object-cover"]}
        />
      </div>
    )}

    <!-- Header Section -->
    <header class="mb-8 space-y-3">
      {metaItems.length > 0 && (
        <ul class="text-xs text-[#888888] flex flex-wrap items-center gap-x-4 gap-y-1">
          {metaItems.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
      )}
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight leading-tight">
        {title}
      </h1>
      {description && (
        <p class="text-base sm:text-lg text-[#9A9A9A] font-['Instrument_Sans',sans-serif] leading-relaxed">
          {description}
        </p>
      )}
    </header>

    <!-- Table of Contents Brand Styled -->
    {hasToc && (
      <div class="mb-10 rounded-2xl border border-white/10 bg-[#161616] p-5 sm:p-6 transition-all duration-300">
        <details class="group" open>
          <summary class="flex cursor-pointer items-center justify-between font-['Sora',sans-serif] text-sm font-semibold tracking-wider text-white uppercase list-none select-none">
            <span class="flex items-center gap-2.5">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#00A39E]/10 text-[#00A39E] border border-[#00A39E]/20">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
              </span>
              <span>{tocTitle}</span>
              <span class="text-xs font-normal text-[#8A8A8A] font-['Instrument_Sans',sans-serif] normal-case">
                ({tocItems.length} {isEnglish ? "topics" : "tópicos"})
              </span>
            </span>
            <span class="text-[#8A8A8A] group-open:rotate-180 transition-transform duration-300 flex items-center justify-center w-8 h-8 rounded-full hover:bg-white/5">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>

          <nav class="mt-4 pt-4 border-t border-white/5 max-h-80 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-white/10">
            <ol class="space-y-2 text-sm font-['Instrument_Sans',sans-serif]">
              {tocItems.map((heading) => (
                <li class:list={[heading.depth === 3 ? "pl-5 text-xs text-[#9A9A9A]" : "pl-0 text-[#C6C6C6]"]}>
                  <a
                    href={`#${heading.slug}`}
                    class="group flex items-start gap-2.5 hover:text-white transition-colors py-0.5"
                  >
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#00A39E]/40 group-hover:bg-[#00A39E] group-hover:scale-125 transition-all"></span>
                    <span class="leading-relaxed group-hover:text-[#00A39E] transition-colors">{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      </div>
    )}

    <!-- Content Area with Brand Styling -->
    {Content && (
      <article
        class="prose prose-invert max-w-none text-[#C6C6C6] font-['Instrument_Sans',sans-serif] leading-relaxed
          prose-headings:font-['Sora',sans-serif] prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-white
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-white/10 prose-h2:pb-3
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-base prose-p:leading-relaxed prose-p:mb-5
          prose-a:text-[#00A39E] prose-a:font-medium prose-a:underline-offset-4 hover:prose-a:underline
          prose-strong:text-white
          prose-code:text-[#00A39E] prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
          prose-blockquote:border-l-[#00A39E] prose-blockquote:bg-white/5 prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-blockquote:italic prose-blockquote:text-white/90
          prose-ul:list-disc prose-ul:pl-6 prose-li:my-1.5
          prose-ol:list-decimal prose-ol:pl-6"
      >
        <Content components={shortcodes} />
      </article>
    )}
  </div>
</section>
