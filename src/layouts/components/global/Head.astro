---
import SEO from "@/components/seo/Seo.astro";
import OpenGraph from "@/components/seo/OpenGraph.astro";
import Favicons from "@/components/seo/Favicons.astro";
import JsonLD from "../widgets/JsonLD.astro";
import fontsJson from "@/config/fonts.json";
import { Font } from "astro:assets";
import config from ".astro/config.generated.json";

const fontVariables = fontsJson.map((font) => font.cssVariable) as any[];
const isArticle =
  Astro.props.pageType === "article" ||
  (Astro.url.pathname.includes("/blog/") &&
    !["/blog", "/blog/", "/pt/blog", "/pt/blog/", "/en/blog", "/en/blog/"].includes(Astro.url.pathname));
---

<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-WWQQ826L');</script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Language" content={Astro.currentLocale} />
  <meta name="theme" content="techlo-lite" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=5"
  />
  <SEO {...Astro.props} />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content={"#fff"}
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#000"
  />
  <meta name="generator" content={Astro.generator} />
  {config.head?.content && <Fragment set:html={config.head?.content} />}
  <OpenGraph {...Astro.props} />
  <Favicons />
  {/* Preload da imagem Hero LCP na Home para redução do LCP mobile */}
  {(Astro.url.pathname === "/" || Astro.url.pathname === "/pt" || Astro.url.pathname === "/pt/" || Astro.url.pathname === "/en" || Astro.url.pathname === "/en/") && (
    <link rel="preload" as="image" href="/images/perfil.jpg" fetchpriority="high" />
  )}
  <JsonLD
    content={{
      ...Astro.props,
    }}
  />

  <!-- Agentic Resource Discovery (ARD) -->
  <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />

  <!-- Google Reader Revenue Manager (Subscribe with Google Basic) - Carregado exclusivamente em artigos de blog -->
  {isArticle && (
    <>
      <script is:inline async type="application/javascript" src="https://news.google.com/swg/js/v1/swg-basic.js"></script>
      <script is:inline>
        (self.SWG_BASIC = self.SWG_BASIC || []).push(function(basicSubscriptions) {
          try {
            basicSubscriptions.init({
              type: "NewsArticle",
              isPartOfType: ["Product"],
              isPartOfProductId: "CAow54TiCw:openaccess",
              clientOptions: { theme: "light", lang: "pt-BR" },
            });
          } catch (e) {}
        });
      </script>
    </>
  )}

  <!------------------
    Fonts (Carregamento assíncrono não-bloqueante para Sora e Instrument Sans)
-------------------->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Sora:wght@400;500;600;700;800&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Sora:wght@400;500;600;700;800&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Sora:wght@400;500;600;700;800&display=swap"
    />
  </noscript>
  {fontVariables.map((font) => <Font cssVariable={font} />)}

  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1383981954802040');
    fbq('track', 'PageView');
  </script>
  <noscript>
    <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1383981954802040&ev=PageView&noscript=1"
    />
  </noscript>
  <!-- End Meta Pixel Code -->
</head>
