---
/**
 * Componente: CommentsSection.astro
 * Responsabilidade: comentários do blog, gravados no Supabase (projeto VSL).
 * - Só comenta quem está logado: Google ou e-mail e senha (Supabase Auth).
 * - Login em fluxo PKCE: nenhum token de sessão passa pela URL.
 * - Nome, foto e selo "Autor" são definidos no servidor (trigger), não no navegador.
 * - Respostas em árvore, voto único por pessoa, editar/apagar o próprio comentário.
 * - A biblioteca do Supabase só é baixada quando o leitor chega perto da seção.
 * Banco: supabase/migrations/20261115_blog_comentarios.sql
 */

interface Props {
  postSlug: string;
  isEnglish?: boolean;
}

const { postSlug, isEnglish = false } = Astro.props;

const supabaseUrl = "https://rhfufrjbzjkmiwgoauks.supabase.co";
// Chave publicável: feita para ficar no navegador. Quem protege os dados é o RLS.
const supabaseKey = "sb_publishable__vk_mYjY2ZBtVj6MTDHPtQ_KBDntsMg";

const privacyHref = isEnglish ? "/en/privacy-policy/" : "/politica-de-privacidade/";
const termsHref = isEnglish ? "/en/terms-conditions/" : "/termos-de-uso/";

const inputClass =
  "w-full bg-[#111111] border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-[#777777] focus:border-[#00A39E] outline-none transition-colors";
---

<section
  id="ml-comments-section"
  data-slug={postSlug}
  data-lang={isEnglish ? "en" : "pt"}
  data-url={supabaseUrl}
  data-key={supabaseKey}
  class="mt-16 pt-12 border-t border-white/10 font-body text-[#C6C6C6]"
>
  <!-- Cabeçalho -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-white/10 mb-8">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <h2 class="text-xl md:text-2xl font-bold font-heading text-white">
          <span id="ml-comments-count">0</span>
          {isEnglish ? "Comments" : "Comentários"}
        </h2>
      </div>
      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#00A39E]/15 text-[#00A39E] border border-[#00A39E]/30 font-heading">
        Comunidade ML
      </span>
    </div>

    <div class="flex items-center gap-2 text-xs">
      <label for="ml-comments-sort" class="text-[#888888]">{isEnglish ? "Sort by:" : "Ordenar por:"}</label>
      <select id="ml-comments-sort" class="bg-[#181818] border border-white/10 text-white text-xs rounded-lg px-2.5 py-1.5 focus:border-[#00A39E] outline-none cursor-pointer">
        <option value="newest" selected>{isEnglish ? "Newest" : "Mais recentes"}</option>
        <option value="best">{isEnglish ? "Most voted" : "Mais votados"}</option>
        <option value="oldest">{isEnglish ? "Oldest" : "Mais antigos"}</option>
      </select>
    </div>
  </div>

  <!-- Caixa de login / envio -->
  <div class="comment-box-card bg-[#161616] border border-white/10 rounded-2xl p-5 mb-10 transition-all duration-300 focus-within:border-[#00A39E]/60 shadow-lg">
    <p id="ml-comments-loading" class="text-sm text-[#888888]">
      {isEnglish ? "Loading comments…" : "Carregando comentários…"}
    </p>

    <!-- Visitante sem login -->
    <div id="ml-auth-out" class="hidden space-y-4">
      <div>
        <h3 class="font-heading font-semibold text-white text-base">
          {isEnglish ? "Sign in to comment" : "Entre para comentar"}
        </h3>
        <p class="text-xs text-[#888888] mt-1">
          {isEnglish
            ? "Your email is never shown. Only your name and photo appear next to your comment."
            : "Seu e-mail nunca aparece. Só seu nome e sua foto ficam ao lado do comentário."}
        </p>
      </div>

      <button
        type="button"
        id="ml-auth-google"
        class="inline-flex items-center justify-center gap-2.5 px-5 py-2.5 rounded-xl bg-white text-[#111111] border border-white/10 font-heading font-semibold text-sm transition-all hover:shadow-[0_0_15px_rgba(0,163,158,0.35)] cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.24 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.17v2.84A11 11 0 0 0 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.11a6.6 6.6 0 0 1 0-4.22V7.05H2.17a11 11 0 0 0 0 9.9l3.67-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.2 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.17 7.05l3.67 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
        </svg>
        <span>{isEnglish ? "Continue with Google" : "Continuar com Google"}</span>
      </button>

      <div>
        <button type="button" id="ml-auth-email-toggle" class="text-xs text-[#888888] underline underline-offset-4 hover:text-[#00A39E] cursor-pointer">
          {isEnglish ? "or use email and password" : "ou entrar com e-mail e senha"}
        </button>
      </div>

      <form id="ml-auth-email-form" class="hidden space-y-3 max-w-md" novalidate>
        <input id="ml-auth-name" type="text" autocomplete="name" maxlength="80" placeholder={isEnglish ? "Your name" : "Seu nome"} class:list={[inputClass, "hidden"]} />
        <input id="ml-auth-email" type="email" autocomplete="email" required placeholder={isEnglish ? "Email" : "E-mail"} class={inputClass} />
        <input id="ml-auth-password" type="password" autocomplete="current-password" required minlength="8" placeholder={isEnglish ? "Password (8+ characters)" : "Senha (mínimo 8 caracteres)"} class={inputClass} />
        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" id="ml-auth-email-submit" class="px-5 py-2.5 rounded-xl bg-[#00A39E] text-black font-heading font-semibold text-xs hover:bg-[#00c4be] transition-colors cursor-pointer">
            {isEnglish ? "Sign in" : "Entrar"}
          </button>
          <button type="button" id="ml-auth-mode" class="text-xs text-[#888888] underline underline-offset-4 hover:text-[#00A39E] cursor-pointer">
            {isEnglish ? "I don't have an account" : "Ainda não tenho conta"}
          </button>
        </div>
      </form>
    </div>

    <!-- Visitante logado -->
    <div id="ml-auth-in" class="hidden">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div class="flex items-center gap-3 min-w-0">
          <div id="ml-user-avatar" class="comment-avatar-placeholder w-10 h-10 rounded-full bg-[#222222] border border-white/15 flex items-center justify-center shrink-0 overflow-hidden text-[#00A39E] font-heading text-sm font-bold"></div>
          <span id="ml-user-name" class="comment-author-name font-heading font-semibold text-white text-sm truncate"></span>
        </div>
        <button type="button" id="ml-auth-signout" class="text-xs text-[#888888] underline underline-offset-4 hover:text-[#00A39E] cursor-pointer shrink-0">
          {isEnglish ? "Sign out" : "Sair"}
        </button>
      </div>

      <form id="ml-comments-form" class="space-y-3">
        <textarea
          id="ml-comments-text"
          required
          rows="3"
          maxlength="4000"
          placeholder={isEnglish ? "Join the discussion…" : "Participe da discussão com sua opinião ou dúvida…"}
          class="w-full bg-[#111111] border border-white/10 rounded-xl p-3.5 text-sm text-white placeholder-[#777777] focus:border-[#00A39E] outline-none transition-colors resize-y min-h-[80px]"
        ></textarea>
        <div class="flex justify-end">
          <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#00A39E] text-black font-heading font-semibold text-xs transition-all hover:bg-[#00c4be] hover:shadow-[0_0_15px_rgba(0,163,158,0.35)] cursor-pointer">
            <span>{isEnglish ? "Post comment" : "Publicar comentário"}</span>
          </button>
        </div>
      </form>
    </div>

    <p id="ml-comments-msg" role="status" aria-live="polite" class="hidden mt-4 text-xs text-white border border-[#00A39E]/40 bg-[#00A39E]/10 rounded-xl px-3.5 py-2.5"></p>

    <!-- Política de comentários -->
    <p class="mt-4 text-[11px] text-[#777777] leading-relaxed">
      {isEnglish ? "By commenting you agree to the " : "Ao comentar, você concorda com os "}
      <a href={termsHref} class="underline underline-offset-2 hover:text-[#00A39E]">{isEnglish ? "Terms of Use" : "Termos de Uso"}</a>
      {isEnglish ? " and the " : " e a "}
      <a href={privacyHref} class="underline underline-offset-2 hover:text-[#00A39E]">{isEnglish ? "Privacy Policy" : "Política de Privacidade"}</a>.
      {isEnglish
        ? " Spam, insults and unrelated advertising are removed."
        : " Spam, ofensas e propaganda fora do assunto são removidos."}
    </p>
  </div>

  <!-- Lista de comentários (preenchida pelo script) -->
  <div id="ml-comments-list" class="space-y-6"></div>
</section>

<script>
  const root = document.getElementById("ml-comments-section");
  if (root) initComments(root);

  function initComments(root: HTMLElement) {
    const slug = root.dataset.slug || "";
    const en = root.dataset.lang === "en";
    const RETURN_FLAG = "ml-comments-return";
    const FIELDS =
      "id,autor,autor_nome,autor_avatar,eh_autor_do_blog,conteudo,parent_id,criado_em,editado_em,blog_comentario_votos(user_id)";

    const T = en
      ? {
          empty: "No comments yet. Be the first to start the conversation!",
          loadError: "Could not load the comments. Please try again in a moment.",
          loginFirst: "Sign in to take part.",
          sendError: "Could not send. Please try again.",
          rate: "Too many comments in a row. Wait a minute and try again.",
          badLogin: "Wrong email or password, or the email is not confirmed yet.",
          confirm: "We sent a confirmation link to your email. Open it to finish creating your account.",
          authError: "Sign-in failed. Please try again.",
          weakPass: "Use a password with at least 8 characters.",
          needName: "Tell us your name.",
          signIn: "Sign in",
          signUp: "Create account",
          toSignUp: "I don't have an account",
          toSignIn: "I already have an account",
          reply: "Reply",
          edit: "Edit",
          del: "Delete",
          cancel: "Cancel",
          save: "Save",
          replyPh: "Write a reply…",
          delConfirm: "Delete this comment and its replies?",
          author: "Author",
          edited: "edited",
          now: "just now",
          ago: "ago",
          vote: "Vote for this comment",
        }
      : {
          empty: "Nenhum comentário ainda. Deixe sua pergunta ou opinião acima!",
          loadError: "Não foi possível carregar os comentários. Tente de novo em instantes.",
          loginFirst: "Entre para participar.",
          sendError: "Não foi possível enviar. Tente de novo.",
          rate: "Muitos comentários seguidos. Espere um minuto e tente de novo.",
          badLogin: "E-mail ou senha incorretos, ou o e-mail ainda não foi confirmado.",
          confirm: "Enviamos um link de confirmação para o seu e-mail. Abra o link para concluir o cadastro.",
          authError: "Não foi possível entrar. Tente de novo.",
          weakPass: "Use uma senha com pelo menos 8 caracteres.",
          needName: "Informe seu nome.",
          signIn: "Entrar",
          signUp: "Criar conta",
          toSignUp: "Ainda não tenho conta",
          toSignIn: "Já tenho conta",
          reply: "Responder",
          edit: "Editar",
          del: "Apagar",
          cancel: "Cancelar",
          save: "Salvar",
          replyPh: "Escreva uma resposta…",
          delConfirm: "Apagar este comentário e as respostas dele?",
          author: "Autor",
          edited: "editado",
          now: "agora mesmo",
          ago: "atrás",
          vote: "Votar neste comentário",
        };

    const el = (id: string) => document.getElementById(id) as any;
    const list = el("ml-comments-list");
    const msgBox = el("ml-comments-msg");

    let sb: any = null;
    let booting: Promise<void> | null = null;
    let user: any = null;
    let isMod = false;
    let rows: any[] = [];
    let sort = "newest";
    let signUpMode = false;

    function esc(str: unknown) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function say(text: string) {
      if (!msgBox) return;
      msgBox.textContent = text;
      msgBox.classList.toggle("hidden", !text);
    }

    function timeAgo(iso: string) {
      const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
      if (diff < 60) return T.now;
      if (diff < 3600) return `${Math.floor(diff / 60)} min ${T.ago}`;
      if (diff < 86400) return `${Math.floor(diff / 3600)} h ${T.ago}`;
      return new Date(iso).toLocaleDateString(en ? "en-US" : "pt-BR", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
    }

    function avatarHtml(name: string, url: string | null, mod: boolean, size: string) {
      if (url && /^https:\/\//.test(url)) {
        return `<img src="${esc(url)}" alt="" width="36" height="36" loading="lazy" referrerpolicy="no-referrer" class="${size} rounded-full object-cover shrink-0 border border-white/15" />`;
      }
      return `<div class="comment-avatar-badge ${size} rounded-full ${mod ? "bg-[#80142B] border-[#00A39E]" : "bg-[#00A39E]/20 border-[#00A39E]/30"} border flex items-center justify-center font-heading text-xs font-bold text-white shrink-0">${esc((name || "?").charAt(0).toUpperCase())}</div>`;
    }

    /* ---------- Sessão ---------- */

    function renderAuth() {
      el("ml-comments-loading")?.classList.add("hidden");
      el("ml-auth-out")?.classList.toggle("hidden", !!user);
      el("ml-auth-in")?.classList.toggle("hidden", !user);
      if (!user) return;
      const meta = user.user_metadata || {};
      const name = meta.full_name || meta.name || (user.email || "").split("@")[0] || "";
      const nameEl = el("ml-user-name");
      if (nameEl) nameEl.textContent = name;
      const av = el("ml-user-avatar");
      if (av) {
        const url = meta.avatar_url;
        av.innerHTML =
          url && /^https:\/\//.test(url)
            ? `<img src="${esc(url)}" alt="" width="40" height="40" referrerpolicy="no-referrer" class="w-full h-full object-cover" />`
            : esc(name.charAt(0).toUpperCase());
      }
    }

    function setUser(next: any) {
      const changed = (next?.id || null) !== (user?.id || null);
      user = next;
      if (!changed) return;
      isMod = false;
      renderAuth();
      renderList();
      if (user) {
        // Fora do callback de sessão: chamar o Supabase lá dentro trava a biblioteca.
        setTimeout(async () => {
          const { data } = await sb.rpc("blog_eh_moderador");
          isMod = data === true;
          if (isMod) renderList();
        }, 0);
      }
    }

    function boot() {
      if (booting) return booting;
      booting = (async () => {
        try {
          const params = new URLSearchParams(location.search);
          const authError = params.get("error_description") || params.get("error");

          const { createClient } = await import("@supabase/supabase-js");
          sb = createClient(root.dataset.url!, root.dataset.key!, {
            auth: { flowType: "pkce", detectSessionInUrl: true, persistSession: true },
          });
          sb.auth.onAuthStateChange((_event: string, session: any) => setUser(session?.user ?? null));

          const { data } = await sb.auth.getSession();
          setUser(data?.session?.user ?? null);
          renderAuth();

          // Limpa da barra de endereço qualquer resto do retorno do login.
          if (params.has("code") || params.has("error")) {
            ["code", "error", "error_code", "error_description"].forEach((k) => params.delete(k));
            const qs = params.toString();
            history.replaceState(history.state, "", location.pathname + (qs ? `?${qs}` : "") + location.hash);
          }
          if (authError) say(T.authError);

          let back = false;
          try {
            back = sessionStorage.getItem(RETURN_FLAG) === "1";
            sessionStorage.removeItem(RETURN_FLAG);
          } catch {}
          if (back) root.scrollIntoView({ block: "start" });

          await load();
        } catch {
          el("ml-comments-loading")?.classList.add("hidden");
          say(T.loadError);
        }
      })();
      return booting;
    }

    /* ---------- Dados ---------- */

    async function load() {
      const { data, error } = await sb
        .from("blog_comentarios")
        .select(FIELDS)
        .eq("post_slug", slug)
        .order("criado_em", { ascending: true });
      if (error) {
        say(T.loadError);
        return;
      }
      rows = data || [];
      renderList();
    }

    const votes = (c: any) => (c.blog_comentario_votos || []).length;
    const voted = (c: any) => !!user && (c.blog_comentario_votos || []).some((v: any) => v.user_id === user.id);

    function renderList() {
      const count = el("ml-comments-count");
      if (count) count.textContent = String(rows.length);
      if (!list) return;

      if (rows.length === 0) {
        list.innerHTML = `<div class="py-8 text-center text-xs text-neutral-500 border border-dashed border-white/5 rounded-2xl">${T.empty}</div>`;
        return;
      }

      const kids = new Map<string, any[]>();
      const ids = new Set(rows.map((c) => c.id));
      const tops: any[] = [];
      rows.forEach((c) => {
        if (c.parent_id && ids.has(c.parent_id)) {
          if (!kids.has(c.parent_id)) kids.set(c.parent_id, []);
          kids.get(c.parent_id)!.push(c);
        } else {
          tops.push(c);
        }
      });

      const time = (c: any) => new Date(c.criado_em).getTime();
      if (sort === "newest") tops.sort((a, b) => time(b) - time(a));
      else if (sort === "oldest") tops.sort((a, b) => time(a) - time(b));
      else tops.sort((a, b) => votes(b) - votes(a) || time(b) - time(a));

      const draw = (c: any, depth: number): string => {
        const mine = !!user && c.autor === user.id;
        const canDelete = mine || isMod;
        const wrap =
          depth === 0
            ? "comment-card-box bg-[#161616] border border-white/10 rounded-2xl p-5 mb-4"
            : `comment-item-reply ${depth < 4 ? "ml-4 sm:ml-10" : ""} mt-4 pl-4 border-l-2 border-white/10`;
        const btn = "text-[#888888] hover:text-[#00A39E] transition-colors cursor-pointer";
        return `
        <div class="comment-item ${wrap}" data-comment="${c.id}">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="flex items-center gap-3 min-w-0">
              ${avatarHtml(c.autor_nome, c.autor_avatar, c.eh_autor_do_blog, "w-9 h-9")}
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="comment-author-name font-heading font-semibold text-white text-sm truncate">${esc(c.autor_nome)}</span>
                  ${c.eh_autor_do_blog ? `<span class="lt-dark text-[9px] bg-[#80142B] text-white px-2 py-0.5 rounded-full font-bold uppercase tracking-wider border border-white/20">${T.author}</span>` : ""}
                </div>
                <span class="comment-time-ago text-[11px] text-[#777777]">${timeAgo(c.criado_em)}${c.editado_em ? ` · ${T.edited}` : ""}</span>
              </div>
            </div>
            <button type="button" data-act="vote" data-id="${c.id}" aria-label="${T.vote}" aria-pressed="${voted(c)}" class="upvote-btn flex items-center gap-1.5 px-2.5 py-1 rounded-lg border ${voted(c) ? "border-[#00A39E]" : "border-white/10"} bg-[#111111] hover:border-[#00A39E] text-xs text-[#C6C6C6] hover:text-[#00A39E] transition-all cursor-pointer shrink-0">
              <svg class="w-3 h-3 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
              <span class="font-bold font-heading">${votes(c)}</span>
            </button>
          </div>

          <p class="comment-content-text text-sm text-[#D1D1D1] leading-relaxed mb-3.5 whitespace-pre-line break-words" data-text="${c.id}">${esc(c.conteudo)}</p>

          <div class="hidden mb-3" data-editbox="${c.id}">
            <textarea rows="3" maxlength="4000" class="w-full bg-[#111111] border border-[#00A39E]/60 rounded-xl p-3 text-sm text-white focus:border-[#00A39E] outline-none resize-y">${esc(c.conteudo)}</textarea>
            <div class="flex justify-end gap-2 mt-2">
              <button type="button" data-act="edit" data-id="${c.id}" class="px-3 py-1.5 rounded-lg text-xs ${btn}">${T.cancel}</button>
              <button type="button" data-act="save" data-id="${c.id}" class="px-4 py-1.5 rounded-lg bg-[#00A39E] text-black font-heading font-semibold text-xs hover:bg-[#00c4be] transition-colors cursor-pointer">${T.save}</button>
            </div>
          </div>

          <div class="flex items-center gap-4 text-xs font-heading font-medium">
            <button type="button" data-act="reply" data-id="${c.id}" class="reply-toggle-btn ${btn}">${T.reply}</button>
            ${mine ? `<button type="button" data-act="edit" data-id="${c.id}" class="edit-comment-btn ${btn}">${T.edit}</button>` : ""}
            ${canDelete ? `<button type="button" data-act="delete" data-id="${c.id}" class="delete-comment-btn text-[#888888] hover:text-[#EF4444] transition-colors cursor-pointer">${T.del}</button>` : ""}
          </div>

          <div id="reply-form-${c.id}" class="hidden mt-4 pt-3 border-t border-white/5">
            <form data-reply="${c.id}" class="space-y-2.5">
              <textarea required rows="2" maxlength="4000" placeholder="${T.replyPh}" class="w-full bg-[#111111] border border-white/10 rounded-xl p-2.5 text-sm text-white placeholder-[#666666] focus:border-[#00A39E] outline-none"></textarea>
              <div class="flex justify-end gap-2">
                <button type="button" data-act="reply" data-id="${c.id}" class="px-3 py-1 rounded-lg text-xs ${btn}">${T.cancel}</button>
                <button type="submit" class="px-4 py-1.5 rounded-lg bg-[#00A39E] text-black font-heading font-semibold text-xs hover:bg-[#00c4be] cursor-pointer">${T.reply}</button>
              </div>
            </form>
          </div>

          ${(kids.get(c.id) || []).map((k) => draw(k, depth + 1)).join("")}
        </div>`;
      };

      list.innerHTML = tops.map((c) => draw(c, 0)).join("");
    }

    function needLogin() {
      if (user) return false;
      say(T.loginFirst);
      el("ml-auth-out")?.scrollIntoView({ block: "center", behavior: "smooth" });
      return true;
    }

    async function send(conteudo: string, parentId: string | null) {
      const text = conteudo.trim();
      if (text.length < 2 || needLogin()) return false;
      const { data, error } = await sb
        .from("blog_comentarios")
        .insert({ post_slug: slug, conteudo: text, parent_id: parentId })
        .select(FIELDS)
        .single();
      if (error) {
        say(/limite_de_comentarios/.test(error.message || "") ? T.rate : T.sendError);
        return false;
      }
      say("");
      rows.push(data);
      renderList();
      return true;
    }

    /* ---------- Eventos ---------- */

    list?.addEventListener("click", async (ev: Event) => {
      const btn = (ev.target as HTMLElement).closest("[data-act]") as HTMLElement | null;
      if (!btn || !sb) return;
      const id = btn.dataset.id!;
      const act = btn.dataset.act;
      const c = rows.find((r) => r.id === id);
      if (!c) return;

      if (act === "reply") {
        const box = document.getElementById(`reply-form-${id}`);
        if (box?.classList.contains("hidden") && needLogin()) return;
        box?.classList.toggle("hidden");
        if (box && !box.classList.contains("hidden")) box.querySelector("textarea")?.focus();
      } else if (act === "edit") {
        list.querySelector(`[data-editbox="${id}"]`)?.classList.toggle("hidden");
        list.querySelector(`[data-text="${id}"]`)?.classList.toggle("hidden");
      } else if (act === "save") {
        const area = list.querySelector(`[data-editbox="${id}"] textarea`) as HTMLTextAreaElement | null;
        const text = (area?.value || "").trim();
        if (text.length < 2) return;
        const { data, error } = await sb
          .from("blog_comentarios")
          .update({ conteudo: text })
          .eq("id", id)
          .select("conteudo,editado_em")
          .single();
        if (error) return say(T.sendError);
        Object.assign(c, data);
        renderList();
      } else if (act === "delete") {
        if (!confirm(T.delConfirm)) return;
        const { error } = await sb.from("blog_comentarios").delete().eq("id", id);
        if (error) return say(T.sendError);
        const gone = new Set([id]);
        let grew = true;
        while (grew) {
          grew = false;
          rows.forEach((r) => {
            if (r.parent_id && gone.has(r.parent_id) && !gone.has(r.id)) {
              gone.add(r.id);
              grew = true;
            }
          });
        }
        rows = rows.filter((r) => !gone.has(r.id));
        renderList();
      } else if (act === "vote") {
        if (needLogin()) return;
        const had = voted(c);
        const q = had
          ? sb.from("blog_comentario_votos").delete().eq("comentario_id", id).eq("user_id", user.id)
          : sb.from("blog_comentario_votos").insert({ comentario_id: id });
        const { error } = await q;
        if (error) return say(T.sendError);
        c.blog_comentario_votos = had
          ? (c.blog_comentario_votos || []).filter((v: any) => v.user_id !== user.id)
          : [...(c.blog_comentario_votos || []), { user_id: user.id }];
        renderList();
      }
    });

    list?.addEventListener("submit", async (ev: Event) => {
      const form = (ev.target as HTMLElement).closest("form[data-reply]") as HTMLFormElement | null;
      if (!form) return;
      ev.preventDefault();
      const area = form.querySelector("textarea") as HTMLTextAreaElement;
      await send(area.value, form.dataset.reply!);
    });

    el("ml-comments-form")?.addEventListener("submit", async (ev: Event) => {
      ev.preventDefault();
      const area = el("ml-comments-text") as HTMLTextAreaElement;
      if (await send(area.value, null)) area.value = "";
    });

    el("ml-comments-sort")?.addEventListener("change", (ev: Event) => {
      sort = (ev.target as HTMLSelectElement).value;
      renderList();
    });

    const cleanUrl = () => location.origin + location.pathname;

    el("ml-auth-google")?.addEventListener("click", async () => {
      await boot();
      if (!sb) return;
      try {
        sessionStorage.setItem(RETURN_FLAG, "1");
      } catch {}
      const { error } = await sb.auth.signInWithOAuth({
        provider: "google",
        options: { redirectTo: cleanUrl() },
      });
      if (error) say(T.authError);
    });

    el("ml-auth-email-toggle")?.addEventListener("click", () => {
      el("ml-auth-email-form")?.classList.toggle("hidden");
    });

    el("ml-auth-mode")?.addEventListener("click", () => {
      signUpMode = !signUpMode;
      el("ml-auth-name")?.classList.toggle("hidden", !signUpMode);
      el("ml-auth-password")?.setAttribute("autocomplete", signUpMode ? "new-password" : "current-password");
      el("ml-auth-email-submit").textContent = signUpMode ? T.signUp : T.signIn;
      el("ml-auth-mode").textContent = signUpMode ? T.toSignIn : T.toSignUp;
      say("");
    });

    el("ml-auth-email-form")?.addEventListener("submit", async (ev: Event) => {
      ev.preventDefault();
      await boot();
      if (!sb) return;
      const email = el("ml-auth-email").value.trim();
      const password = el("ml-auth-password").value;
      const name = el("ml-auth-name").value.trim();
      if (!email) return;
      if (password.length < 8) return say(T.weakPass);

      if (signUpMode) {
        if (name.length < 2) return say(T.needName);
        const { data, error } = await sb.auth.signUp({
          email,
          password,
          options: { data: { full_name: name }, emailRedirectTo: cleanUrl() },
        });
        if (error) return say(T.authError);
        say(data?.session ? "" : T.confirm);
      } else {
        const { error } = await sb.auth.signInWithPassword({ email, password });
        say(error ? T.badLogin : "");
      }
    });

    el("ml-auth-signout")?.addEventListener("click", async () => {
      if (sb) await sb.auth.signOut();
    });

    /* ---------- Partida ---------- */

    let returning = /[?&](code|error)=/.test(location.search);
    try {
      returning = returning || sessionStorage.getItem(RETURN_FLAG) === "1";
    } catch {}

    if (returning || !("IntersectionObserver" in window)) {
      boot();
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            boot();
          }
        },
        { rootMargin: "800px" },
      );
      io.observe(root);
    }
  }
</script>
