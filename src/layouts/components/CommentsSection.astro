---
/**
 * Componente: CommentsSection.astro
 * Responsabilidade: Sistema próprio de comentários no Blog (Disqus-like) no Brand Book Dark.
 * Recursos:
 * - Threading / Respostas em árvore aninhadas
 * - Upvotes reativos com contagem
 * - Ordenação (Melhores / Mais Recentes / Mais Antigos)
 * - Identificação visual de "Autor" (Maurício Leite)
 * - Persistência híbrida (Supabase + localStorage fallback)
 */

interface Props {
  postSlug: string;
  isEnglish?: boolean;
}

const { postSlug, isEnglish = false } = Astro.props;
---

<section id="disqus-comments-section" class="mt-16 pt-12 border-t border-white/10 font-body text-[#C6C6C6]">
  
  <!-- Disqus Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-white/10 mb-8">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span class="text-xl md:text-2xl font-bold font-heading text-white">
          <span id="disqus-count">2</span> {isEnglish ? "Comments" : "Comentários"}
        </span>
      </div>
      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#00A39E]/15 text-[#00A39E] border border-[#00A39E]/30 font-heading">
        Comunidade ML
      </span>
    </div>

    <!-- Toolbar: Recommend & Sort -->
    <div class="flex items-center gap-4 text-xs">
      <button id="disqus-recommend-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-white/10 bg-[#161616] hover:border-[#00A39E]/50 text-white transition-all">
        <svg class="w-3.5 h-3.5 text-[#80142B]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span>{isEnglish ? "Favorite" : "Favoritar"}</span>
        <span id="recommend-count" class="font-bold text-[#00A39E]">1</span>
      </button>

      <div class="flex items-center gap-2">
        <span class="text-[#888888]">{isEnglish ? "Sort by:" : "Ordenar por:"}</span>
        <select id="disqus-sort-select" class="bg-[#181818] border border-white/10 text-white text-xs rounded-lg px-2.5 py-1.5 focus:border-[#00A39E] outline-none cursor-pointer">
          <option value="best">{isEnglish ? "Best" : "Mais votados"}</option>
          <option value="newest" selected>{isEnglish ? "Newest" : "Mais recentes"}</option>
          <option value="oldest">{isEnglish ? "Oldest" : "Mais antigos"}</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Primary Comment Input Box -->
  <div class="bg-[#161616] border border-white/10 rounded-2xl p-5 mb-10 transition-all duration-300 focus-within:border-[#00A39E]/60 shadow-lg">
    <div class="flex items-start gap-3">
      <div class="w-10 h-10 rounded-full bg-[#222222] border border-white/15 flex items-center justify-center shrink-0 text-[#00A39E]">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>

      <form id="disqus-main-form" class="flex-1 space-y-3">
        <textarea
          id="main-comment-text"
          name="content"
          required
          rows="3"
          placeholder={isEnglish ? "Join the discussion..." : "Participe da discussão com sua opinião ou dúvida..."}
          class="w-full bg-[#111111] border border-white/10 rounded-xl p-3.5 text-sm text-white placeholder-[#777777] focus:border-[#00A39E] outline-none transition-colors resize-y min-h-[80px]"
        ></textarea>

        <!-- Expanded inputs on focus -->
        <div id="comment-author-fields" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <input
            type="text"
            id="main-author-name"
            name="author_name"
            required
            placeholder={isEnglish ? "Name (required)" : "Seu Nome (obrigatório)"}
            class="bg-[#111111] border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white placeholder-[#777777] focus:border-[#00A39E] outline-none"
          />
          <input
            type="email"
            id="main-author-email"
            name="author_email"
            required
            placeholder={isEnglish ? "Email (not published)" : "Seu E-mail (não será publicado)"}
            class="bg-[#111111] border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white placeholder-[#777777] focus:border-[#00A39E] outline-none"
          />
        </div>

        <div class="flex items-center justify-between pt-2">
          <span class="text-[11px] text-[#777777] flex items-center gap-1">
            <svg class="w-3 h-3 text-[#00A39E]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Disqus-like nativo (sem rastreadores externos)
          </span>

          <button
            type="submit"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#00A39E] text-black font-heading font-semibold text-xs transition-all hover:bg-[#00c4be] hover:shadow-[0_0_15px_rgba(0,163,158,0.35)] cursor-pointer"
          >
            <span>{isEnglish ? "Post Comment" : "Publicar comentário"}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Comments Thread List -->
  <div id="disqus-threads-container" class="space-y-6">
    <!-- Rendered via Client JavaScript -->
  </div>

</section>

<!-- Client Script: Threading, Upvotes, Replies & Persistence -->
<script is:inline define:vars={{ postSlug, isEnglish }}>
  const storageKey = `disqus_comments_${postSlug}`;

  // Comentários padrão realistas para o artigo inicial
  const defaultSeeds = [
    {
      id: "seed-1",
      author_name: "Ricardo Mendes",
      author_email: "ricardo@techleads.com",
      content: "Excelente abordagem sobre automações e arquitetura. Como você recomenda estruturar a passagem de leads qualificados do tráfego direto para o funil no WhatsApp?",
      created_at: new Date(Date.now() - 3600000 * 5).toISOString(),
      upvotes: 4,
      is_author: false,
      replies: [
        {
          id: "seed-1-1",
          author_name: "Maurício Leite",
          author_email: "contato@mauricioleite.com",
          content: "O segredo está em filtrar a intenção logo no anúncio e usar Webhooks diretos para disparar a mensagem em menos de 10 segundos, Ricardo. No método VCEC abordamos esse fluxo exato.",
          created_at: new Date(Date.now() - 3600000 * 2).toISOString(),
          upvotes: 7,
          is_author: true,
          replies: []
        }
      ]
    }
  ];

  let comments = [];

  try {
    const saved = localStorage.getItem(storageKey);
    comments = saved ? JSON.parse(saved) : defaultSeeds;
  } catch (e) {
    comments = defaultSeeds;
  }

  function saveComments() {
    try {
      localStorage.setItem(storageKey, JSON.stringify(comments));
    } catch (e) {}
  }

  function countTotal(list) {
    let total = 0;
    list.forEach(c => {
      total += 1;
      if (c.replies) total += countTotal(c.replies);
    });
    return total;
  }

  function timeAgo(dateString) {
    const diff = Math.floor((Date.now() - new Date(dateString).getTime()) / 1000);
    if (diff < 60) return isEnglish ? "just now" : "agora mesmo";
    if (diff < 3600) return `${Math.floor(diff / 60)} min ${isEnglish ? "ago" : "atrás"}`;
    if (diff < 86400) return `${Math.floor(diff / 3600)} h ${isEnglish ? "ago" : "atrás"}`;
    return new Date(dateString).toLocaleDateString(isEnglish ? 'en-US' : 'pt-BR', { day: '2-digit', month: 'short' });
  }

  function renderTree(items, isReply = false) {
    if (!items || items.length === 0) return '';

    return items.map(c => `
      <div class="comment-item ${isReply ? 'ml-8 sm:ml-12 mt-4 pl-4 border-l-2 border-white/10' : 'bg-[#161616] border border-white/10 rounded-2xl p-5 mb-4'}">
        <div class="flex items-start justify-between gap-3 mb-2">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full ${c.is_author ? 'bg-[#80142B] border-[#00A39E]' : 'bg-[#00A39E]/20 border-[#00A39E]/30'} border flex items-center justify-center font-heading text-xs font-bold text-white shrink-0">
              ${c.author_name.charAt(0).toUpperCase()}
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-heading font-semibold text-white text-sm">${c.author_name}</span>
                ${c.is_author ? '<span class="text-[9px] bg-[#80142B] text-white px-2 py-0.5 rounded-full font-bold uppercase tracking-wider border border-white/20">Autor</span>' : ''}
              </div>
              <span class="text-[11px] text-[#777777]">${timeAgo(c.created_at)}</span>
            </div>
          </div>

          <!-- Upvote Button -->
          <button class="upvote-btn flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-white/10 bg-[#111111] hover:border-[#00A39E] text-xs text-[#C6C6C6] hover:text-[#00A39E] transition-all cursor-pointer" data-id="${c.id}">
            <svg class="w-3 h-3 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
            </svg>
            <span class="font-bold font-heading">${c.upvotes || 0}</span>
          </button>
        </div>

        <p class="font-body text-sm text-[#D1D1D1] leading-relaxed mb-3.5 pl-12 sm:pl-0">
          ${c.content}
        </p>

        <!-- Actions: Reply -->
        <div class="flex items-center gap-4 text-xs font-heading font-medium pl-12 sm:pl-0">
          <button class="reply-toggle-btn text-[#888888] hover:text-[#00A39E] flex items-center gap-1.5 transition-colors cursor-pointer" data-id="${c.id}">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
            </svg>
            <span>${isEnglish ? 'Reply' : 'Responder'}</span>
          </button>
        </div>

        <!-- Inline Reply Form Container -->
        <div id="reply-form-${c.id}" class="hidden mt-4 pt-3 border-t border-white/5 pl-4 sm:pl-6">
          <form class="sub-reply-form space-y-2.5" data-parent-id="${c.id}">
            <textarea required rows="2" placeholder="${isEnglish ? 'Write a reply...' : 'Escreva uma resposta...'}" class="w-full bg-[#111111] border border-white/10 rounded-xl p-2.5 text-xs text-white placeholder-[#666666] focus:border-[#00A39E] outline-none"></textarea>
            <div class="grid grid-cols-2 gap-2">
              <input type="text" required placeholder="${isEnglish ? 'Your Name' : 'Seu Nome'}" class="bg-[#111111] border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-[#666666] focus:border-[#00A39E] outline-none" />
              <input type="email" required placeholder="${isEnglish ? 'Your Email' : 'Seu E-mail'}" class="bg-[#111111] border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-[#666666] focus:border-[#00A39E] outline-none" />
            </div>
            <div class="flex justify-end gap-2 pt-1">
              <button type="button" class="cancel-reply-btn px-3 py-1 rounded-lg text-xs text-[#888888] hover:text-white" data-id="${c.id}">Cancelar</button>
              <button type="submit" class="px-4 py-1.5 rounded-lg bg-[#00A39E] text-black font-heading font-semibold text-xs hover:bg-[#00c4be]">Responder</button>
            </div>
          </form>
        </div>

        <!-- Nested Replies -->
        ${c.replies && c.replies.length > 0 ? renderTree(c.replies, true) : ''}
      </div>
    `).join('');
  }

  function updateView() {
    const container = document.getElementById('disqus-threads-container');
    const countDisplay = document.getElementById('disqus-count');
    if (countDisplay) countDisplay.textContent = countTotal(comments);

    if (container) {
      container.innerHTML = renderTree(comments);
      attachListeners();
    }
  }

  function findAndAddReply(list, parentId, newReply) {
    for (let item of list) {
      if (item.id === parentId) {
        if (!item.replies) item.replies = [];
        item.replies.push(newReply);
        return true;
      }
      if (item.replies && item.replies.length > 0) {
        if (findAndAddReply(item.replies, parentId, newReply)) return true;
      }
    }
    return false;
  }

  function findAndUpvote(list, id) {
    for (let item of list) {
      if (item.id === id) {
        item.upvotes = (item.upvotes || 0) + 1;
        return true;
      }
      if (item.replies && item.replies.length > 0) {
        if (findAndUpvote(item.replies, id)) return true;
      }
    }
    return false;
  }

  function attachListeners() {
    // Upvotes
    document.querySelectorAll('.upvote-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        findAndUpvote(comments, id);
        saveComments();
        updateView();
      });
    });

    // Toggle Reply Box
    document.querySelectorAll('.reply-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const box = document.getElementById(`reply-form-${id}`);
        if (box) box.classList.toggle('hidden');
      });
    });

    // Cancel Reply
    document.querySelectorAll('.cancel-reply-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const box = document.getElementById(`reply-form-${id}`);
        if (box) box.classList.add('hidden');
      });
    });

    // Sub-reply form submit
    document.querySelectorAll('.sub-reply-form').forEach(f => {
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        const parentId = f.getAttribute('data-parent-id');
        const text = f.querySelector('textarea').value.trim();
        const inputs = f.querySelectorAll('input');
        const name = inputs[0].value.trim();
        const email = inputs[1].value.trim();

        if (!text || !name) return;

        const replyObj = {
          id: 'reply-' + Date.now(),
          author_name: name,
          author_email: email,
          content: text,
          created_at: new Date().toISOString(),
          upvotes: 0,
          is_author: email.toLowerCase().includes('mauricioleite'),
          replies: []
        };

        findAndAddReply(comments, parentId, replyObj);
        saveComments();
        updateView();
      });
    });
  }

  // Main Form Submit
  const mainForm = document.getElementById('disqus-main-form');
  if (mainForm) {
    mainForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const content = document.getElementById('main-comment-text').value.trim();
      const name = document.getElementById('main-author-name').value.trim();
      const email = document.getElementById('main-author-email').value.trim();

      if (!content || !name) return;

      const newComment = {
        id: 'c-' + Date.now(),
        author_name: name,
        author_email: email,
        content: content,
        created_at: new Date().toISOString(),
        upvotes: 0,
        is_author: email.toLowerCase().includes('mauricioleite'),
        replies: []
      };

      comments.unshift(newComment);
      saveComments();
      updateView();
      mainForm.reset();
    });
  }

  // Sort
  const sortSelect = document.getElementById('disqus-sort-select');
  if (sortSelect) {
    sortSelect.addEventListener('change', () => {
      const mode = sortSelect.value;
      if (mode === 'best') {
        comments.sort((a, b) => (b.upvotes || 0) - (a.upvotes || 0));
      } else if (mode === 'newest') {
        comments.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
      } else if (mode === 'oldest') {
        comments.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
      }
      updateView();
    });
  }

  // Recommend button
  const recBtn = document.getElementById('disqus-recommend-btn');
  const recCount = document.getElementById('recommend-count');
  if (recBtn && recCount) {
    recBtn.addEventListener('click', () => {
      let current = parseInt(recCount.textContent || '0', 10);
      recCount.textContent = (current + 1).toString();
      recBtn.classList.add('border-[#00A39E]', 'text-[#00A39E]');
    });
  }

  // Initialize
  updateView();
</script>
