---
/**
 * Componente: Experience.astro
 * Responsabilidade: Espaço reservado para o futuro diagrama interativo construído em Spline.
 * Diretrizes do Brand Book: Fundo Preto Pista (#111111), bordas em Prata (#C6C6C6/20), acento em Petronas (#00A39E).
 */

interface Props {
  title?: string;
}

const { title = "Minha experiência" } = Astro.props;
---

<section id="experiencia" class="py-16 md:py-24 bg-[#111111] text-white border-t border-white/5">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-12">
      <span class="text-xs uppercase tracking-widest text-[#00A39E] font-semibold font-['Sora',sans-serif]">
        METODOLOGIA & TRACÃO
      </span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2 font-['Sora',sans-serif] text-white">
        {title}
      </h2>
      <p class="mt-4 text-base md:text-lg text-[#C6C6C6] max-w-2xl mx-auto font-['Instrument_Sans',sans-serif]">
        Comprometimento. Velocidade. Clareza. O caminho do clique até a venda com números reais.
      </p>
    </div>

    <!-- Container do Diagrama (Preparado para Spline) -->
    <div class="w-full mx-auto max-w-5xl">
      <div class="relative w-full h-[400px] sm:h-[480px] md:h-[550px] rounded-2xl border border-[#C6C6C6]/20 bg-[#17171a] flex flex-col items-center justify-center p-8 text-center shadow-xl overflow-hidden group">
        <div class="absolute inset-0 bg-gradient-to-b from-[#00A39E]/5 to-transparent pointer-events-none"></div>
        <div class="w-16 h-16 rounded-2xl bg-[#242528] border border-[#C6C6C6]/20 flex items-center justify-center mb-6 text-[#00A39E] shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
        </div>
        <h3 class="text-xl md:text-2xl font-bold font-['Sora',sans-serif] text-white mb-2">
          Diagrama Interativo de Operações & Tração
        </h3>
        <p class="text-sm md:text-base text-[#C6C6C6] max-w-md font-['Instrument_Sans',sans-serif]">
          Ambiente 3D em desenvolvimento no Spline para demonstrar o ecossistema de geração de demanda, funis e conversão.
        </p>
      </div>
    </div>
  </div>
</section>
