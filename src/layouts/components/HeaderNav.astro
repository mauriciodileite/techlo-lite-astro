---
/**
 * Componente: HeaderNav.astro
 * Responsabilidade: Cabeçalho oficial com o símbolo SVG do Brand Book, tipografia Sora, links dos 4 públicos e seletor PT/EN funcional.
 */

interface Props {
  currentLocale?: string;
  hideLanguageSwitcher?: boolean;
}

const { currentLocale = "pt", hideLanguageSwitcher = false } = Astro.props;

// Se a rota contiver '/en', o idioma atual é inglês
const isEnglish = currentLocale === "en" || Astro.url.pathname.startsWith("/en");

const currentPath = Astro.url.pathname;
const pathnameClean = currentPath.replace(/\/$/, "");

// Páginas sem versão traduzida para inglês:
// Todo o ecossistema do blog (/blog, /blog/*, /pt/blog/*) não possui posts em inglês.
const isBlogPage =
  pathnameClean === "/blog" ||
  pathnameClean.startsWith("/blog/") ||
  pathnameClean === "/pt/blog" ||
  pathnameClean.startsWith("/pt/blog/") ||
  pathnameClean === "/en/blog" ||
  pathnameClean.startsWith("/en/blog/");

const isUntranslated = isBlogPage || pathnameClean.includes("agente-de-ia-para-whatsapp");

const showLanguageSwitcher = !hideLanguageSwitcher && !isUntranslated;

let ptPath = "/";
let enPath = "/en/";

if (isEnglish) {
  const stripped = currentPath.replace(/^\/en/, "") || "/";
  if (stripped.startsWith("/privacy-policy")) {
    ptPath = "/politica-de-privacidade/";
  } else if (stripped.startsWith("/terms-conditions")) {
    ptPath = "/termos-de-uso/";
  } else {
    ptPath = stripped.endsWith("/") ? stripped : `${stripped}/`;
  }
  enPath = currentPath.endsWith("/") ? currentPath : `${currentPath}/`;
} else {
  ptPath = currentPath.endsWith("/") ? currentPath : `${currentPath}/`;
  if (currentPath.startsWith("/politica-de-privacidade")) {
    enPath = "/en/privacy-policy/";
  } else if (currentPath.startsWith("/termos-de-uso")) {
    enPath = "/en/terms-conditions/";
  } else if (currentPath === "/" || currentPath === "") {
    enPath = "/en/";
  } else {
    enPath = `/en${currentPath.endsWith("/") ? currentPath : `${currentPath}/`}`;
  }
}

// Fallback seguro adicional: se por qualquer motivo enPath for sub-rota de blog, aponta para /blog/
if (enPath.includes("/blog/")) {
  enPath = "/blog/";
}

const navItems = [
  { 
    name: isEnglish ? "For companies in Brazil" : "Para empresas no Brasil", 
    href: isEnglish ? "/en/agenda" : "/agenda" 
  },
  { 
    name: isEnglish ? "For companies abroad" : "Para empresas no exterior", 
    href: isEnglish ? "/en/empresas-exterior" : "/empresas-exterior" 
  },
  { 
    name: isEnglish ? "For entrepreneurs" : "Para empreendedores", 
    href: isEnglish ? "/en/empreendedores" : "/empreendedores" 
  },
  { 
    name: isEnglish ? "For experts" : "Para expertos", 
    href: isEnglish ? "/en/expertos" : "/expertos" 
  },
  { 
    name: "Blog", 
    href: isEnglish ? "/en/blog" : "/blog" 
  },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#111111]/95 backdrop-blur-md border-b border-white/10 transition-all">
  <div class="container mx-auto px-4 max-w-7xl h-20 flex items-center justify-between">
    
    <!-- Logo Oficial: Símbolo do Brand Book + Nome em Sora ExtraBold -->
    <a href={isEnglish ? "/en/" : "/"} class="flex items-center gap-3.5 group">
      <img
        src="/images/simbolo-mauricio-leite.svg"
        alt="Símbolo Maurício Leite"
        class="h-10 w-auto object-contain transition-transform group-hover:scale-105"
      />
      <span class="text-xl md:text-2xl font-extrabold tracking-tight font-['Sora',sans-serif] text-white">
        MAURÍCIO LEITE
      </span>
    </a>

    <!-- Menu Central (Desktop) -->
    <nav class="hidden xl:flex items-center gap-7">
      {navItems.map((item) => {
        const hasSubmenu = !isEnglish && item.href === "/agenda";
        if (!hasSubmenu) {
          return (
            <a
              href={item.href}
              class="text-sm font-medium text-[#C6C6C6] hover:text-[#00A39E] transition-colors font-['Instrument_Sans',sans-serif]"
            >
              {item.name}
            </a>
          );
        }
        return (
          <div class="relative group">
            <div class="flex items-center gap-1.5">
              <a
                href={item.href}
                class="text-sm font-medium text-[#C6C6C6] hover:text-[#00A39E] transition-colors font-['Instrument_Sans',sans-serif]"
              >
                {item.name}
              </a>
              <button
                type="button"
                aria-label="Submenu de Empresas no Brasil"
                aria-haspopup="true"
                class="text-[#C6C6C6] hover:text-[#00A39E] focus:outline-none transition-transform group-hover:rotate-180"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
            <!-- Submenu Dropdown (Desktop) -->
            <div class="absolute left-0 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-64 rounded-xl bg-[#162026] border border-white/10 shadow-2xl p-2.5 backdrop-blur-md">
                <a
                  href="/agente-de-ia-para-whatsapp/"
                  class="flex flex-col gap-0.5 p-2.5 rounded-lg hover:bg-white/5 transition-colors group/sub"
                >
                  <span class="text-xs font-bold font-['Sora',sans-serif] text-white group-hover/sub:text-[#00A39E] transition-colors flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
                    Agente de IA para WhatsApp
                  </span>
                  <span class="text-[11px] text-[#A0A0A0] font-['Instrument_Sans',sans-serif]">
                    Atendimento e vendas 24h com IA
                  </span>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </nav>

    <!-- Seletor de Idioma (PT | EN) e Alternador de Tema -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Botão Modo Claro / Escuro Global -->
      <button
        id="global-theme-toggle-btn"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg border border-[#C6C6C6]/30 bg-[#1A1A1A] px-2.5 py-1.5 text-xs font-mono text-[#C6C6C6] transition-all hover:border-[#00A39E] hover:text-white"
        title={isEnglish ? "Toggle Light / Dark Mode" : "Alternar Modo Claro / Escuro"}
        aria-label={isEnglish ? "Toggle Light / Dark Mode" : "Alternar Modo Claro / Escuro"}
      >
        <!-- Ícone Sol -->
        <svg
          id="global-sun-icon"
          class="h-3.5 w-3.5 text-[#00A39E] transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          />
        </svg>

        <!-- Ícone Lua -->
        <svg
          id="global-moon-icon"
          class="hidden h-3.5 w-3.5 text-[#00A39E] transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          />
        </svg>

        <span id="global-theme-text" class="hidden sm:inline font-mono text-[11px]">
          {isEnglish ? "Light" : "Modo Claro"}
        </span>
      </button>

      {showLanguageSwitcher && (
        <div class="inline-flex items-center bg-[#1A1A1A] border border-[#C6C6C6]/30 rounded-lg p-1 text-xs font-mono">
          <a
            href={ptPath}
            class={`px-2.5 sm:px-3 py-1.5 rounded transition-colors ${
              !isEnglish ? "bg-[#00A39E] text-[#111111] font-bold" : "text-[#C6C6C6] hover:text-white"
            }`}
            aria-label="Versão em Português"
          >
            PT
          </a>
          <a
            href={enPath}
            class={`px-2.5 sm:px-3 py-1.5 rounded transition-colors ${
              isEnglish ? "bg-[#00A39E] text-[#111111] font-bold" : "text-[#C6C6C6] hover:text-white"
            }`}
            aria-label="English Version"
          >
            EN
          </a>
        </div>
      )}


      <!-- Botão Menu Mobile -->
      <button
        id="mobile-menu-btn"
        aria-label="Alternar menu"
        class="xl:hidden p-2 rounded-lg bg-[#1A1A1A] border border-white/10 text-[#C6C6C6] hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>

  <!-- Gaveta Mobile -->
  <div id="mobile-menu" class="hidden xl:hidden bg-[#1A1A1A] border-b border-white/10 px-6 py-6 space-y-2">
    {navItems.map((item) => {
      const hasSubmenu = !isEnglish && item.href === "/agenda";
      if (!hasSubmenu) {
        return (
          <a
            href={item.href}
            class="block text-base font-medium text-[#C6C6C6] hover:text-[#00A39E] py-2.5 border-b border-white/5 font-['Instrument_Sans',sans-serif]"
          >
            {item.name}
          </a>
        );
      }
      return (
        <div class="border-b border-white/5 py-1">
          <div class="flex items-center justify-between">
            <a
              href={item.href}
              class="block text-base font-medium text-[#C6C6C6] hover:text-[#00A39E] py-2 font-['Instrument_Sans',sans-serif]"
            >
              {item.name}
            </a>
            <button
              id="mobile-submenu-btn"
              type="button"
              aria-expanded="false"
              aria-controls="mobile-submenu-brasil"
              aria-label="Alternar submenu Empresas no Brasil"
              class="p-2 text-[#C6C6C6] hover:text-[#00A39E] transition-transform"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200" id="mobile-submenu-icon">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
          </div>
          <div id="mobile-submenu-brasil" class="hidden pl-3 pb-2 space-y-1">
            <a
              href="/agente-de-ia-para-whatsapp/"
              class="block py-2 text-sm text-[#00A39E] font-['Instrument_Sans',sans-serif] hover:underline flex items-center gap-2"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
              Agente de IA para WhatsApp
            </a>
          </div>
        </div>
      );
    })}

    <!-- Alternador de Tema no Menu Mobile -->
    <div class="pt-4 mt-3 border-t border-white/10 flex items-center justify-between">
      <span class="text-sm font-['Instrument_Sans',sans-serif] text-[#C6C6C6]" id="mobile-theme-label">
        {isEnglish ? "Theme" : "Modo de visualização"}
      </span>
      <button
        id="mobile-drawer-theme-btn"
        type="button"
        class="inline-flex items-center gap-2 rounded-lg border border-[#C6C6C6]/30 bg-[#222222] px-3 py-2 text-xs font-mono text-[#C6C6C6] transition-colors hover:text-white"
        aria-label="Alternar modo claro e escuro"
      >
        <span id="mobile-drawer-theme-text">{isEnglish ? "Light Mode" : "Modo Claro"}</span>
      </button>
    </div>
  </div>
</header>

<script>
  function setupHeaderNav() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (btn && menu && !btn.dataset.bound) {
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        menu.classList.toggle("hidden");
      });
    }

    const subBtn = document.getElementById("mobile-submenu-btn");
    const subMenu = document.getElementById("mobile-submenu-brasil");
    const subIcon = document.getElementById("mobile-submenu-icon");
    if (subBtn && subMenu && !subBtn.dataset.bound) {
      subBtn.dataset.bound = "true";
      subBtn.addEventListener("click", () => {
        const isHidden = subMenu.classList.toggle("hidden");
        subBtn.setAttribute("aria-expanded", String(!isHidden));
        if (subIcon) {
          subIcon.style.transform = isHidden ? "rotate(0deg)" : "rotate(180deg)";
        }
      });
    }

    // Gerenciador Global do Modo Claro / Escuro
    const themeBtn = document.getElementById("global-theme-toggle-btn");
    const sunIcon = document.getElementById("global-sun-icon");
    const moonIcon = document.getElementById("global-moon-icon");
    const themeText = document.getElementById("global-theme-text");
    const drawerThemeBtn = document.getElementById("mobile-drawer-theme-btn");
    const drawerThemeText = document.getElementById("mobile-drawer-theme-text");

    function updateThemeUI(isLight: boolean) {
      if (isLight) {
        document.documentElement.classList.add("light-theme");
        if (sunIcon) sunIcon.classList.add("hidden");
        if (moonIcon) moonIcon.classList.remove("hidden");
        if (themeText) themeText.textContent = "Modo Escuro";
        if (drawerThemeText) drawerThemeText.textContent = "☀️ Modo Escuro";
      } else {
        document.documentElement.classList.remove("light-theme");
        if (sunIcon) sunIcon.classList.remove("hidden");
        if (moonIcon) moonIcon.classList.add("hidden");
        if (themeText) themeText.textContent = "Modo Claro";
        if (drawerThemeText) drawerThemeText.textContent = "🌙 Modo Claro";
      }
    }

    const isLightNow = document.documentElement.classList.contains("light-theme");
    updateThemeUI(isLightNow);

    function toggleTheme() {
      const willBeLight = !document.documentElement.classList.contains("light-theme");
      updateThemeUI(willBeLight);
      const nextMode = willBeLight ? "light" : "dark";
      localStorage.setItem("mauricio_theme_mode", nextMode);
      localStorage.setItem("mauricio_blog_reading_theme", nextMode);
      window.dispatchEvent(new CustomEvent("mauricio-theme-changed", { detail: { theme: nextMode } }));
    }

    if (themeBtn && !themeBtn.dataset.bound) {
      themeBtn.dataset.bound = "true";
      themeBtn.addEventListener("click", toggleTheme);
    }

    if (drawerThemeBtn && !drawerThemeBtn.dataset.bound) {
      drawerThemeBtn.dataset.bound = "true";
      drawerThemeBtn.addEventListener("click", toggleTheme);
    }

    window.addEventListener("mauricio-theme-changed", (e: any) => {
      if (e.detail && e.detail.theme) {
        updateThemeUI(e.detail.theme === "light");
      }
    });
  }

  setupHeaderNav();
  document.addEventListener("astro:page-load", setupHeaderNav);
</script>
