---
/**
 * Componente: CalendlyEmbed.astro
 * Responsabilidade: Embed leve, responsivo e seguro do Calendly com fallback.
 * Estilo: Dark (#111111), bordas em Prata (#C6C6C6/15) e botão de fallback Petronas (#00A39E).
 */

interface Props {
  url?: string;
  minWidth?: string;
  height?: string;
  title?: string;
  description?: string;
}

const {
  url = "https://calendly.com/mauricioleitecontato",
  minWidth = "320px",
  height = "950px",
  title = "Agende uma Reunião Estratégica",
  description = "Escolha o melhor dia e horário na agenda abaixo para conversarmos diretamente sobre o seu negócio."
} = Astro.props;
---

<section id="agendamento" class="relative py-16 bg-[#111111] text-white">
  <div class="container mx-auto px-4 max-w-4xl relative z-10">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-[#C6C6C6] font-['Sora',sans-serif] font-semibold">
          Agenda Oficial
        </span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold font-['Sora',sans-serif] text-white mb-3">
        {title}
      </h2>
      <p class="text-[#C6C6C6] font-['Instrument_Sans',sans-serif] text-base md:text-lg max-w-xl mx-auto">
        {description}
      </p>
    </div>

    <!-- Container do Calendly sem scrollbar interna -->
    <div class="relative bg-[#161616] border border-white/10 rounded-2xl p-2 md:p-4 shadow-2xl overflow-hidden flex flex-col justify-center items-center">
      <!-- Fallback noscript / link caso o script ou iframe seja bloqueado -->
      <noscript>
        <div class="p-8 text-center">
          <p class="text-neutral-300 mb-4 font-['Instrument_Sans',sans-serif]">Para agendar seu horário diretamente no Calendly:</p>
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#00A39E] text-black font-['Sora',sans-serif] font-semibold hover:bg-[#008f8a] transition-colors"
          >
            Abrir Agenda Externa
          </a>
        </div>
      </noscript>

      <!-- Calendly inline widget fixo sem scroll -->
      <div
        class="calendly-inline-widget w-full rounded-xl overflow-hidden"
        data-url={`${url}?hide_landing_page_details=1&hide_gdpr_banner=1&background_color=161616&text_color=ffffff&primary_color=00a39e`}
        style={`min-width:${minWidth};height:${height};overflow:hidden;`}
      ></div>

      <!-- Fallback link visual se demorar a carregar -->
      <div class="py-4 text-center">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-[#C6C6C6]/60 hover:text-[#00A39E] underline transition-colors font-['Instrument_Sans',sans-serif]"
        >
          Problemas com o carregamento da agenda? Clique aqui para abrir em uma nova aba.
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Script oficial assíncrono do Calendly -->
<script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
