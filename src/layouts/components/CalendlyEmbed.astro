---
/**
 * Componente legado: CalendlyEmbed.astro
 * Agora redirecionado para CalEmbed.astro com modal elegante do Cal.com.
 */
import CalEmbed from "./CalEmbed.astro";

interface Props {
  url?: string;
  minWidth?: string;
  height?: string;
  title?: string;
  description?: string;
  isEnglish?: boolean;
}

const {
  title,
  description,
  isEnglish = false,
} = Astro.props;
---

<CalEmbed
  title={title}
  description={description}
  isEnglish={isEnglish}
/>

