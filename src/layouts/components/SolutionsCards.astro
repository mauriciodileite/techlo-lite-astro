---
/**
 * Componente: SolutionsCards.astro
 * Responsabilidade: Exibir 4 cards correspondentes aos 4 perfis/públicos da navegação superior.
 * 
 * Botões de Ação:
 * - Card 1 (Empresas no Brasil) -> "Falar com a agência"
 * - Card 2 (Empresas no exterior) -> "Falar com a agência"
 * - Card 3 (Empreendedores) -> "Conhecer"
 * - Card 4 (Experts) -> "Conhecer"
 * 
 * Diretrizes do Brand Book: Fundo Preto Pista (#111111), bordas em Prata (#C6C6C6/15),
 * acento em Petronas (#00A39E), tipografia Sora e Instrument Sans.
 */

interface Props {
  title?: string;
  subtitle?: string;
  isEnglish?: boolean;
}

const {
  title = "Minhas soluções",
  subtitle = "Escolha o seu perfil e descubra o caminho mais direto para acelerar vendas e lucro.",
  isEnglish = false,
} = Astro.props;

const cards = isEnglish
  ? [
      {
        id: "01",
        badge: "Companies in Brazil",
        title: "For Companies in Brazil",
        desc: "Full-service direct response marketing through aiSIM Agency. Acquisition structures, paid media management, and CAC control for businesses looking to delegate growth.",
        href: "/en/empresas-brasil",
        ctaText: "Talk to the agency",
        isAgency: true,
      },
      {
        id: "02",
        badge: "International Expansion",
        title: "For Companies Abroad",
        desc: "Cross-border customer acquisition campaigns and sales funnels designed to scale revenue in strong currency (USD/EUR) with predictable metrics.",
        href: "/en/empresas-exterior",
        ctaText: "Talk to the agency",
        isAgency: true,
      },
      {
        id: "03",
        badge: "Training & Systems",
        title: "For Entrepreneurs",
        desc: "Hands-on implementation and training in AI automations, sales pipelines, and n8n workflows for leaders who want internal operational leverage.",
        href: "/en/empreendedores",
        ctaText: "Discover",
        isAgency: false,
      },
      {
        id: "04",
        badge: "Perpetual Low-Ticket",
        title: "For Experts & Creators",
        desc: "End-to-end architecture of automated perpetual low-ticket funnels for digital and physical products to liquidate traffic costs and acquire buyers daily.",
        href: "/en/expertos",
        ctaText: "Discover",
        isAgency: false,
      },
    ]
  : [
      {
        id: "01",
        badge: "Empresas no Brasil",
        title: "Para empresas no Brasil",
        desc: "Marketing direto e geração contínua de demanda através da agência aiSIM. Estruturas completas de tráfego, vendas e controle de CAC para quem prefere delegar a operação.",
        href: "/empresas-brasil",
        ctaText: "Falar com a agência",
        isAgency: true,
      },
      {
        id: "02",
        badge: "Expansão Internacional",
        title: "Para empresas no exterior",
        desc: "Estratégia de aquisição e escala de vendas para negócios fora do país ou exportadores, tracionando receitas em moeda forte (Dólar/Euro) com previsibilidade de retorno.",
        href: "/empresas-exterior",
        ctaText: "Falar com a agência",
        isAgency: true,
      },
      {
        id: "03",
        badge: "Formação & Processos",
        title: "Para empreendedores",
        desc: "Formação prática e mentoria em automações com inteligência artificial, ferramentas ágeis e arquitetura de vendas para donos de negócio que querem eficiência interna.",
        href: "/empreendedores",
        ctaText: "Conhecer",
        isAgency: false,
      },
      {
        id: "04",
        badge: "Funil Perpétuo",
        title: "Para experts & especialistas",
        desc: "Construção de funis de entrada (low-ticket perpétuo) para infoprodutos e produtos físicos. Liquidação imediata do custo de anúncio e aquisição contínua de novos clientes.",
        href: "/expertos",
        ctaText: "Conhecer",
        isAgency: false,
      },
    ];
---

<section id="solucoes" class="py-16 md:py-24 bg-[#111111] text-white border-t border-white/5">
  <div class="container mx-auto px-4 max-w-6xl">
    
    <!-- Cabeçalho da Seção -->
    <div class="text-center mb-16">
      <span class="text-xs uppercase tracking-widest text-[#00A39E] font-semibold font-['Sora',sans-serif]">
        {isEnglish ? "TARGETED SOLUTIONS" : "SOLUÇÕES POR PERFIL"}
      </span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2 font-['Sora',sans-serif] text-white">
        {title}
      </h2>
      <p class="mt-4 text-base md:text-lg text-[#C6C6C6] max-w-2xl mx-auto font-['Instrument_Sans',sans-serif]">
        {subtitle}
      </p>
    </div>

    <!-- Grid de 4 Cards de Perfis -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {cards.map((card) => (
        <div class="group relative rounded-2xl border border-[#C6C6C6]/15 bg-[#17171a] p-8 sm:p-9 transition-all duration-300 hover:border-[#00A39E]/50 hover:bg-[#1a1a1f] hover:shadow-2xl hover:shadow-[#00A39E]/10 flex flex-col justify-between">
          
          <!-- Gradiente de Fundo sutil no Hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-[#00A39E]/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl pointer-events-none"></div>

          <div>
            <!-- Topo do Card: Número e Badge do Perfil -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-['Sora',sans-serif] font-bold text-[#00A39E] bg-[#00A39E]/10 border border-[#00A39E]/30 px-3.5 py-1 rounded-full uppercase">
                {card.badge}
              </span>
              <span class="text-xs font-mono text-[#9A9A9A]">
                #{card.id}
              </span>
            </div>

            <!-- Título da Solução -->
            <h3 class="text-xl sm:text-2xl font-bold font-['Sora',sans-serif] text-white mb-3 group-hover:text-[#00A39E] transition-colors">
              {card.title}
            </h3>

            <!-- Descrição Direta -->
            <p class="text-sm sm:text-base text-[#C6C6C6] leading-relaxed font-['Instrument_Sans',sans-serif]">
              {card.desc}
            </p>
          </div>

          <!-- Rodapé do Card: Botão de Ação -->
          <div class="mt-8 pt-6 border-t border-white/5">
            <a
              href={card.href}
              class={`w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold font-['Sora',sans-serif] text-sm transition-all duration-200 ${
                card.isAgency
                  ? "bg-[#00A39E] text-[#111111] hover:bg-[#008f8b] shadow-[0_0_20px_rgba(0,163,158,0.25)] hover:scale-[1.01]"
                  : "bg-[#242528] text-white border border-white/10 hover:border-[#00A39E] hover:text-[#00A39E] hover:scale-[1.01]"
              }`}
            >
              <span>{card.ctaText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
