---
import type { BlogPostItem } from './BlogHero.astro';

interface Props {
  posts: BlogPostItem[];
}

const { posts = [] } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="border-t border-white/5 bg-[#111111] py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="flex items-center justify-between">
          <div>
            <span class="font-heading text-xs font-semibold tracking-wider text-[#00A39E] uppercase">
              Continue Lendo
            </span>
            <h2 class="mt-1 font-heading text-2xl font-bold text-white sm:text-3xl">
              Artigos Relacionados
            </h2>
          </div>
          <a
            href="/blog"
            class="hidden sm:inline-flex items-center gap-1 font-heading text-xs font-semibold text-[#00A39E] hover:underline"
          >
            Ver todos os artigos
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-[#161616] p-4 transition-all duration-300 hover:border-[#00A39E]/50 hover:shadow-[0_0_25px_rgba(0,163,158,0.12)]">
              <div class="space-y-4">
                <a href={`/blog/${post.slug}`} class="block h-48 w-full overflow-hidden rounded-xl bg-[#222]">
                  <img
                    src={post.imageUrl || '/images/blog-post/post-1.webp'}
                    alt={post.imageAlt || post.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </a>

                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-1.5 text-xs text-[#999999]">
                    <svg class="h-3.5 w-3.5 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>{post.pubDate || 'Recente'}</span>
                  </div>
                  {post.category && (
                    <span class="rounded-full border border-[#00A39E]/30 bg-[#00A39E]/10 px-2.5 py-0.5 font-heading text-[11px] font-medium text-[#00A39E]">
                      {post.category}
                    </span>
                  )}
                </div>

                <a href={`/blog/${post.slug}`} class="block">
                  <h3 class="font-heading text-base font-semibold text-white transition-colors duration-200 group-hover:text-[#00A39E] line-clamp-2">
                    {post.title}
                  </h3>
                </a>

                <p class="font-body text-xs text-[#C6C6C6] line-clamp-2 leading-relaxed">
                  {post.description}
                </p>
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-white/5 pt-3">
                <span class="font-body text-xs text-[#888888]">{post.author || 'Maurício Leite'}</span>
                <a
                  href={`/blog/${post.slug}`}
                  aria-label={`Ler artigo ${post.title}`}
                  class="flex h-8 w-8 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition-all duration-300 group-hover:border-[#00A39E] group-hover:bg-[#00A39E] group-hover:text-black"
                >
                  <svg class="h-4 w-4 -rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
