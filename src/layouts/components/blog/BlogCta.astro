---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Receba estratégias práticas sobre automações, tráfego e escala no seu e-mail.",
  description = "Junte-se a empreendedores e especialistas que recebem nossos insights para acelerar negócios, automatizar processos e construir ecossistemas de alta conversão.",
} = Astro.props;
---

<section class="blog-newsletter-section relative bg-[#111111] py-16 sm:py-20 border-t border-white/5" id="newsletter">
  <div class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="blog-newsletter-card overflow-hidden rounded-2xl border border-white/10 bg-[#161616] p-6 sm:p-8 shadow-2xl relative">
      <!-- Glow ambient background -->
      <div class="newsletter-ambient-glow pointer-events-none absolute -bottom-20 -right-20 h-64 w-64 rounded-full bg-[#00A39E]/10 blur-[90px]"></div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 items-center">
        <!-- Left Column - Image with Brand Dual Glow (Petronas bottom-left, Vinho top-right) -->
        <div class="lg:col-span-5 relative group my-1">
          <!-- Borda com brilho duplo idêntica à referência: Vinho no topo-direito e Petronas na base-esquerda -->
          <div class="newsletter-image-glow pointer-events-none absolute -inset-1.5 rounded-2xl bg-gradient-to-tr from-[#00A39E]/70 via-transparent to-[#80142B]/80 blur-md opacity-85 transition-opacity"></div>
          
          <div class="newsletter-image-frame relative h-72 sm:h-80 lg:h-96 min-h-[280px] overflow-hidden rounded-2xl border border-white/15 bg-[#111111] shadow-xl">
            <img
              src="/images/capa.jpeg"
              alt="Maurício Leite"
              class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <!-- Overlay inferior oficial conforme imagem de referência -->
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent p-4 pt-10">
              <span class="block font-heading text-sm sm:text-base font-bold text-white tracking-tight">Maurício Leite</span>
              <span class="block font-body text-[10px] sm:text-[11px] font-semibold text-[#00A39E] tracking-wider uppercase mt-0.5">Comprometimento · Velocidade · Clareza</span>
            </div>
          </div>
        </div>

        <!-- Right Column - Content -->
        <div class="lg:col-span-7 flex h-full flex-col justify-center gap-4 lg:pl-4">
          <div class="newsletter-badge inline-flex w-fit items-center gap-2 rounded-full border border-[#00A39E]/30 bg-[#00A39E]/10 px-3 py-1 text-xs font-semibold text-[#00A39E]">
            Newsletter Semanal
          </div>

          <h2 class="newsletter-title font-heading text-xl font-bold leading-tight text-white sm:text-2xl">
            {title}
          </h2>

          <p class="newsletter-desc font-body text-sm text-[#C6C6C6] leading-relaxed">
            {description}
          </p>

          <!-- Email / Action Form (Brevo Native Integration) -->
          <form
            id="blog-cta-form"
            method="POST"
            action="https://c0c73b33.sibforms.com/serve/MUIFAN_lxGTLIrY9fW2OXPm9OJPAjHuWVn2gfmAQILOJE513ou5emp15RR9x_uBK9jPhjJ7LALdqxme9p9x5iSnn8snr8vLHaQXJNDDmPTfJ_dg5B4_G7B6I98X-B50xtelka1FYtlQvgSyS2F6OF7qMUQH3DkcrAlCpcJp9Xx71bo3rz7ENctNOlgVzu_VpbDFniaBohqlKvxYZ"
            class="mt-2 flex flex-col gap-3 sm:flex-row relative"
          >
            <!-- Hidden Brevo Config Fields -->
            <input type="hidden" name="FIRSTNAME" id="FIRSTNAME" value="" />
            <input type="text" name="email_address_check" value="" class="hidden" tabindex="-1" autocomplete="off" style="display:none;" />
            <input type="hidden" name="locale" value="pt" />
            <input type="hidden" name="html_type" value="simple" />
            <input type="hidden" name="OPT_IN" value="1" />

            <input
              type="email"
              id="EMAIL"
              name="EMAIL"
              placeholder="Digite seu melhor e-mail"
              required
              autocomplete="email"
              class="newsletter-input w-full rounded-xl border border-white/15 bg-[#1f1f1f] px-4 py-3 font-body text-sm text-white placeholder-[#777777] outline-none transition-all focus:border-[#00A39E]"
            />
            <button
              type="submit"
              id="blog-cta-submit-btn"
              class="shrink-0 rounded-xl bg-[#00A39E] px-6 py-3 font-heading text-sm font-semibold text-black transition-all hover:bg-[#00c4be] hover:shadow-[0_0_20px_rgba(0,163,158,0.4)] disabled:opacity-60 disabled:cursor-not-allowed cursor-pointer"
            >
              <span id="blog-cta-btn-text">Inscrever-se</span>
            </button>
          </form>

          <!-- Feedback de Sucesso com Brand Book Styling -->
          <div id="blog-cta-success" class="hidden rounded-xl border border-[#00A39E]/30 bg-[#00A39E]/10 p-4 text-sm text-white animate-fade-in">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-[#00A39E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="font-heading font-semibold text-[#00A39E]">Inscrição confirmada!</span>
            </div>
            <p class="mt-1 text-xs text-[#C6C6C6] font-body leading-relaxed">
              Enviamos um e-mail para você. Confira sua caixa de entrada para garantir o recebimento dos próximos insights.
            </p>
          </div>

          <!-- Feedback de Erro -->
          <div id="blog-cta-error" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-xs text-red-300">
            Ocorreu um erro ao processar sua inscrição. Por favor, tente novamente em instantes.
          </div>

          <p class="newsletter-disclaimer text-[11px] text-[#777777] font-body">
            100% livre de spam. Cancele quando quiser.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const ctaForm = document.getElementById('blog-cta-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('blog-cta-submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('blog-cta-btn-text');
  const successBox = document.getElementById('blog-cta-success');
  const errorBox = document.getElementById('blog-cta-error');

  if (ctaForm) {
    ctaForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !btnText) return;

      errorBox?.classList.add('hidden');
      const originalText = btnText.textContent;
      submitBtn.disabled = true;
      btnText.textContent = 'Inscrevendo...';

      try {
        const formData = new FormData(ctaForm);
        
        // Garante que o FIRSTNAME (obrigatório na Brevo) seja preenchido automaticamente com o primeiro nome do e-mail
        const emailVal = (formData.get('EMAIL') as string || '').trim();
        if (!formData.get('FIRSTNAME') && emailVal) {
          const rawName = emailVal.split('@')[0].split(/[._+-]/)[0];
          const formattedName = rawName ? rawName.charAt(0).toUpperCase() + rawName.slice(1) : 'Assinante';
          formData.set('FIRSTNAME', formattedName);
        }

        const response = await fetch(ctaForm.action, {
          method: 'POST',
          body: formData,
        });

        const data = await response.json().catch(() => null);

        if (response.ok && data?.success !== false) {
          ctaForm.classList.add('hidden');
          successBox?.classList.remove('hidden');
          ctaForm.reset();
        } else {
          if (errorBox) {
            if (data?.errors) {
              const firstErr = Object.values(data.errors)[0] as string;
              errorBox.textContent = firstErr || 'Ocorreu um erro ao processar sua inscrição. Por favor, tente novamente em instantes.';
            } else {
              errorBox.textContent = 'Ocorreu um erro ao processar sua inscrição. Por favor, tente novamente em instantes.';
            }
            errorBox.classList.remove('hidden');
          }
        }
      } catch (err) {
        // Fallback: se o navegador bloquear fetch CORS, submete nativo
        ctaForm.submit();
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = originalText;
      }
    });
  }
</script>
