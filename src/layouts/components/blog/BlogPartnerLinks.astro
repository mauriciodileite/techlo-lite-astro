---
/**
 * Componente: BlogPartnerLinks.astro
 * Seção de Links Úteis e Parcerias Recomendadas.
 * Estilo: Dark mode elegante (#161616), bordas finas, acento Petronas (#00A39E) e tipografia Sora/Instrument Sans.
 */

interface Props {
  isEnglish?: boolean;
}

const { isEnglish = false } = Astro.props;

const partners = [
  {
    name: "DataForSEO",
    badge: isEnglish ? "Official Partner" : "Parceria Oficial",
    badgeColor: "bg-[#00A39E]/10 text-[#00A39E] border-[#00A39E]/30",
    title: isEnglish ? "DataForSEO Official Platform" : "DataForSEO (Oficial)",
    description: isEnglish
      ? "Pay-per-use SEO, SERP & Backlinks API without expensive monthly subscriptions."
      : "API de SEO, SERP e Backlinks sem mensalidade fixa. Pague centavos por requisição.",
    url: "https://try.dataforseo.com/ho2u1p4ijzam",
    cta: isEnglish ? "Access DataForSEO" : "Conhecer DataForSEO",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />`
  },
  {
    name: "Telegram Bot",
    badge: isEnglish ? "Daily Discounts" : "Ofertas Diárias",
    badgeColor: "bg-[#29FF54]/10 text-[#29FF54] border-[#29FF54]/30",
    title: isEnglish ? "App Deals & Daily Tools" : "Promoções de Apps do Dia a Dia",
    description: isEnglish
      ? "Curated bot with verified discounts and deals on essential everyday apps."
      : "Bot no Telegram com promoções e descontos das ferramentas que utilizo na rotina.",
    url: "https://t.me/Ggsomabot?start=ref_RSQ2CG6E",
    cta: isEnglish ? "Open on Telegram" : "Acessar no Telegram",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />`
  },
  {
    name: "Kie.ai",
    badge: isEnglish ? "Best Value AI" : "Melhor Custo-Benefício",
    badgeColor: "bg-[#E176CA]/10 text-[#E176CA] border-[#E176CA]/30",
    title: isEnglish ? "Kie.ai • Video & Image AI" : "Kie.ai • IA de Vídeos e Imagens",
    description: isEnglish
      ? "The most accessible and cost-effective AI engine for generative video and images."
      : "A IA para geração de vídeos e imagens mais barata e acessível do mercado atual.",
    url: "https://kie.ai?ref=e54b607ead05cdc9516ad578e64d9575",
    cta: isEnglish ? "Explore Kie.ai" : "Experimentar Kie.ai",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />`
  }
];
---

<section class="partner-links-section my-12 pt-10 border-t border-white/10 font-body">
  <!-- Cabeçalho da Seção -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-[#00A39E]/10 text-[#00A39E] border border-[#00A39E]/30 font-['Sora',sans-serif] mb-2">
        <svg class="w-3 h-3 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        <span>{isEnglish ? "USEFUL LINKS & PARTNERS" : "LINKS ÚTEIS & PARCERIAS"}</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold font-['Sora',sans-serif] text-white">
        {isEnglish ? "Recommended Tools & Offers" : "Ferramentas & Parcerias Recomendadas"}
      </h3>
      <p class="text-xs sm:text-sm text-[#A0A0A0] font-['Instrument_Sans',sans-serif] mt-1">
        {isEnglish 
          ? "Tested solutions that I use daily with exclusive conditions for our community:" 
          : "Soluções testadas e que utilizo na minha operação diária com condições exclusivas:"}
      </p>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {partners.map((partner) => (
      <a
        href={partner.url}
        target="_blank"
        rel="sponsored noopener noreferrer"
        class="group relative flex flex-col justify-between rounded-2xl bg-[#161616] border border-white/10 p-5 transition-all duration-300 hover:border-[#00A39E]/50 hover:bg-[#1A1A1A] hover:shadow-[0_0_25px_rgba(0,163,158,0.12)] hover:-translate-y-0.5"
      >
        <!-- Topo: Badge + Ícone -->
        <div>
          <div class="flex items-center justify-between gap-2 mb-3.5">
            <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold border ${partner.badgeColor} font-['Instrument_Sans',sans-serif]`}>
              {partner.badge}
            </span>
            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-[#00A39E] group-hover:scale-110 group-hover:border-[#00A39E]/40 transition-all">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={partner.icon} />
            </div>
          </div>

          <!-- Título -->
          <h4 class="text-base font-semibold font-['Sora',sans-serif] text-white group-hover:text-[#00A39E] transition-colors leading-snug mb-1.5">
            {partner.title}
          </h4>

          <!-- Descrição -->
          <p class="text-xs text-[#A8A8A8] font-['Instrument_Sans',sans-serif] leading-relaxed">
            {partner.description}
          </p>
        </div>

        <!-- Rodapé do Card: Botão/Link com seta externa -->
        <div class="mt-4 pt-3.5 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#00A39E] font-['Instrument_Sans',sans-serif]">
          <span class="group-hover:underline">{partner.cta}</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
