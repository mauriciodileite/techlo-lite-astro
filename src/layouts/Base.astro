---
import "@/styles/globals.css";
import Head from "@/components/global/Head.astro";
import Footer from "@/components/global/Footer.astro";
import removeEmptyKeys from "@/lib/utils/removeEmptyKeys";
import Header from "@/components/global/header/Header.astro";
import type { JSONLDProps } from "@/lib/utils/JsonLdGenerator";
import HelperButtons from "@/components/utilities/HelperButtons.astro";
import CursorFollower from "@/components/utilities/CursorFollower.astro";
import BackToTop from "@/components/utilities/BackToTop.astro";
import BreakpointIndicator from "@/components/widgets/BreakpointIndicator.astro";
import GlobalScripts from "./components/widgets/GlobalScripts.astro";
import type { HeaderLayout } from "@/types";
import CallToAction from "./components/sections/CallToAction.astro";
import KeepAstroSourceLoc from "./components/widgets/KeepAstroSourceLoc.astro";
import PageLoader from "@/lib/PageLoader.astro";

type HeaderPosition = "fixed" | "static" | "sticky";

interface Props extends JSONLDProps {
  className?: string;
  fitToScreen?: boolean;
  ctaSpacingTop?: boolean;
  footerSpaceTop?: boolean;
  headerLayout?: HeaderLayout | "none";
  headerPosition?: HeaderPosition;
  hasBodyDarkBackground?: boolean;
  hasFooterDarkBackground?: boolean;
  hideOffcanvas?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
  hideCallToAction?: boolean;
  hideHelperButtons?: boolean;
  draft?: boolean;
  metaTitle?: string;
  metaDescription?: string;
  robots?: string;
  excludeFromSitemap?: boolean;
  customSlug?: string;
  canonical?: string;
  keywords?: string[];
  disableTagline?: boolean;
  structuredData?: Props;
}

// destructure frontmatter
const {
  className,
  structuredData,
  headerLayout = "two",
  headerPosition = "sticky",
  hideOffcanvas = false,
  hideHeader = false,
  hideFooter = false,
  hideCallToAction = false,
  hideHelperButtons = true,
  hasBodyDarkBackground = true,
  fitToScreen = true,
} = Astro.props;

const shouldHideHeader = hideHeader || headerLayout === "none";
const shouldHideFooter = hideFooter || headerLayout === "none";
const shouldHideCta = hideCallToAction || headerLayout === "none";

// Exclude empty key value weather it may empty string, object or array from Astro.props
let props = removeEmptyKeys(Astro.props);

// Conditionally add min-h-[102vh] class to prevent FOUC (flash of unstyled content) while fast navigation
const finalClassName = fitToScreen
  ? (className ? className + " " : "") + "fit-to-screen"
  : className;
---

<!doctype html>
<html lang={Astro.currentLocale || "pt"} class="bg-[#111111]">
  <Head {...props} structuredData={structuredData} />
  <body class="bg-[#111111] text-white">
    {!Astro.props.homepage && <PageLoader />}
    
    {!shouldHideHeader && (
      <Header
        {...props}
        layout={headerLayout}
        position={headerPosition}
        hideOffcanvas={hideOffcanvas}
      />
    )}

    <main {...finalClassName ? { class: finalClassName } : {}}>
      <slot />
    </main>

    {!shouldHideCta && <CallToAction hasSectionSpacing={Astro.props.ctaSpacingTop} />}
    {!shouldHideFooter && <Footer {...Astro.props} />}

    <KeepAstroSourceLoc />
    <GlobalScripts />
    <CursorFollower />
    <BackToTop />
    {!hideHelperButtons && <HelperButtons />}
    <BreakpointIndicator />
  </body>
</html>
