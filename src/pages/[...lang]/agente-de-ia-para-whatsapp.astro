---
/**
 * Rota: /agente-de-ia-para-whatsapp/
 * Status: RASCUNHO (noindex, fora do sitemap)
 * Responsabilidade: Página de conversão do Agente de IA para WhatsApp (cria.chat + Maurício Leite)
 * Estrutura: 10 Passos de Evaldo Albuquerque + Feature de Print Interativo
 */
import Base from "@/layouts/Base.astro";
import HeaderNav from "@/components/HeaderNav.astro";
import FooterMauricio from "@/components/FooterMauricio.astro";
import PainelInterativo from "@/components/servicos/PainelInterativo.astro";
import CampanhasDisparo from "@/components/servicos/CampanhasDisparo.astro";
import CrmKanban from "@/components/servicos/CrmKanban.astro";
import EquipeAtendentes from "@/components/servicos/EquipeAtendentes.astro";
import RedeConexoesMemoria from "@/components/servicos/RedeConexoesMemoria.astro";
import IntegracoesNativas from "@/components/servicos/IntegracoesNativas.astro";

// Gera a rota apenas em Português na raiz (/agente-de-ia-para-whatsapp/)
export function getStaticPaths() {
  return [{ params: { lang: undefined } }];
}

const metaTitle = "Agente de IA p/ WhatsApp: atende, agenda e vende 24h";
const metaDescription = "Seu WhatsApp atendendo, agendando e vendendo 24h com IA treinada nos dados da sua empresa e com memória de cada cliente. Fale diretamente comigo.";
const whatsappLink = "https://wa.me/5592985582795?text=Ol%C3%A1%2C%20Maur%C3%ADcio!%20Quero%20ver%20o%20agente%20de%20IA%20para%20WhatsApp%20funcionando%20no%20meu%20neg%C3%B3cio.";

// Dados das perguntas frequentes (FAQ)
const faqs = [
  {
    q: "O que é a cria.chat?",
    a: "A cria.chat é uma plataforma profissional de atendimento multicanal com inteligência artificial integrada, desenvolvida para conectar WhatsApp, Instagram e Messenger em um painel unificado com agentes autônomos e controle total da equipe.",
    marker: "[PREENCHER: definição oficial cria.chat e complementos do Maurício]"
  },
  {
    q: "Preciso saber programar?",
    a: "Não. Toda a engenharia de prompts, configuração de fluxos, integração técnica e treinamento do agente com os manuais da sua empresa são feitos diretamente por mim.",
    marker: "[CONFIRMAR: escopo e suporte contínuo]"
  },
  {
    q: "Para que tipo de negócio serve?",
    a: "Qualquer negócio que atende, qualifica ou vende pelo WhatsApp: clínicas e consultórios, estúdios, revendas, imobiliárias, e-commerces e prestadores de serviço em geral.",
    marker: null
  },
  {
    q: "Quais modelos de IA a plataforma usa?",
    a: "A plataforma trabalha com os principais modelos de ponta do mercado (como Claude 3.5 Sonnet, GPT-4o e Gemini), selecionados conforme a complexidade e a velocidade exigida pela sua operação.",
    marker: "[PREENCHER: modelos de IA exatos utilizados na cria.chat]"
  },
  {
    q: "E quando o cliente precisa falar com um atendente humano?",
    a: "A IA identifica a necessidade de intervenção humana (ou o cliente solicita uma pessoa) e transfere a conversa imediatamente para a fila da sua equipe, preservando todo o histórico do atendimento.",
    marker: null
  },
  {
    q: "Em quanto tempo o agente fica no ar?",
    a: "O processo de implementação inclui alinhamento de briefing, estruturação da base de conhecimento, testes em ambiente controlado e ativação oficial.",
    marker: "[PREENCHER: prazo real de implementação em dias/semanas]"
  },
  {
    q: "Como o agente aprende sobre o meu negócio?",
    a: "O agente é treinado com as regras do seu negócio: catálogo de serviços, tabelas de preços, regras de agendamento, políticas de garantia e histórico das principais dúvidas dos clientes.",
    marker: "[CONFIRMAR: formatos aceitos - PDF, Notion, planilhas, sites]"
  },
  {
    q: "Tenho uma operação grande ou preciso de algo personalizado. Você pode ajudar?",
    a: "Sim. Projetamos arquiteturas dedicadas com múltiplos agentes setorizados, conexões avançadas de APIs, bancos de grafos e rotas customizadas.",
    marker: "[PREENCHER: detalhes de contratação personalizada]"
  },
  {
    q: "A plataforma gerencia vários números de WhatsApp?",
    a: "Sim. É possível conectar múltiplos números e canais diferentes sob a mesma gestão.",
    marker: "[CONFIRMAR: limites de números por plano]"
  },
  {
    q: "Consigo disparar mensagem para uma lista?",
    a: "Sim, através das notificações ativas oficiais e templates aprovados pela Meta, garantindo segurança e evitando bloqueios de número.",
    marker: "[CONFIRMAR: regras de disparo ativo e custos da Meta]"
  },
  {
    q: "Como funciona a contratação e valores?",
    a: "Avaliamos o volume de atendimento, quantidade de canais e integrações necessárias para estruturar uma proposta personalizada para a sua empresa. Fale diretamente comigo para analisarmos sua operação.",
    marker: null
  }
];

// Schema JSON-LD Estruturado (Service + BreadcrumbList + FAQPage)
const schemaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Agente de IA p/ WhatsApp: atende, agenda e vende 24h",
      "provider": {
        "@type": "Person",
        "name": "Maurício Leite",
        "url": "https://mauricioleite.com.br"
      },
      "description": metaDescription,
      "areaServed": "BR",
      "serviceType": "Automação de Atendimento e IA para WhatsApp"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://mauricioleite.com.br/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Agente de IA para WhatsApp",
          "item": "https://mauricioleite.com.br/agente-de-ia-para-whatsapp/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.marker ? `${f.a} ${f.marker}` : f.a
        }
      }))
    }
  ]
};
---

<Base
  title={metaTitle}
  description={metaDescription}
  image="/images/servicos/og-agente-ia-whatsapp.jpg"
  robots="noindex, nofollow"
  disableTagline={true}
  disableHreflang={true}
  headerLayout="none"
  hideHeader={true}
  hideFooter={true}
  hideCallToAction={true}
  hideHelperButtons={true}
>
  <!-- Schema Estruturado Especializado -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaJsonLd)} />

  <div class="bg-[#111111] min-h-screen text-white flex flex-col justify-between selection:bg-[#00A39E] selection:text-black">
    <!-- Header Oficial da Marca -->
    <HeaderNav currentLocale="pt" />

    <!-- AVISO DE PÁGINA EM MODO RASCUNHO / PREENCHER -->
    <aside
      aria-label="Aviso de rascunho da página"
      class="pt-20 bg-amber-500/10 border-b border-amber-500/30 text-amber-300 text-xs py-2.5 px-4 text-center font-mono flex items-center justify-center gap-2"
    >
      <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span>
        <strong>MODO RASCUNHO (NOINDEX):</strong> Esta página contém campos marcados com
        <span class="bg-amber-400/20 px-1.5 py-0.5 rounded text-amber-200 border border-amber-400/30 font-bold">[PREENCHER]</span>
        aguardando dados reais antes de ir ao ar.
      </span>
    </aside>

    <div class="flex-grow">
      
      <!-- BREADCRUMB VISÍVEL -->
      <nav aria-label="Navegação Estrutural" class="container mx-auto px-4 max-w-6xl pt-8 pb-4 text-xs font-['Instrument_Sans',sans-serif] text-[#8696a0]">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-white transition-colors">Início</a>
          </li>
          <li>›</li>
          <li class="text-[#00A39E] font-medium" aria-current="page">
            Agente de IA para WhatsApp
          </li>
        </ol>
      </nav>

      <!-- ============================================================== -->
      <!-- <!-- Evaldo #1 Diferenciação + #2 Benefício direto -->
      <!-- 1. HERO SECTION -->
      <!-- ============================================================== -->
      <section class="relative pt-8 pb-20 md:pt-16 md:pb-28 overflow-hidden border-b border-white/5">
        <!-- Glow suave de iluminação da marca -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-[#00A39E]/10 blur-[140px] rounded-full pointer-events-none"></div>

        <div class="container mx-auto px-4 max-w-4xl relative z-10 text-center">
          <!-- Tag / Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-6">
            <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
            <span class="text-xs uppercase tracking-widest text-[#C6C6C6] font-['Sora',sans-serif] font-semibold">
              Agente de IA para WhatsApp • Atendimento 24h
            </span>
          </div>

          <!-- Headline One Belief oficial do Maurício -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[44px] xl:text-[50px] font-extrabold tracking-tight font-['Sora',sans-serif] text-white leading-[1.18] mb-6">
            Agente de IA para WhatsApp que <span class="text-[#00A39E]">atende, agenda e vende 24 horas</span>.
          </h1>

          <!-- Subheadline -->
          <p class="text-base sm:text-lg md:text-xl text-[#C6C6C6] font-['Instrument_Sans',sans-serif] mb-10 leading-relaxed max-w-2xl mx-auto">
            Isso só é possível através da memória de longo prazo, presente no agente de IA da cria.chat.
          </p>

          <!-- Botão Principal de Ação -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="relative group w-full sm:w-auto inline-flex items-center justify-center gap-3 px-9 py-4 rounded-xl bg-[#00A39E] text-black font-['Sora',sans-serif] font-bold text-base hover:bg-[#008f8a] transition-all transform hover:-translate-y-0.5 shadow-lg shadow-[#00A39E]/25"
            >
              <span class="absolute -inset-0.5 rounded-xl bg-[#00A39E] opacity-40 group-hover:opacity-75 blur-sm animate-pulse transition duration-1000 -z-10"></span>
              <span>Falar com Especialista</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
            </a>
          </div>

          <!-- Microcopy: Garantias / Facilidades (Estilo Chatvolt) -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm text-[#C6C6C6] font-['Instrument_Sans',sans-serif]">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Implementação personalizada
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Treinado com os dados da sua empresa
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Memória persistente
            </span>
          </div>

          <!-- Prova Social: Avaliação + Empresas -->
          <div class="mt-4 flex items-center justify-center gap-2 text-xs sm:text-sm text-[#C6C6C6] font-['Instrument_Sans',sans-serif]">
            <div class="flex items-center text-amber-400 gap-0.5 text-sm" aria-label="Avaliação 5 estrelas">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <strong class="font-bold text-white">4,8/5</strong>
            <span class="text-white/20 mx-1">|</span>
            <span>+165 empresas já atendem com IA no Whatsapp</span>
          </div>
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- <!-- Evaldo #2 Benefício direto -->
      <!-- 2. O QUE MUDA COM O AGENTE: PRINT INTERATIVO -->
      <!-- ============================================================== -->
      <section class="py-20 md:py-28 bg-[#0a0f12] border-b border-white/5 relative">
        <div class="container mx-auto px-4 max-w-7xl">
          <!-- Componente do Print Interativo (100% CSS Nativo, Zero JS) -->
          <PainelInterativo />
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- 2.1 CAMPANHAS DE DISPARO INTERATIVAS (IMAGEM 2) -->
      <!-- ============================================================== -->
      <section class="py-20 md:py-28 bg-[#111111] border-b border-white/5 relative">
        <div class="container mx-auto px-4 max-w-7xl">
          <!-- Componente de Disparo e Campanhas (100% CSS Nativo, Zero JS) -->
          <CampanhasDisparo />
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- 2.2 CRM KANBAN & OPORTUNIDADES INTERATIVO (IMAGEM 3) -->
      <!-- ============================================================== -->
      <section class="py-20 md:py-28 bg-[#0a0f12] border-b border-white/5 relative">
        <div class="container mx-auto px-4 max-w-7xl">
          <!-- Componente de CRM e Oportunidades (100% CSS Nativo, Zero JS) -->
          <CrmKanban />
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- 2.3 GESTÃO DE ATENDENTES & CONTROLE HIERÁRQUICO (IMAGEM 4) -->
      <!-- ============================================================== -->
      <section class="py-20 md:py-28 bg-[#111111] border-b border-white/5 relative">
        <div class="container mx-auto px-4 max-w-7xl">
          <!-- Componente de Gestão de Atendentes (100% CSS Nativo, Zero JS) -->
          <EquipeAtendentes />
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- <!-- Evaldo #3 Prova de realidade -->
      <!-- 3. CASOS REAIS E PARA QUEM É -->
      <!-- ============================================================== -->
      <section class="py-20 md:py-28 border-b border-white/5">
        <div class="container mx-auto px-4 max-w-6xl">
          <div class="text-center max-w-3xl mx-auto mb-14">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight mb-4">
              Casos Reais e Aplicações no Dia a Dia
            </h2>
            <p class="text-base sm:text-lg text-[#C6C6C6] font-['Instrument_Sans',sans-serif]">
              Resultados práticos de empresas que já transformaram a conversa no WhatsApp em agendamentos constantes.
            </p>
          </div>

          <!-- Bloco de Caso Real com Marcador (Dora Saúde Auditiva) -->
          <div class="max-w-3xl mx-auto mb-16">
            <!-- Caso: Dora Saúde Auditiva -->
            <div class="p-8 sm:p-10 rounded-2xl bg-[#162026] border border-white/10 hover:border-[#00A39E]/40 transition-colors shadow-xl">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-[#00A39E] font-['Sora',sans-serif]">
                  Saúde Auditiva • Brasília
                </span>
                <span class="text-xs text-[#8696a0]">Estudo de Caso</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold font-['Sora',sans-serif] text-white mb-3">
                Dona Dora: Agente Conversacional na Saúde Auditiva
              </h3>
              <p class="text-sm sm:text-base text-[#C6C6C6] font-['Instrument_Sans',sans-serif] mb-6 leading-relaxed">
                Atendimento humanizado para pacientes que precisam de aparelhos auditivos. O agente compreende áudios longos, esclarece dúvidas delicadas e realiza agendamentos diretos.
              </p>

              <!-- Marcador de Dado Real -->
              <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/30 mb-6">
                <span class="block text-xs font-mono font-bold text-amber-300">
                  [PREENCHER: resultado da Dora - tempo médio de resposta, agendamentos gerados e taxa de retenção]
                </span>
              </div>

              <a
                href="/blog/estudo-de-caso-dora-ia-saude-auditiva-brasilia/"
                class="inline-flex items-center gap-2 text-sm font-bold text-[#00A39E] hover:underline"
              >
                <span>Ler estudo de caso completo no blog</span>
                <span>›</span>
              </a>
            </div>
          </div>

          <!-- ============================================================== -->
          <!-- INTEGRAÇÕES NATIVAS & CANAIS SUPORTADOS -->
          <!-- ============================================================== -->
          <IntegracoesNativas />
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- <!-- Evaldo #4: Problema real -->
      <!-- 4. O PROBLEMA REAL -->
      <!-- ============================================================== -->
      <section class="py-20 md:py-24 bg-[#0a0f12] border-b border-white/5 relative">
        <div class="container mx-auto px-4 max-w-4xl text-center">
          <!-- Pill Badge Idêntica ao Padrão de Integrações Nativas -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#1A1A1A] border border-[#00A39E]/30 mb-4 shadow-sm">
            <span class="text-[#00A39E]">⚠️</span>
            <span class="text-xs uppercase tracking-widest text-[#00A39E] font-['Sora',sans-serif] font-bold">
              O Problema Real
            </span>
          </div>

          <!-- Título Principal com a Mesma Tipografia e Peso -->
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight mb-4 leading-tight max-w-3xl mx-auto">
            Sexta-feira, 19h: o cliente chamou e ninguém respondeu
          </h2>

          <!-- Subtítulo Explicativo com a Mesma Cor e Entrelinha -->
          <p class="text-base sm:text-lg text-[#D4D4D4] font-['Instrument_Sans',sans-serif] leading-relaxed max-w-2xl mx-auto">
            A resposta só chega na segunda às 8h — e, nesse meio-tempo, ele já fechou com o concorrente. Você contrata, treina, investe em uniforme e ainda perde venda no WhatsApp. Não é falta de vendedor nem de anúncio. O problema real é que o seu atendimento depende de pessoas e de horário: quando o funcionário sai, o conhecimento vai junto; quando a loja fecha, o cliente fica sem resposta.
          </p>
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- <!-- Evaldo #5: Inimigo comum (Nós vs. Eles) -->
      <!-- 5. O CULPADO -->
      <!-- ============================================================== -->
      <section class="py-20 md:py-28 border-b border-white/5 relative overflow-hidden">
        <div class="container mx-auto px-4 max-w-5xl">
          <!-- Cabeçalho da Seção -->
          <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-['Sora',sans-serif] text-white tracking-tight leading-tight">
              Não é culpa sua. Hoje as pessoas compram <span class="text-[#00A39E]">fora do horário comercial</span>.
            </h2>
            <p class="mt-4 text-base sm:text-lg text-[#C6C6C6] font-['Instrument_Sans',sans-serif] max-w-2xl mx-auto leading-relaxed">
              O horário comercial foi inventado quando o cliente só comprava de porta aberta, hoje ele compra em um clique sentado no sofá.
            </p>
          </div>

          <!-- 3 Situações Curtas: Lado a Lado no Computador, Empilhadas no Celular -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 mb-16 sm:mb-20">
            <!-- Situação 1: 23h -->
            <div class="p-6 sm:p-7 rounded-2xl bg-[#162026] border border-white/10 flex flex-col justify-between hover:border-white/20 transition-all">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-[#8696a0]">Cenário 1</span>
                  <span class="text-lg">🌙</span>
                </div>
                <div class="text-3xl sm:text-4xl font-black font-['Sora',sans-serif] text-white tracking-tight mb-2">
                  23h
                </div>
                <p class="text-base font-bold text-white font-['Sora',sans-serif]">
                  Pesquisa no Google
                </p>
              </div>
              <p class="text-xs sm:text-sm text-[#8696a0] font-['Instrument_Sans',sans-serif] mt-4 pt-3 border-t border-white/5">
                O cliente está navegando na cama, pronto para tirar dúvidas e avançar na compra.
              </p>
            </div>

            <!-- Situação 2: Domingo -->
            <div class="p-6 sm:p-7 rounded-2xl bg-[#162026] border border-white/10 flex flex-col justify-between hover:border-white/20 transition-all">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-[#8696a0]">Cenário 2</span>
                  <span class="text-lg">💬</span>
                </div>
                <div class="text-3xl sm:text-4xl font-black font-['Sora',sans-serif] text-white tracking-tight mb-2">
                  Domingo
                </div>
                <p class="text-base font-bold text-white font-['Sora',sans-serif]">
                  Chama no WhatsApp
                </p>
              </div>
              <p class="text-xs sm:text-sm text-[#8696a0] font-['Instrument_Sans',sans-serif] mt-4 pt-3 border-t border-white/5">
                Tempo livre para resolver pendências. Quem responder primeiro ganha a preferência.
              </p>
            </div>

            <!-- Situação 3: Seg 9h -->
            <div class="p-6 sm:p-7 rounded-2xl bg-[#162026] border border-white/10 hover:border-[#00A39E]/40 flex flex-col justify-between transition-all">
              <div>
                <div class="flex items-center justify-between mb-4">
