---
import Base from "@/layouts/Base.astro";
import { render } from "astro:content";
import { getCollectionCTM, getEntryCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import extractSlug from "@/lib/utils/extractSlug";
import DynamicToc from "@/layouts/components/blog/DynamicToc.astro";
import BlogRelatedPosts from "@/layouts/components/blog/BlogRelatedPosts.astro";
import BlogCta from "@/layouts/components/blog/BlogCta.astro";
import BlogShareBar from "@/layouts/components/blog/BlogShareBar.astro";
import GooglePreferredSource from "@/layouts/components/blog/GooglePreferredSource.astro";
import CommentsSection from "@/layouts/components/CommentsSection.astro";
import BlogPartnerLinks from "@/layouts/components/blog/BlogPartnerLinks.astro";
import { shortcodes } from "@/lib/shortcodes";
import HeaderNav from "@/components/HeaderNav.astro";
import FooterMauricio from "@/components/FooterMauricio.astro";
import VideoPlayer1Min from "@/layouts/components/VideoPlayer1Min.astro";
import ReadingModeToggle from "@/layouts/components/blog/ReadingModeToggle.astro";
import config from ".astro/config.generated.json";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const blogFolder = config.settings.blogFolder as "blog";
      const { defaultLanguage, showDefaultLangInUrl } = config.settings.multilingual;

      const postIndex = await getEntryCTM(blogFolder, "-index", lang.languageCode);
      const posts = await getCollectionCTM(blogFolder, lang.languageCode);

      if (postIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      return posts.map((post) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          single: extractSlug(post).split("/").pop(),
        },
        props: {
          post,
          allPosts: posts,
        },
      }));
    }),
  );

  return paths.flat();
}

interface Props {
  post: any;
  allPosts: any[];
}

const { post, allPosts = [] } = Astro.props;
const { Content, headings } = await render(post);

const currentSlug = extractSlug(post).split("/").pop();
const category = (post.data.categories && post.data.categories[0]) || "Geral";
const pubDateStr = post.data.date
  ? new Date(post.data.date).toLocaleDateString(Astro.currentLocale === "en" ? "en-US" : "pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : "Recente";

const readTime = post.data.readTime || 5;
const author = post.data.author || "Maurício Leite";
const avatarUrl = post.data.avatarUrl || "/images/perfil.jpg";

// Navigation (Previous & Next Post)
const currentIndex = allPosts.findIndex(
  (p) => extractSlug(p).split("/").pop() === currentSlug,
);

const previousPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const postDate = post.data.date ? new Date(post.data.date).getTime() : 0;
const isRecent = postDate > 0 && Math.abs(Date.now() - postDate) < 24 * 60 * 60 * 1000;
const isNew = post.data.isNew ?? isRecent;

// Related Posts (Same category or fallback)
const relatedRaw = allPosts
  .filter((p) => extractSlug(p).split("/").pop() !== currentSlug)
  .slice(0, 3);

const formattedRelatedPosts = relatedRaw.map((p, idx) => {
  const pDate = p.data.date ? new Date(p.data.date).getTime() : 0;
  const pIsRecent = pDate > 0 && Math.abs(Date.now() - pDate) < 24 * 60 * 60 * 1000;
  return {
    id: p.id || idx + 1,
    slug: extractSlug(p).split("/").pop() || p.id,
    title: p.data.title,
    description: p.data.description || "",
    imageUrl: p.data.image || `/images/blog-post/post-${(idx % 8) + 1}.webp`,
    imageAlt: p.data.imageAlt || p.data.title,
    pubDate: p.data.date
      ? new Date(p.data.date).toLocaleDateString(Astro.currentLocale === "en" ? "en-US" : "pt-BR", {
          day: "2-digit",
          month: "short",
          year: "numeric",
        })
      : "Recente",
    category: (p.data.categories && p.data.categories[0]) || "Estratégia",
    author: p.data.author || "Maurício Leite",
    readTime: p.data.readTime || 5,
    featured: false,
    isNew: p.data.isNew ?? pIsRecent,
  };
});
---

<Base
  title={`${post.data.title} — Maurício Leite`}
  metaTitle={post.data.metaTitle || `${post.data.title} | Maurício Leite`}
  metaDescription={post.data.metaDescription || post.data.description}
  image={post.data.image}
  pageType="article"
  datePublished={post.data.date}
  dateModified={post.data.modDate || post.data.date}
  author={author}
  categories={post.data.categories}
  disableTagline={true}
  headerLayout="none"
  hideHeader={true}
  hideFooter={true}
  hideCallToAction={true}
  hideHelperButtons={true}
>
  <div class="bg-[#111111] min-h-screen text-white flex flex-col justify-between selection:bg-[#00A39E] selection:text-black">
    <!-- Header Oficial da Marca -->
    <HeaderNav currentLocale={Astro.currentLocale || "pt"} />

    <main id="blog-reading-area" class="flex-grow flex flex-col bg-[#111111] text-[#C6C6C6] pt-20 transition-colors duration-300">
    <!-- Article Section -->
    <section class="py-10 sm:pt-20 sm:pb-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="gap-12 md:grid md:grid-cols-5 lg:grid-cols-7">
          <!-- Table of Contents Sidebar (sticky on desktop) -->
          <aside class="hidden md:col-span-2 md:block lg:col-span-2">
            <DynamicToc headings={headings} />
          </aside>

          <!-- Main Article Column -->
          <div class="space-y-10 md:col-span-3 lg:col-span-5">
            <!-- Breadcrumbs e Modo Leitura no canto superior direito -->
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/5 pb-3">
              <nav class="flex items-center gap-2 font-body text-xs text-[#888888]">
                <a href="/" class="transition-colors hover:text-white">Home</a>
                <span>/</span>
                <a href="/blog" class="transition-colors hover:text-white">Blog</a>
                <span>/</span>
                <span class="text-[#00A39E] font-medium">{category}</span>
                {isNew && (
                  <span class="ml-1 inline-flex items-center justify-center rounded-full bg-[#29FF54] px-2.5 py-0.5 text-xs font-semibold text-black leading-none shadow-sm">
                    Now
                  </span>
                )}
              </nav>

              <!-- Botão Modo Leitura (Canto superior direito) -->
              <ReadingModeToggle isEnglish={Astro.currentLocale === "en"} />
            </div>

            <!-- Title & Lead Description -->
            <div class="space-y-4">
              <h1 class="font-heading text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl leading-tight">
                {post.data.title}
              </h1>
              {post.data.description && (
                <p class="font-body text-lg sm:text-xl text-[#D4D4D4] leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </div>

            <!-- Video Player (Resumo em Vídeo logo após o subtítulo) -->
            {post.data.youtubeId && (
              <div class="pt-2 pb-4">
                <VideoPlayer1Min
                  youtubeId={post.data.youtubeId}
                  badgeText={post.data.videoBadgeText || "Resumo em Vídeo • 40s"}
                  durationText={post.data.videoDurationText || "00:40 min"}
                  title={post.data.videoTitle || "Radar de Tráfego & IA em 40 Segundos"}
                  aspectRatio={post.data.videoAspectRatio || "9/16"}
                />
              </div>
            )}

            <!-- Separator -->
            <div class="h-px w-full bg-white/10"></div>

            <!-- Post Metadata (Author avatar, Read Time, Date) -->
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6 text-sm">
              <div class="flex items-center gap-3">
                <img
                  src={avatarUrl}
                  alt={author}
                  class="h-10 w-10 rounded-full border border-white/15 object-cover"
                />
                <div class="flex flex-col">
                  <span class="text-xs text-[#888888]">Escrito por</span>
                  <span class="font-heading font-medium text-white">{author}</span>
                </div>
              </div>

              <div class="flex items-center gap-6 text-xs text-[#999999]">
                <div class="flex items-center gap-1.5">
                  <svg class="h-4 w-4 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{readTime} min de leitura</span>
                </div>

                <div class="flex items-center gap-1.5">
                  <svg class="h-4 w-4 text-[#00A39E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>{pubDateStr}</span>
                </div>
              </div>
            </div>

            <!-- Hero Image -->
            {post.data.image && (
              <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#161616]">
                <img
                  src={post.data.image}
                  alt={post.data.imageAlt || post.data.title}
                  class="max-h-[500px] w-full object-cover"
                  loading="eager"
                />
              </div>
            )}

            <!-- Article Body Content with Brand Styling -->
            <article
              id="content"
              class="prose prose-invert max-w-none text-[#D4D4D4] font-body text-lg leading-[1.8]
                prose-headings:font-heading prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-white
                prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-5 prose-h2:border-b prose-h2:border-white/10 prose-h2:pb-3
                prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-9 prose-h3:mb-4
                prose-h4:text-lg sm:prose-h4:text-xl prose-h4:mt-6 prose-h4:mb-3
                prose-p:text-[18px] sm:prose-p:text-[19px] prose-p:leading-[1.85] prose-p:mb-6 prose-p:text-[#D4D4D4]
                prose-a:text-[#00A39E] prose-a:font-medium prose-a:no-underline hover:prose-a:underline hover:prose-a:text-[#29FF54] transition-colors
                prose-strong:text-white prose-strong:font-semibold
                prose-code:text-[#00A39E] prose-code:bg-white/10 prose-code:px-2 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[15px] sm:prose-code:text-[16px] prose-code:font-mono
                prose-blockquote:border-l-4 prose-blockquote:border-l-[#00A39E] prose-blockquote:bg-[#161616]/80 prose-blockquote:py-3.5 prose-blockquote:px-6 prose-blockquote:rounded-r-2xl prose-blockquote:italic prose-blockquote:text-white/95 prose-blockquote:text-[18px] prose-blockquote:my-6
                prose-ul:list-disc prose-ul:pl-6 prose-ul:my-5
                prose-ol:list-decimal prose-ol:pl-6 prose-ol:my-5
                prose-li:text-[18px] sm:prose-li:text-[19px] prose-li:leading-[1.8] prose-li:my-2 prose-li:text-[#D4D4D4]
                prose-table:my-8 prose-table:w-full prose-table:text-[15px] sm:prose-table:text-[16px]
                prose-thead:border-b prose-thead:border-white/15 prose-thead:text-white
                prose-th:p-3.5 prose-th:font-semibold prose-th:text-white prose-th:bg-[#161616]
                prose-td:p-3.5 prose-td:border-b prose-td:border-white/5 prose-td:text-[#D4D4D4]
                prose-hr:my-10 prose-hr:border-white/10"
            >
              <Content components={shortcodes} />
            </article>

            <!-- Card Google Preferred Source (Add to Preferred Sources) -->
            <GooglePreferredSource isEnglish={Astro.currentLocale === "en"} />

            <!-- Barra de Métricas e Compartilhamento Social (WhatsApp, Instagram, X, Reddit, etc.) -->
            <BlogShareBar
              title={post.data.title}
              description={post.data.description || ""}
              slug={currentSlug || "post"}
              isEnglish={Astro.currentLocale === "en"}
            />

            <!-- Post Navigation (Previous / Next) matching shadcn style -->
            <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-8">
              {previousPost ? (
                <a
                  href={`/blog/${extractSlug(previousPost).split("/").pop()}`}
                  class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-[#161616] px-5 py-2.5 font-heading text-xs font-medium text-white transition-all hover:border-[#00A39E] hover:bg-white/5"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Artigo Anterior
                </a>
              ) : (
                <span class="inline-flex cursor-not-allowed items-center gap-2 rounded-xl border border-white/5 bg-white/5 px-5 py-2.5 font-heading text-xs text-[#555555]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Artigo Anterior
                </span>
              )}

              {nextPost ? (
                <a
                  href={`/blog/${extractSlug(nextPost).split("/").pop()}`}
                  class="ml-auto inline-flex items-center gap-2 rounded-xl border border-[#00A39E]/40 bg-[#00A39E]/10 px-5 py-2.5 font-heading text-xs font-medium text-[#00A39E] transition-all hover:bg-[#00A39E] hover:text-black hover:shadow-[0_0_15px_rgba(0,163,158,0.3)]"
                >
                  Próximo Artigo
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ) : (
                <span class="ml-auto inline-flex cursor-not-allowed items-center gap-2 rounded-xl border border-white/5 bg-white/5 px-5 py-2.5 font-heading text-xs text-[#555555]">
                  Próximo Artigo
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              )}
            </div>

            <!-- Links Úteis e Parcerias Recomendadas -->
            <BlogPartnerLinks isEnglish={Astro.currentLocale === "en"} />

            <!-- Sistema Próprio de Comentários no Blog (Disqus-like com Supabase) -->
            <div class="pt-8">
              <CommentsSection postSlug={currentSlug || "post"} isEnglish={Astro.currentLocale === "en"} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Artigos Relacionados -->
    <BlogRelatedPosts posts={formattedRelatedPosts} />

    <!-- Newsletter CTA -->
    <BlogCta />
  </main>

  <!-- Rodapé Oficial Maurício Leite -->
  <FooterMauricio />
</div>

<style is:global>
  /* ==========================================================================
     Modo Leitura Blog - Brand Book Maurício Leite
     Cores Oficiais:
     - Fundo Primário: #FFFFFF
     - Texto Primário / Títulos: #111111 (Preto Pista)
     - Texto Secundário: #2E2E2E / #4A4A4A
     - Superfícies de apoio (cards, tabelas, blockquotes): #F2F2F2
     - Bordas e divisores: #E3E3E3
     - Destaque e Links: #00A39E (Petronas)
     ========================================================================== */
  #blog-reading-area.reading-mode-light {
    background-color: #FFFFFF !important;
    color: #111111 !important;
  }

  /* Títulos e Parágrafos */
  #blog-reading-area.reading-mode-light h1,
  #blog-reading-area.reading-mode-light h2,
  #blog-reading-area.reading-mode-light h3,
  #blog-reading-area.reading-mode-light h4,
  #blog-reading-area.reading-mode-light h5,
  #blog-reading-area.reading-mode-light h6 {
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light .font-heading {
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light p.font-body {
    color: #2E2E2E !important;
  }

  /* Divisores e Bordas */
  #blog-reading-area.reading-mode-light .border-white\/10,
  #blog-reading-area.reading-mode-light .border-white\/15,
  #blog-reading-area.reading-mode-light .border-white\/5,
  #blog-reading-area.reading-mode-light .border-b,
  #blog-reading-area.reading-mode-light .border-t,
  #blog-reading-area.reading-mode-light .h-px {
    border-color: #E3E3E3 !important;
    background-color: #E3E3E3 !important;
  }

  /* Metadados */
  #blog-reading-area.reading-mode-light .text-\[\#888888\],
  #blog-reading-area.reading-mode-light .text-\[\#999999\],
  #blog-reading-area.reading-mode-light .text-\[\#D4D4D4\],
  #blog-reading-area.reading-mode-light .text-\[\#C6C6C6\] {
    color: #4A4A4A !important;
  }

  /* Sidebar TOC (Neste Artigo) */
  #blog-reading-area.reading-mode-light aside > div {
    background-color: #F8F9FA !important;
    border-color: #E3E3E3 !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  #blog-reading-area.reading-mode-light aside h3 {
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light aside a.toc-link {
    color: #4A4A4A !important;
  }

  #blog-reading-area.reading-mode-light aside a.toc-link:hover,
  #blog-reading-area.reading-mode-light aside a.toc-link.text-white {
    color: #111111 !important;
    font-weight: 600;
  }

  /* Artigo Prose */
  #blog-reading-area.reading-mode-light article.prose {
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light article.prose p,
  #blog-reading-area.reading-mode-light article.prose li {
    color: #222222 !important;
  }

  #blog-reading-area.reading-mode-light article.prose h2 {
    border-bottom-color: #E3E3E3 !important;
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light article.prose a {
    color: #00A39E !important;
  }

  #blog-reading-area.reading-mode-light article.prose a:hover {
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light article.prose strong {
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light article.prose blockquote {
    background-color: #F2F2F2 !important;
    border-left-color: #00A39E !important;
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light article.prose code:not(pre code) {
    background-color: #F2F2F2 !important;
    color: #00A39E !important;
    border: 1px solid #E3E3E3 !important;
  }

  #blog-reading-area.reading-mode-light article.prose hr {
    border-color: #E3E3E3 !important;
  }

  #blog-reading-area.reading-mode-light article.prose table thead {
    border-bottom-color: #E3E3E3 !important;
  }

  #blog-reading-area.reading-mode-light article.prose table th {
    background-color: #F2F2F2 !important;
    color: #111111 !important;
    border-color: #E3E3E3 !important;
  }

  #blog-reading-area.reading-mode-light article.prose table td {
    color: #222222 !important;
    border-bottom-color: #E3E3E3 !important;
  }

  /* Botão Toggle no Modo Claro */
  #reading-mode-toggle-btn.is-light-active {
    background-color: #F2F2F2 !important;
    border-color: #C6C6C6 !important;
    color: #111111 !important;
  }

  #reading-mode-toggle-btn.is-light-active:hover {
    background-color: #FFFFFF !important;
    border-color: #00A39E !important;
    box-shadow: 0 0 12px rgba(0, 163, 158, 0.25) !important;
  }

  /* Cartões de navegação anterior/próximo */
  #blog-reading-area.reading-mode-light a[href^="/blog/"] {
    background-color: #F2F2F2 !important;
    border-color: #E3E3E3 !important;
    color: #111111 !important;
  }

  #blog-reading-area.reading-mode-light a[href^="/blog/"]:hover {
    background-color: #FFFFFF !important;
    border-color: #00A39E !important;
    color: #00A39E !important;
  }

  /* Barra de Compartilhamento */
  #blog-reading-area.reading-mode-light .blog-share-bar {
    background-color: #F8F9FA !important;
    border-color: #E3E3E3 !important;
    color: #4A4A4A !important;
  }
</style>
</Base>
