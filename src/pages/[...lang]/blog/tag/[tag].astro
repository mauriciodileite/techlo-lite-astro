---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import { slugifyyy, titleify } from "@/lib/utils/textConverter";
import HeaderNav from "@/components/HeaderNav.astro";
import FooterMauricio from "@/components/FooterMauricio.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import config from ".astro/config.generated.json";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const {
        blogFolder: blogFolder,
        multilingual: { defaultLanguage, showDefaultLangInUrl },
      } = config.settings;

      const postIndex = await getEntryCTM(
        blogFolder as "blog",
        "-index",
        lang.languageCode,
      );
      const tags = await getTaxonomy(
        blogFolder as "blog",
        "tags",
        lang.languageCode,
      );

      const paths = tags.map((tag) => ({
        params: {
          tag: slugifyyy(tag.slug),
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
        },
        props: { tag, postIndex, blogFolder },
      }));

      // If draft true in index.md file frontmatter don't include any page related to this page collection in production
      if (postIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      return paths;
    }),
  );

  return paths.flat();
}

const { tag, blogFolder, postIndex } = Astro.props;

let post = await getEntryCTM(
  blogFolder as "blog",
  "post-1",
  Astro.currentLocale,
);

// Check if blog posts exist in the folder
let title = titleify(`${tag.name} posts`);
const description = post?.data.description || postIndex?.data.description;
---

<Base
  {...postIndex?.data}
  title={title}
  description={description}
  headerLayout="none"
  hideHeader={true}
  hideFooter={true}
  hideCallToAction={true}
  hideHelperButtons={true}
  disableTagline={true}>
  <div class="bg-[#111111] min-h-screen text-white flex flex-col justify-between selection:bg-[#00A39E] selection:text-black">
    <HeaderNav currentLocale={Astro.currentLocale || "pt"} />

    <main class="flex-grow pt-20">
      <PageHeader
        content={{ hiddenPaths: ["Tag"], title: `Tag: ${titleify(tag.name)}` }}
      />
      <BlogLayout
        pageType="list"
        contentList={{
          options: postIndex?.data.options,
          filter: { tag: tag },
          breadcrumbExcludedPaths: ["Tag"],
        }}
        sidebar={{
          enable: true,
          sticky: true,
        }}
        content={{ ...post, ...post?.data }}
      />
    </main>

    <FooterMauricio />
  </div>
</Base>

