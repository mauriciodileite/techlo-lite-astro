---
import Base from "@/layouts/Base.astro";
import HeaderNav from "@/components/HeaderNav.astro";
import FooterMauricio from "@/components/FooterMauricio.astro";
import VideoPlayer1Min from "@/components/VideoPlayer1Min.astro";
import CalendlyEmbed from "@/components/CalendlyEmbed.astro";
import ComparisonTable, { type ComparisonRow } from "@/components/ComparisonTable.astro";
import FaqAccordion, { type FaqItem } from "@/components/FaqAccordion.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";

export function getStaticPaths() {
  return generatePaths();
}

const currentLocale = Astro.currentLocale || "pt";
const isEnglish = currentLocale === "en" || Astro.url.pathname.startsWith("/en");

const metaTitle = isEnglish
  ? "For Experts & Creators | Perpetual Low-Ticket Funnels & Co-production"
  : "Para Experts & Produtores | Funis Perpétuos de Low Ticket & Coprodução";

const metaDescription = isEnglish
  ? "Scale your expertise with perpetual low-ticket acquisition funnels. High volume of buyers, paid traffic engineering, and strategic co-production."
  : "Escale sua audiência com funis perpétuos de low ticket. Alto volume de novos compradores todos os dias, esteira validada e coprodução com Maurício Leite.";

// Tabela de Formatos de Parceria para Experts
const expertComparisonRowsPt: ComparisonRow[] = [
  { feature: "Criação da Oferta Low Ticket & Upsells", optionA: "Direcionamento Estratégico", optionB: "Construção Completa Hands-on", highlightB: true },
  { feature: "Engenharia de Tráfego Pago & Otimização", optionA: "Auditoria Mensal", optionB: "Gestão Diária de Escala", highlightB: true },
  { feature: "Arquitetura Técnica de Páginas & Checkout", optionA: "Revisão de Conversão", optionB: "Desenvolvimento Ultrarrápido", highlightB: true },
  { feature: "Modelo de Remuneração", optionA: "Fee Fixo de Consultoria", optionB: "Participação em Vendas (Revenue Share)", highlightB: true },
  { feature: "Atendimento por IA para Recuperação", optionA: false, optionB: true, highlightB: true },
  { feature: "Reuniões Semanais de Crescimento", optionA: "Quinzenal", optionB: "Acompanhamento Semanal + WhatsApp", highlightB: true },
];

const expertComparisonRowsEn: ComparisonRow[] = [
  { feature: "Low Ticket Offer & Upsell Design", optionA: "Strategic Guidance", optionB: "Hands-on Full Build", highlightB: true },
  { feature: "Paid Ads Engineering & Optimization", optionA: "Monthly Audit", optionB: "Daily Scaling Management", highlightB: true },
  { feature: "High-Speed Landing Page & Checkout", optionA: "Conversion Review", optionB: "Turnkey Development", highlightB: true },
  { feature: "Partnership Model", optionA: "Fixed Consulting Fee", optionB: "Revenue Share Co-production", highlightB: true },
  { feature: "AI Automated Abandoned Cart Recovery", optionA: false, optionB: true, highlightB: true },
  { feature: "Growth Alignment Meetings", optionA: "Bi-weekly", optionB: "Weekly Sprints + WhatsApp Direct", highlightB: true },
];

// FAQ Oficial para Experts
const faqsExpertsPt: FaqItem[] = [
  {
    question: "O que é a metodologia de funil perpétuo de low ticket?",
    answer: "É um modelo de atração em massa onde vendemos produtos de entrada de alto valor percebido e preço acessível (R$ 27 a R$ 97). Isso paga o tráfego imediatamente (CAC zero) e constrói uma lista diária de compradores qualificados para seus produtos de maior valor (high ticket/mentoria)."
  },
  {
    question: "Para quem é o modelo de coprodução/parceria?",
    answer: "Para especialistas, infoprodutores e criadores de conteúdo que já possuem autoridade comprovada no seu nicho e desejam delegar 100% da estratégia de funil e mídia paga para uma equipe técnica especializada."
  },
  {
    question: "Como funciona a divisão de faturamento?",
    answer: "Trabalhamos no modelo de parceria estratégica com participação sobre o lucro ou receita gerada pela esteira de perpétuo construída em conjunto, alinhando nossos interesses aos seus resultados."
  },
  {
    question: "Vocês cuidam da gravação das aulas do produto?",
    answer: "O conteúdo técnico e a entrega do conhecimento continuam sendo do especialista. Nós cuidamos de todo o ecossistema de venda: copies de VSL, anúncios, páginas, integrações técnicas, tráfego pago e automações de IA."
  },
  {
    question: "Como iniciar uma conversa para avaliar parceria?",
    answer: "Agende uma reunião de alinhamento de 30 minutos na agenda abaixo para avaliarmos se o seu nicho e momento são ideais para o modelo de coprodução."
  }
];

const faqsExpertsEn: FaqItem[] = [
  {
    question: "What is the perpetual low-ticket funnel framework?",
    answer: "It is a mass acquisition model selling accessible, high-value front-end products ($7 to $47) to immediately liquidate paid traffic costs (zero CAC) while generating hundreds of qualified buyers daily for your high-ticket backend."
  },
  {
    question: "Who is this partnership/co-production model for?",
    answer: "For experts, coaches, and creators who have proven authority and want to delegate 100% of funnel engineering and media buying to an elite technical team."
  },
  {
    question: "How does the revenue split work?",
    answer: "We partner on a revenue-share model tied directly to the performance of the perpetual funnel we architect together."
  },
  {
    question: "Do you produce the educational course content?",
    answer: "No, the educational content remains the domain of the expert. We build the entire sales machinery: VSL scripts, ad creatives, ultra-fast landers, checkout optimization, and AI messaging."
  },
  {
    question: "How do we get started?",
    answer: "Book a 30-minute introductory call in the calendar below to assess partnership fit."
  }
];

const currentRows = isEnglish ? expertComparisonRowsEn : expertComparisonRowsPt;
const currentFaqs = isEnglish ? faqsExpertsEn : faqsExpertsPt;
---

<Base
  title={metaTitle}
  description={metaDescription}
  headerLayout="none"
  hideHeader={true}
  hideFooter={true}
  hideCallToAction={true}
  hideHelperButtons={true}
>
  <div class="bg-[#111111] min-h-screen text-white flex flex-col justify-between selection:bg-[#00A39E] selection:text-black">
    <!-- Header Oficial da Marca -->
    <HeaderNav currentLocale={isEnglish ? "en" : "pt"} />

    <main class="flex-grow">
      <!-- 1. HERO SECTION PARA EXPERTS COM VÍDEO 9:16 -->
      <section class="relative pt-36 pb-20 md:pt-44 md:pb-28 overflow-hidden border-b border-white/5">
        <!-- Glow suave de iluminação -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-[#00A39E]/10 blur-[140px] rounded-full pointer-events-none"></div>

        <div class="container mx-auto px-4 max-w-6xl relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
            
            <!-- Coluna da Esquerda: Textos e CTA -->
            <div class="lg:col-span-7 text-center lg:text-left">
              <!-- Tag / Badge -->
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-6">
                <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
                <span class="text-xs uppercase tracking-widest text-[#C6C6C6] font-['Sora',sans-serif] font-semibold">
                  {isEnglish ? "For Experts • Perpetual Funnels" : "Para Experts • Funis Perpétuos"}
                </span>
              </div>

              <!-- Headline One Belief para Experts -->
              <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[40px] xl:text-[46px] font-extrabold tracking-tight font-['Sora',sans-serif] text-white leading-[1.18] mb-6">
                {isEnglish ? (
                  <>
                    Transforming your authority into <span class="text-[#00A39E]">hundreds of daily buyers</span> with zero CAC via perpetual low-ticket architecture.
                  </>
                ) : (
                  <>
                    Transforme sua autoridade em <span class="text-[#00A39E]">centenas de novos compradores diários</span> com CAC liquidado no perpétuo.
                  </>
                )}
              </h1>

              <!-- Subheadline -->
              <p class="text-base sm:text-lg text-[#C6C6C6] font-['Instrument_Sans',sans-serif] mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
                {isEnglish
                  ? "Stop relying on exhausting launch cycles. Build a machine that acquires buyers every single day, funding your paid traffic and feeding your high-ticket programs."
                  : "Chega de depender de ciclos exaustivos de lançamentos. Construa uma máquina que atrai compradores qualificados todos os dias, paga o tráfego no front-end e alimenta suas mentorias."}
              </p>

              <!-- Botão Scroll Âncora até o Calendly com Pulsar Elegante -->
              <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                <a
                  href="#agendamento"
                  class="relative group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#00A39E] text-black font-['Sora',sans-serif] font-bold text-base hover:bg-[#008f8a] transition-all transform hover:-translate-y-0.5 shadow-lg shadow-[#00A39E]/25"
                >
                  <span class="absolute -inset-0.5 rounded-xl bg-[#00A39E] opacity-40 group-hover:opacity-75 blur-sm animate-pulse transition duration-1000 -z-10"></span>
                  <span>{isEnglish ? "Schedule Partnership Meeting" : "Agendar conversa de parceria (30 min)"}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Coluna da Direita: Vídeo Vertical 9:16 (Formato Reels) -->
            <div class="lg:col-span-5 flex justify-center">
              <VideoPlayer1Min
                aspectRatio="9/16"
                title={isEnglish ? "How Perpetual Low-Ticket Scales Creators" : "Como o Low Ticket Perpétuo escala Experts"}
                badgeText={isEnglish ? "Creator Strategy • 1 Min" : "Estratégia para Experts • 1 Min"}
                durationText="01:00 min"
              />
            </div>

          </div>
        </div>
      </section>

      <!-- 2. PARA QUEM É (CENTRALIZADO) -->
      <section class="py-20 md:py-28 bg-[#111111] text-white border-b border-white/5 relative">
        <div class="container mx-auto px-4 max-w-4xl text-center">
          <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#111111] bg-[#00A39E] rounded mb-4 font-['Sora',sans-serif]">
            {isEnglish ? "WHO IT IS FOR" : "PERFIL DE PARCEIRO"}
          </span>
          <h2 class="text-3xl md:text-5xl font-bold font-['Sora',sans-serif] text-white mb-4 leading-tight">
            {isEnglish
              ? "For established specialists and creators ready to build a 7-figure acquisition machine."
              : "Para especialistas e infoprodutores com autoridade validada que querem faturamento diário previsível."}
          </h2>
          <p class="text-xl md:text-2xl text-[#00A39E] font-['Instrument_Sans',sans-serif] font-medium mb-6">
            {isEnglish ? "Audience without systematic monetization is wasted potential." : "Audiência sem esteira perpétua de vendas é dinheiro deixado na mesa."}
          </p>
          <p class="text-[#C6C6C6] font-['Instrument_Sans',sans-serif] text-base md:text-lg leading-relaxed max-w-2xl mx-auto">
            {isEnglish
              ? "We assemble the funnel, optimize the ads, and manage the technical infrastructure. You focus on what you do best: creating exceptional content and delivering world-class knowledge."
              : "Nós estruturamos a esteira, otimizamos os criativos de tráfego pago e gerenciamos as automações. Você foca 100% no que faz de melhor: gerar conteúdo de autoridade e entregar suas mentorias."}
          </p>
        </div>
      </section>

      <!-- 3. FORMATOS DE ATUAÇÃO (TABELA COMPARATIVA LADO A LADO) -->
      <ComparisonTable
        badge={isEnglish ? "PARTNERSHIP MODELS" : "FORMATOS DE ATUAÇÃO"}
        title={isEnglish ? "Consulting vs Strategic Co-production" : "Consultoria Estratégica vs Coprodução Hands-on"}
        description={isEnglish ? "Select how you would like to collaborate with Maurício Leite." : "Entenda as diferenças entre o direcionamento estratégico e a parceria de execução compartilhada."}
        labelA={isEnglish ? "Strategic Advisory" : "Consultoria de Funil"}
        labelB={isEnglish ? "Co-production Partner" : "Coprodução Estratégica"}
        subLabelA={isEnglish ? "Audits and roadmap" : "Direcionamento e auditoria"}
        subLabelB={isEnglish ? "Full execution + Rev share" : "Execução completa + Revenue Share"}
        rows={currentRows}
        ctaTextA={isEnglish ? "Schedule Advisory Call" : "Agendar Consultoria"}
        ctaTextB={isEnglish ? "Apply for Co-production" : "Aplicar para Coprodução"}
        ctaUrlA="#agendamento"
        ctaUrlB="#agendamento"
      />

      <!-- 4. AGENDAMENTO CALENDLY -->
      <CalendlyEmbed
        url="https://calendly.com/mauricioleitecontato/30min"
        title={isEnglish ? "Book Your Partnership Alignment Call" : "Agende sua reunião de alinhamento de parceria"}
        description={isEnglish ? "Choose your best time to discuss your products, audience, and perpetual funnel potential." : "Escolha o melhor dia e horário para analisarmos sua audiência e potencial de escala no perpétuo."}
      />

      <!-- 5. FAQ EXCLUSIVO PARA EXPERTS -->
      <FaqAccordion
        isEnglish={isEnglish}
        items={currentFaqs}
        badge={isEnglish ? "EXPERTS FAQ" : "DÚVIDAS FREQUENTES"}
        title={isEnglish ? "Frequently Asked Questions for Creators" : "Perguntas frequentes sobre o modelo para experts"}
      />

      <!-- 6. CTA FINAL COM PULSAR ELEGANTE -->
      <section class="py-16 bg-[#161616] text-white border-t border-white/10 text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-[#00A39E]/5 to-transparent pointer-events-none"></div>
        <div class="container mx-auto px-4 max-w-4xl relative z-10">
          <h2 class="text-2xl md:text-4xl font-bold font-['Sora',sans-serif] text-white mb-4">
            {isEnglish ? "Ready to launch your perpetual acquisition funnel?" : "Pronto para criar sua máquina de compradores diários?"}
          </h2>
          <p class="text-[#C6C6C6] font-['Instrument_Sans',sans-serif] text-base md:text-lg mb-8 max-w-xl mx-auto">
            {isEnglish
              ? "Schedule your 30-minute alignment session and let's map out your next 7-figure funnel."
              : "Agende sua reunião de 30 minutos e vamos desenhar a esteira ideal para sua autoridade."}
          </p>
          <a
            href="#agendamento"
            class="relative group inline-flex items-center justify-center gap-3 px-10 py-5 rounded-xl bg-[#00A39E] text-black font-['Sora',sans-serif] font-bold text-lg hover:bg-[#008f8a] transition-all transform hover:-translate-y-0.5 shadow-xl shadow-[#00A39E]/25"
          >
            <span class="absolute -inset-1 rounded-xl bg-[#00A39E] opacity-35 group-hover:opacity-75 blur-md animate-pulse transition duration-1000 -z-10"></span>
            <span>{isEnglish ? "Schedule Partnership Meeting" : "Agendar conversa de alinhamento"}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </section>
    </main>

    <!-- Rodapé Oficial da Marca -->
    <FooterMauricio isEnglish={isEnglish} />
  </div>

  <!-- Micro-script para Glow Border nos cards interativos -->
  <script is:inline>
    document.querySelectorAll('.interactive-glow-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>
</Base>
