---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import config from ".astro/config.generated.json";
import SinglePageLayout from "@/components/SinglePageLayout.astro";
import extractSlug from "@/lib/utils/extractSlug";

import HeaderNav from "@/components/HeaderNav.astro";
import FooterMauricio from "@/components/FooterMauricio.astro";

// get static paths for all pages
export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      let pages = await getCollectionCTM("pages", lang.languageCode);

      // Generate static path entry
      return pages.map((page) => ({
        params: {
          lang:
            !showDefaultLangInUrl && lang.languageCode === defaultLanguage
              ? undefined
              : lang.languageCode,
          page: extractSlug(page).split("/").pop(),
        },
        props: {
          page,
          langCode: lang.languageCode,
        },
      }));
    }),
  );

  return paths.flat();
}

const { page, langCode } = Astro.props;
const currentLocale = Astro.currentLocale || langCode || "pt";
const isEnglish = currentLocale === "en" || Astro.url.pathname.startsWith("/en");
---

<Base
  {...page.data}
  headerLayout="none"
  hideHeader={true}
  hideFooter={true}
  hideCallToAction={true}
  hideHelperButtons={true}
>
  <div class="bg-[#111111] min-h-screen text-white flex flex-col justify-between selection:bg-[#00A39E] selection:text-black">
    <HeaderNav currentLocale={isEnglish ? "en" : "pt"} />
    <main class="flex-grow py-12 md:py-16">
      <SinglePageLayout content={{ ...page.data, ...page }} isEnglish={isEnglish} />
    </main>
    <FooterMauricio isEnglish={isEnglish} />
  </div>
</Base>
