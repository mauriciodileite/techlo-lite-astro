---
import Base from "@/layouts/Base.astro";
import HeaderNav from "@/components/HeaderNav.astro";
import FooterMauricio from "@/components/FooterMauricio.astro";
import CalendlyEmbed from "@/components/CalendlyEmbed.astro";
import ComparisonTable, { type ComparisonRow } from "@/components/ComparisonTable.astro";
import FaqAccordion, { type FaqItem } from "@/components/FaqAccordion.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";

export function getStaticPaths() {
  return generatePaths();
}

const currentLocale = Astro.currentLocale || "pt";
const isEnglish = currentLocale === "en" || Astro.url.pathname.startsWith("/en");

const metaTitle = isEnglish
  ? "For Entrepreneurs | Earn in USD Living in Brazil with AI & Automation"
  : "Para Empreendedores | Ganhe em Dólar Morando no Brasil com Ecossistema Online";

const metaDescription = isEnglish
  ? "Earning in dollars while living in Brazil is the key to a comfortable, debt-free life. Discover courses and mentoring in AI automation by Maurício Leite."
  : "Ganhar em dólar morando no Brasil é a chave para viver confortável e sem dívidas. Isso só é possível criando um ecossistema online. Conheça curso e mentoria.";

// Tabela comparativa de modalidades (Curso vs Mentoria)
const comparisonRowsPt: ComparisonRow[] = [
  { feature: "Formato das aulas", optionA: "Gravadas passo a passo", optionB: "Encontros ao vivo 1:1 e gravadas", highlightB: true },
  { feature: "Análise do seu modelo de negócio", optionA: "Estudos de caso gerais", optionB: "Auditoria personalizada direta", highlightB: true },
  { feature: "Criação de ecossistema online em USD", optionA: true, optionB: true },
  { feature: "Templates de automação & IA prontos", optionA: true, optionB: true },
  { feature: "Acesso direto via WhatsApp", optionA: false, optionB: true, highlightB: true },
  { feature: "Revisão de funil e tráfego pelo Maurício", optionA: false, optionB: true, highlightB: true },
  { feature: "Tempo de acesso", optionA: "1 ano com atualizações", optionB: "Acesso vitalício ao ecossistema", highlightB: true },
];

const comparisonRowsEn: ComparisonRow[] = [
  { feature: "Class format", optionA: "Pre-recorded step by step", optionB: "1:1 Live sessions + recorded library", highlightB: true },
  { feature: "Business model deep-dive", optionA: "General case studies", optionB: "Tailored 1:1 audit", highlightB: true },
  { feature: "Online USD ecosystem blueprint", optionA: true, optionB: true },
  { feature: "Ready-to-use AI & automation templates", optionA: true, optionB: true },
  { feature: "Direct WhatsApp support", optionA: false, optionB: true, highlightB: true },
  { feature: "Funnel and ads review by Maurício", optionA: false, optionB: true, highlightB: true },
  { feature: "Access period", optionA: "1 year with updates", optionB: "Lifetime ecosystem access", highlightB: true },
];

// FAQ Oficial de Empreendedores
const faqsEmpreendedoresPt: FaqItem[] = [
  {
    question: "Preciso ter conhecimento prévio em programação para criar automações com IA?",
    answer: "Não. Ensinamos a utilizar ferramentas no-code e APIs visuais para conectar sistemas, CRM, WhatsApp e IA generativa sem escrever código complexo."
  },
  {
    question: "Qual a diferença prática entre o Curso e a Mentoria?",
    answer: "No Curso você recebe o método estruturado passo a passo para implementar no seu próprio ritmo. Na Mentoria, Maurício Leite analisa diretamente o seu modelo de negócio, define a esteira e acompanha seus testes de tração."
  },
  {
    question: "Como funciona a geração de receita em dólar morando no Brasil?",
    answer: "Construímos esteiras de produtos digitais, serviços de automação com IA ou e-commerce direcionados ao mercado americano e europeu, recebendo pagamentos em moeda forte direto na sua conta internacional."
  },
  {
    question: "Por quanto tempo tenho acesso aos conteúdos?",
    answer: "No curso você tem 1 ano completo de acesso a todas as aulas e atualizações. Na mentoria, você tem acesso vitalício a toda a base de conhecimento."
  },
  {
    question: "O que acontece após a compra ou aplicação?",
    answer: "Para o curso, o acesso é liberado imediatamente. Para a mentoria, você preenche a aplicação e se aprovado, agendamos nossa primeira sessão individual de alinhamento."
  }
];

const faqsEmpreendedoresEn: FaqItem[] = [
  {
    question: "Do I need coding background to build AI automations?",
    answer: "No. We teach you how to use modern no-code workflows, visual APIs, and generative AI without complex programming."
  },
  {
    question: "What is the key difference between the Course and Mentoring?",
    answer: "The Course offers step-by-step pre-recorded frameworks for self-paced execution. Mentoring includes direct 1:1 business audits, funnel reviews, and strategic guidance with Maurício."
  },
  {
    question: "How does earning in USD living in Brazil actually work?",
    answer: "We structure digital assets, AI automation workflows, or services tailored for the US/European market, receiving revenue in strong currency directly."
  },
  {
    question: "How long is my access valid?",
    answer: "Course students get 1 full year including all updates. Mentoring members get lifetime access to the entire knowledge library."
  },
  {
    question: "What happens after purchasing or applying?",
    answer: "Course access is delivered instantly. For mentoring, you submit an application, and once approved, we schedule our first 1:1 strategy session."
  }
];

const currentRows = isEnglish ? comparisonRowsEn : comparisonRowsPt;
const currentFaqs = isEnglish ? faqsEmpreendedoresEn : faqsEmpreendedoresPt;
---

<Base
  title={metaTitle}
  description={metaDescription}
  headerLayout="none"
  hideHeader={true}
  hideFooter={true}
  hideCallToAction={true}
  hideHelperButtons={true}
>
  <div class="bg-[#111111] min-h-screen text-white flex flex-col justify-between selection:bg-[#00A39E] selection:text-black">
    <!-- Header Oficial da Marca -->
    <HeaderNav currentLocale={isEnglish ? "en" : "pt"} />

    <main class="flex-grow">
      <!-- 1. HERO SECTION COM ONE BELIEF OFICIAL DO USUÁRIO (SEM VÍDEO) -->
      <section class="relative pt-36 pb-20 md:pt-44 md:pb-28 overflow-hidden border-b border-white/5">
        <!-- Glow suave de iluminação -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-[#00A39E]/10 blur-[140px] rounded-full pointer-events-none"></div>

        <div class="container mx-auto px-4 max-w-5xl relative z-10 text-center">
          <!-- Tag / Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A1A1A] border border-[#C6C6C6]/20 mb-8">
            <span class="w-2 h-2 rounded-full bg-[#00A39E] animate-pulse"></span>
            <span class="text-xs uppercase tracking-widest text-[#C6C6C6] font-['Sora',sans-serif] font-semibold">
              {isEnglish ? "For Entrepreneurs • USD Growth" : "Para Empreendedores • Renda em Dólar"}
            </span>
          </div>

          <!-- Headline One Belief oficial do usuário -->
          <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight font-['Sora',sans-serif] text-white leading-[1.15] mb-6 max-w-4xl mx-auto">
            {isEnglish ? (
              <>
                Earning in dollars while living in Brazil is the key to living <span class="text-[#00A39E]">comfortable and debt-free</span>.
              </>
            ) : (
              <>
                Ganhar em dólar morando no Brasil é a chave para viver <span class="text-[#00A39E]">confortável e sem dívidas</span>.
              </>
            )}
          </h1>

          <!-- Subheadline -->
          <p class="text-lg md:text-xl text-[#C6C6C6] font-['Instrument_Sans',sans-serif] max-w-2xl mx-auto mb-10 leading-relaxed">
            {isEnglish
              ? "And this is only possible by building a predictable online ecosystem. Learn how to master AI automations and client acquisition in strong currency."
              : "Isso só é possível criando um ecossistema online. Aprenda processos, automações com IA e atração de clientes em moeda forte com método validado."}
          </p>

          <!-- CTAs Rápidos -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
            <a
              href="#modalidades"
              class="relative group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#00A39E] text-black font-['Sora',sans-serif] font-bold text-base hover:bg-[#008f8a] transition-all transform hover:-translate-y-0.5 shadow-lg shadow-[#00A39E]/25"
            >
              <span class="absolute -inset-0.5 rounded-xl bg-[#00A39E] opacity-40 group-hover:opacity-75 blur-sm animate-pulse transition duration-1000 -z-10"></span>
              <span>{isEnglish ? "Explore Learning Paths" : "Conhecer modalidades de formação"}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- 2. VOCÊ PODE APRENDER COMIGO DE DUAS FORMAS (2 CARDS) -->
      <section id="modalidades" class="py-20 md:py-28 bg-[#111111] text-white border-b border-white/5 relative">
        <div class="container mx-auto px-4 max-w-6xl">
          <div class="text-center mb-16">
            <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#111111] bg-[#00A39E] rounded mb-3 font-['Sora',sans-serif]">
              {isEnglish ? "MODALITIES" : "FORMAÇÃO"}
            </span>
            <h2 class="text-3xl md:text-5xl font-bold font-['Sora',sans-serif] text-white max-w-3xl mx-auto">
              {isEnglish ? "You can learn with me in two ways" : "Você pode aprender comigo de duas formas"}
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <!-- Modalidade 1: Curso Online -->
            <div class="interactive-glow-card relative bg-[#181818] border border-white/10 rounded-3xl p-8 md:p-10 transition-all duration-300 flex flex-col justify-between overflow-hidden group hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-[#00A39E]/10">
              <div class="glow-effect pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 163, 158, 0.15), transparent 40%);"></div>
              <div class="relative z-10">
                <div class="inline-block px-3 py-1 rounded-full bg-[#1A1A1A] border border-white/10 text-xs font-semibold text-[#C6C6C6] uppercase tracking-wider mb-6">
                  {isEnglish ? "Step by Step" : "Passo a Passo"}
                </div>
                <h3 class="text-2xl md:text-3xl font-bold font-['Sora',sans-serif] text-white mb-4">
                  {isEnglish ? "1. Practical Course" : "1. Curso Prático de Automações & IA"}
                </h3>
                <p class="text-[#C6C6C6] font-['Instrument_Sans',sans-serif] text-base leading-relaxed mb-6">
                  {isEnglish
                    ? "Complete online training with ready templates, automated workflows, and direct blueprints to construct your digital revenue stream."
                    : "Treinamento completo gravado com templates prontos de automação, conexões com inteligência artificial e esteiras de vendas em dólar."}
                </p>
                <ul class="space-y-3 mb-8 text-sm text-[#C6C6C6] font-['Instrument_Sans',sans-serif]">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
                    {isEnglish ? "Acesso a todos os módulos gravados" : "Acesso a todos os módulos e atualizações"}
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
                    {isEnglish ? "Templates no-code e fluxos de IA" : "Templates no-code e automações de atendimento"}
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
                    {isEnglish ? "Estude no seu próprio ritmo" : "Estude no seu próprio ritmo com suporte na plataforma"}
                  </li>
                </ul>
              </div>
              <a
                href="#agendamento"
                class="w-full inline-flex items-center justify-center py-4 rounded-xl border border-white/20 text-white font-['Sora',sans-serif] font-bold text-sm hover:border-[#00A39E] hover:text-[#00A39E] transition-colors relative z-10"
              >
                {isEnglish ? "Enroll in Course" : "Quero acessar o curso"}
              </a>
            </div>

            <!-- Modalidade 2: Mentoria Individual -->
            <div class="interactive-glow-card relative bg-[#181818] border border-[#00A39E]/40 rounded-3xl p-8 md:p-10 transition-all duration-300 flex flex-col justify-between overflow-hidden group hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-[#00A39E]/20">
              <div class="glow-effect pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 163, 158, 0.25), transparent 40%);"></div>
              <div class="relative z-10">
                <div class="inline-block px-3 py-1 rounded-full bg-[#00A39E]/10 border border-[#00A39E]/40 text-xs font-semibold text-[#00A39E] uppercase tracking-wider mb-6">
                  {isEnglish ? "1:1 Strategic Mentorship" : "Acompanhamento 1:1"}
                </div>
                <h3 class="text-2xl md:text-3xl font-bold font-['Sora',sans-serif] text-white mb-4">
                  {isEnglish ? "2. Exclusive Mentorship" : "2. Mentoria Individual com Maurício"}
                </h3>
                <p class="text-[#C6C6C6] font-['Instrument_Sans',sans-serif] text-base leading-relaxed mb-6">
                  {isEnglish
                    ? "Private sessions directly with Maurício Leite to audit your business model, build tailored AI systems, and scale revenue fast."
                    : "Encontros individuais diretamente com Maurício Leite para auditar seu modelo de negócio, desenhar a arquitetura e acelerar a escala."}
                </p>
                <ul class="space-y-3 mb-8 text-sm text-[#C6C6C6] font-['Instrument_Sans',sans-serif]">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
                    {isEnglish ? "Sessões estratégicas ao vivo" : "Sessões estratégicas ao vivo 1:1"}
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
                    {isEnglish ? "Contato direto via WhatsApp" : "Acesso e validação direta pelo WhatsApp"}
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00A39E]"></span>
                    {isEnglish ? "Acesso vitalício ao ecossistema" : "Acesso vitalício a todo o acervo e atualizações"}
                  </li>
                </ul>
              </div>
              <a
                href="#agendamento"
                class="w-full inline-flex items-center justify-center py-4 rounded-xl bg-[#00A39E] text-black font-['Sora',sans-serif] font-bold text-sm hover:bg-[#008f8a] transition-all transform hover:-translate-y-0.5 shadow-lg shadow-[#00A39E]/25 relative z-10"
              >
                {isEnglish ? "Apply for Mentorship" : "Aplicar para mentoria individual"}
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. QUAL É MELHOR PARA VOCÊ? (TABELA COMPARATIVA LADO A LADO) -->
      <ComparisonTable
        badge={isEnglish ? "SIDE-BY-SIDE COMPARISON" : "QUAL É MELHOR PARA VOCÊ?"}
        title={isEnglish ? "Compare both modalities in detail" : "Compare o curso e a mentoria lado a lado"}
        description={isEnglish ? "Transparent breakdown of what is included in each track." : "Transparência total sobre entregáveis, acompanhamento e suporte."}
        labelA={isEnglish ? "Practical Course" : "Curso Prático"}
        labelB={isEnglish ? "1:1 Mentorship" : "Mentoria Individual"}
        subLabelA={isEnglish ? "Self-paced execution" : "Execução autônoma"}
        subLabelB={isEnglish ? "Direct accompaniment" : "Acompanhamento direto"}
        rows={currentRows}
        ctaTextA={isEnglish ? "Get Course" : "Acessar Curso"}
        ctaTextB={isEnglish ? "Apply for Mentorship" : "Aplicar para Mentoria"}
        ctaUrlA="#agendamento"
        ctaUrlB="#agendamento"
      />

      <!-- 4. AGENDAMENTO CALENDLY -->
      <CalendlyEmbed
        url="https://calendly.com/mauricioleitecontato/30min"
        title={isEnglish ? "Schedule an Alignment Call with Maurício" : "Agende sua sessão de alinhamento com o Maurício"}
        description={isEnglish ? "Choose your best time to talk about your goals and business model." : "Escolha o melhor dia e horário para entender o melhor formato para a sua operação."}
      />

      <!-- 5. FAQ EXCLUSIVO PARA EMPREENDEDORES -->
      <FaqAccordion
        isEnglish={isEnglish}
        items={currentFaqs}
        badge={isEnglish ? "FAQ" : "DÚVIDAS FREQUENTES"}
        title={isEnglish ? "Frequently Asked Questions for Entrepreneurs" : "Dúvidas frequentes de empreendedores"}
      />

      <!-- 6. CTA FINAL COM PULSAR ELEGANTE -->
      <section class="py-16 bg-[#161616] text-white border-t border-white/10 text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-[#00A39E]/5 to-transparent pointer-events-none"></div>
        <div class="container mx-auto px-4 max-w-4xl relative z-10">
          <h2 class="text-2xl md:text-4xl font-bold font-['Sora',sans-serif] text-white mb-4">
            {isEnglish ? "Ready to build your USD digital ecosystem?" : "Pronto para construir seu ecossistema online em dólar?"}
          </h2>
          <p class="text-[#C6C6C6] font-['Instrument_Sans',sans-serif] text-base md:text-lg mb-8 max-w-xl mx-auto">
            {isEnglish
              ? "Schedule your 30-minute session and take the first step towards financial predictability."
              : "Agende sua sessão estratégica de 30 minutos e dê o primeiro passo rumo à previsibilidade em moeda forte."}
          </p>
          <a
            href="#agendamento"
            class="relative group inline-flex items-center justify-center gap-3 px-10 py-5 rounded-xl bg-[#00A39E] text-black font-['Sora',sans-serif] font-bold text-lg hover:bg-[#008f8a] transition-all transform hover:-translate-y-0.5 shadow-xl shadow-[#00A39E]/25"
          >
            <span class="absolute -inset-1 rounded-xl bg-[#00A39E] opacity-35 group-hover:opacity-75 blur-md animate-pulse transition duration-1000 -z-10"></span>
            <span>{isEnglish ? "Schedule Alignment Call" : "Agendar alinhamento de 30 min"}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </section>
    </main>

    <!-- Rodapé Oficial da Marca -->
    <FooterMauricio isEnglish={isEnglish} />
  </div>

  <!-- Micro-script para Glow Border nos cards interativos -->
  <script is:inline>
    document.querySelectorAll('.interactive-glow-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>
</Base>
